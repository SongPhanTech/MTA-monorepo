ARG PACKAGE

FROM imbios/bun-node:23-debian AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

FROM base AS pruner
ARG PACKAGE
ENV PACKAGE="${PACKAGE}"
WORKDIR /app
RUN pnpm add -g turbo
COPY . .
RUN turbo prune @backend/${PACKAGE} --docker

FROM base AS builder
WORKDIR /app
COPY --from=pruner /app/out/json/ .
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

COPY --from=pruner /app/out/full/ .
RUN echo "DATABASE_URL=postgres://root:SwanT3chDB@swantech.luanbt.com:5432/mta" > packages/database/.env
RUN pnpm generate
RUN pnpm generate:sql
RUN pnpm build
RUN ls -la

# FROM debian:11-alpine AS backend
# ARG PACKAGE
# ENV PACKAGE="${PACKAGE}"
# WORKDIR /app
# COPY --from=builder /app/packages/database/node_modules/prisma/*.node /tmp/prisma-engines/
# COPY --from=builder /app/apps/${PACKAGE}/dist/myapp .

# CMD ["/app/myapp"]

FROM oven/bun:slim AS backend
ARG PACKAGE
ENV PACKAGE="${PACKAGE}"
WORKDIR /app
RUN apt update && apt install -y libssl3
RUN bun add @opentelemetry/exporter-trace-otlp-http
COPY --from=builder /app/packages/database/node_modules/prisma/*.node /tmp/prisma-engines/
COPY --from=builder /app/apps/backend/${PACKAGE}/dist .
USER bun

CMD ["bun", "index.js"]