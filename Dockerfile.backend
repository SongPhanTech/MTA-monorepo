ARG PACKAGE

FROM imbios/bun-node:latest AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable pnpm

FROM base AS builder
ARG PACKAGE
ENV PACKAGE="${PACKAGE}"
WORKDIR /app
COPY out/json/ .
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm i

COPY out/full/ .
ENV NODE_OPTIONS="--max-old-space-size=6144"
ARG CACHEBUST=1
RUN echo "cachebust=${CACHEBUST}" && pnpm build

# FROM debian:11-alpine AS backend
# ARG PACKAGE
# ENV PACKAGE="${PACKAGE}"
# WORKDIR /app
# COPY --from=builder /app/packages/database/node_modules/prisma/*.node /tmp/prisma-engines/
# COPY --from=builder /app/apps/${PACKAGE}/dist/myapp .

# CMD ["/app/myapp"]

FROM oven/bun:latest AS backend
ARG PACKAGE
ENV PACKAGE="${PACKAGE}"
WORKDIR /app
RUN apt update && apt install -y libssl3
# COPY --from=builder /app/packages/database/node_modules/prisma/*.node /tmp/prisma-engines/
COPY --from=builder /app/packages/database/generated/prisma-client/*.so.node /tmp/prisma-engines/
COPY --from=builder /app/apps/backend/${PACKAGE}/dist .
RUN mkdir -p /app/tmp-exports && chown -R bun:bun /app
USER bun

CMD ["bun", "index.js"]
