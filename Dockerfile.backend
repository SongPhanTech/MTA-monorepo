FROM node:20-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN npm install -g pnpm
RUN npm i -g bun

FROM base AS pruner
WORKDIR /app
RUN npm add -g turbo
COPY . .
RUN turbo prune @backend/ql-nguoi-dung --docker

FROM base AS builder
WORKDIR /app
COPY --from=pruner /app/out/json/ .
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

COPY --from=pruner /app/out/full/ .
RUN pnpm generate
RUN pnpm build
RUN ls -la

# FROM debian:11-alpine AS backend
# WORKDIR /app
# COPY --from=builder /app/packages/database/node_modules/prisma/*.node /tmp/prisma-engines/
# COPY --from=builder /app/apps/backend/ql-nguoi-dung/dist/myapp .

# CMD ["/app/myapp"]

FROM oven/bun:alpine AS backend
WORKDIR /app
RUN bun add @opentelemetry/exporter-trace-otlp-http
COPY --from=builder /app/packages/database/node_modules/prisma/*.node /tmp/prisma-engines/
COPY --from=builder /app/apps/backend/ql-nguoi-dung/dist .
USER bun

CMD bun index.js