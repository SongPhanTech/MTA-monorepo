{
    "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
    "extends": ["@workspace/biome-config"],
    "files": {
        "ignoreUnknown": true,
        "ignore": [".vscode", "package.json", ".next/**/*"]
    },
    "organizeImports": {
        "enabled": true
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": false,
            "correctness": {
                "useExhaustiveDependencies": "off"
            }
        }
    }
}
