{
    "ts-node": {
        "transpileOnly": true,
        "files": true,
        "compilerOptions": {
            "module": "commonjs",
            "moduleResolution": "node"
        }
    },
    "compilerOptions": {
        "lib": ["dom", "dom.iterable", "esnext"],
        "allowSyntheticDefaultImports": true,
        "target": "esnext",
        "allowJs": true,
        "skipLibCheck": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "preserve",
        "incremental": true,
        "baseUrl": ".",
        "paths": {
            "@components/*": ["src/components/*"],
            "@constants/*": ["src/constants/*"],
            "@layouts/*": ["src/layouts/*"],
            "@pages/*": ["src/pages/*"],
            "@api/*": ["src/lib/api/*"],
            "@redux/*": ["src/lib/redux/*"],
            "@hooks/*": ["src/hooks/*"],
            "@styles/*": ["src/styles/*"],
            "@lib/*": ["src/lib/*"],
            "@generated/*": ["generated/*"],
            "@/*": ["./src/*"],
            "@packages/*": ["./packages/*"],
            "@server/*": ["src/server/*"],
            "@assets/*": ["src/assets/*"]
        },
        "plugins": [
            {
                "name": "next"
            }
        ]
    },
    "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts",
        "src/pages/api/equipments/locations/[[...id]]"
    ],
    "exclude": ["node_modules"]
}
