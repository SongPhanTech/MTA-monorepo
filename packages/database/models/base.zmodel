abstract model Base {
  id          String    @id @default(cuid())
  code        String?   @unique
  active      Boolean   @default(true)
  description String?   @db.Text
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt @default(now())
  createdBy   String?   @db.Uuid @default(auth().id)
  sNguoiTao   String?
  sNguoiSua   String?
  dNgayTao    DateTime? @db.Timestamp(6)
  dNgaySua    DateTime? @db.Timestamp(6)
  sThietBiTao String?
  sThietBiSua String?
  // TODO: change this
  @@allow('all', auth() != null)

  @@deny('read', deletedAt != null)
  /// TODO: allow all for now, will be restricted later
  // @@allow('all', auth().role == 'ADMIN')
  @@allow('read', auth() != null)
}

abstract model BaseNoCode {
  id          String    @id @default(cuid())
  active      Boolean   @default(true)
  description String?   @db.Text
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt @default(now())
  createdBy   String?   @db.Uuid @default(auth().id)
  sNguoiTao   String?
  sNguoiSua   String?
  dNgayTao    DateTime? @db.Timestamp(6)
  dNgaySua    DateTime? @db.Timestamp(6)
  sThietBiTao String?
  sThietBiSua String?
  // TODO: change this
  @@allow('all', auth() != null)

  @@deny('read', deletedAt != null)
  /// TODO: allow all for now, will be restricted later
  // @@allow('all', auth().role == 'ADMIN')
  @@allow('read', auth() != null)
}

