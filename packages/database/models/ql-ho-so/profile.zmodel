import '../base'
import '../ql-nguoi-dung/user'
import '../ql-danh-muc/core-categories'
import '../ql-danh-muc/common'
import '../ql-dao-tao/categories'
import '../ql-dao-tao/plan-training'
import '../ql-dao-tao/student'
import '../ql-dao-tao/lecturer'
import '../ql-dao-tao/staff'
import '../khao-thi/survey'
import '../tro-ly-ao/chat-bot'
import '../ql-ho-so/categories'
import '../khao-thi/evaluate'
import '../he-thong/changelog'

enum UserType {
  MILITARY_STUDENT // Học viên quân sự
  CIVILIAN_STUDENT // Sinh viên dân sự
  LECTURER // Giảng viên
  STAFF // Nhân viên
  PROFESSIONAL // Chuyên nghiệp
  CONTRACT // Hợp đồng: Người làm việc theo hợp đồng tại các trường học, có thể là giảng viên hoặc nhân viên.
  OTHER

  @@schema("ql-nguoi-dung")
}

model UserProfile extends Base {
  bLaNguoiDung                  Boolean?
  bLaCanBoNhanVien              Boolean?
  bLaHocVien                    Boolean?
  group                         Group?                       @relation(fields: [groupId], references: [id])
  groupId                       String?
  sDM_DonViId                   String?                      @db.Uuid
  sDM_ViTriCongViecId           String?                      @db.Uuid
  sQuanlyTrucTiepId             String?                      @db.Uuid
  iDictionaryKey                Int?
  bSystem                       Boolean?
  sNguoiTao                     String?
  sNguoiSua                     String?
  sThietBiTao                   String?
  sThietBiSua                   String?  

  // general information
  avatar                        String? // đường dẫn ảnh đại diện
  firstName                     String
  lastName                      String
  idCardNumber                  String                       @unique // số căn cước công dân
  placeOfIdCardNumber           String?
  fullname                      String?
  healthInsuranceNumber         String? // số bảo hiểm y tế
  bankAccountNumber             String? // số tài khoản ngân hàng
  bankName                      String? // tên ngân hàng
  currentAddress                String? // địa chỉ hiện tại
  newCurrentAddress             String? // địa chỉ hiện tại theo hành chính mới
  occupationWhenRecruiting      String? // nghề nghiệp khi tuyển dụng

  thuongBinh                    String?
  benh                          String?
  tinhHinhNhaO                  String?
  truocKhiNhapNgu               String?
  thanhPhanGiaDinh              String?
  soTruong                      String?
  hoTenThuongDung               String?
  lichSuBanThan                 String?
  conThuMay                     Int?       // con thứ mấy
  chieuCao                      String?    // chiều cao
  canNang                       String?    // cân nặng 
  
  // gia đình
  soACE                         Int?      // số anh chị em
  kinhTeGiaDinh                 String?
  chinhTriGiaDinh               String?

  // gia đình vợ/chồng
  fSoACE                        Int?      // số anh chị em
  fKinhTeGiaDinh                String?
  fThanhPhanGiaDinh             String?
  fChinhTriGiaDinh              String?
  fBanThan                      String?

  nationalId                    String?                      @db.Uuid
  provinceCurrentAddress        DM_Tinh?                     @relation(name: "ProvinceCurrentAddress", fields: [provinceCurrentAddressId], references: [Id])
  provinceCurrentAddressId      String?                      @db.Uuid
  districtCurrentAddress        DM_QuanHuyen?                @relation(name: "DistrictCurrentAddress", fields: [districtCurrentAddressId], references: [Id])
  districtCurrentAddressId      String?                      @db.Uuid
  communeCurrentAddress         DM_XaPhuong?                 @relation(name: "CommuneCurrentAddress", fields: [communeCurrentAddressId], references: [Id])
  communeCurrentAddressId       String?                      @db.Uuid
  newProvinceCurrentAddress     DM_Tinh_New?                 @relation(name: "NewProvinceCurrentAddress", fields: [newProvinceCurrentAddressId], references: [Id])
  newProvinceCurrentAddressId   String?                      @db.Uuid
  newCommuneCurrentAddress      DM_XaPhuong_New?             @relation(name: "NewCommuneCurrentAddress", fields: [newCommuneCurrentAddressId], references: [Id])
  newCommuneCurrentAddressId    String?                      @db.Uuid

  dateOfBirth                   DateTime? // ngày sinh
  placeOfBirth                  String?   // nơi sinh
  provinceOfBirth               DM_Tinh?                     @relation(name: "ProvincePlaceOfBirth", fields: [provinceOfBirthId], references: [Id])
  provinceOfBirthId             String?                      @db.Uuid
  districtOfBirth               DM_QuanHuyen?                @relation(name: "DistrictPlaceOfBirth", fields: [districtOfBirthId], references: [Id])
  districtOfBirthId             String?                      @db.Uuid
  communeOfBirth                DM_XaPhuong?                 @relation(name: "CommunePlaceOfBirth", fields: [communeOfBirthId], references: [Id])
  communeOfBirthId              String?                      @db.Uuid
  newProvinceOfBirth            DM_Tinh_New?                 @relation(name: "NewProvincePlaceOfBirth", fields: [newProvinceOfBirthId], references: [Id])
  newProvinceOfBirthId          String?                      @db.Uuid
  newCommuneOfBirth             DM_XaPhuong_New?             @relation(name: "NewCommunePlaceOfBirth", fields: [newCommuneOfBirthId], references: [Id])
  newCommuneOfBirthId           String?                      @db.Uuid

  homeTown                      String? // quê quán
  idCardDate                    DateTime? // ngày cấp
  idCardExpirationDate          DateTime? // ngày hết hạn CCCD
  gender                        DM_GioiTinh?                 @relation(fields: [genderId], references: [Id])
  genderId                      String?                      @db.Uuid

  permanentAddress              String? // địa chỉ thường trú
  provincePermanentAddress      DM_Tinh?                     @relation(name: "ProvincePermanentAddress", fields: [provincePermanentAddressId], references: [Id])
  provincePermanentAddressId    String?                      @db.Uuid
  districtPermanentAddress      DM_QuanHuyen?                @relation(name: "DistrictPermanentAddress", fields: [districtPermanentAddressId], references: [Id])
  districtPermanentAddressId    String?                      @db.Uuid
  communePermanentAddress       DM_XaPhuong?                 @relation(name: "CommunePermanentAddress", fields: [communePermanentAddressId], references: [Id])
  communePermanentAddressId     String?                      @db.Uuid
  newProvincePermanentAddress   DM_Tinh_New?                 @relation(name: "NewProvincePermanentAddress", fields: [newProvincePermanentAddressId], references: [Id])
  newProvincePermanentAddressId String?                      @db.Uuid
  newCommunePermanentAddress    DM_XaPhuong_New?             @relation(name: "NewCommunePermanentAddress", fields: [newCommunePermanentAddressId], references: [Id])
  newCommunePermanentAddressId  String?                      @db.Uuid

  temporaryAddress              String? // địa chỉ tạm trú
  contactAddress                String? // địa chỉ liên hệ
  phoneNumber                   String? // số điện thoại
  email                         String? // email
  nationality                   DM_QuocGia?                  @relation(fields: [nationalityId], references: [Id]) // quốc tịch
  nationalityId                 String?                      @db.Uuid
  religion                      DM_TonGiao?                  @relation(fields: [religionId], references: [Id]) // tôn giáo
  religionId                    String?                      @db.Uuid
  ethnicity                     DM_DanToc?                   @relation(fields: [ethnicityId], references: [Id]) // dân tộc
  ethnicityId                   String?                      @db.Uuid
  provinceHometown              DM_Tinh?                     @relation(name: "ProvinceHometown", fields: [provinceHometownId], references: [Id])
  provinceHometownId            String?                      @db.Uuid
  districtHometown              DM_QuanHuyen?                @relation(name: "DistrictHometown", fields: [districtHometownId], references: [Id])
  districtHometownId            String?                      @db.Uuid
  communeHometown               DM_XaPhuong?                 @relation(name: "CommuneHometown", fields: [communeHometownId], references: [Id])
  communeHometownId             String?                      @db.Uuid
  newProvinceHometown           DM_Tinh_New?                 @relation(name: "NewProvinceHometown", fields: [newProvinceHometownId], references: [Id])
  newProvinceHometownId         String?                      @db.Uuid
  newCommuneHometown            DM_XaPhuong_New?             @relation(name: "NewCommuneHometown", fields: [newCommuneHometownId], references: [Id])
  newCommuneHometownId          String?                      @db.Uuid

  officerNumber                 String? // số hiệu sĩ quan/quân nhân
  rank                          DM_CapBac?                   @relation(fields: [rankId], references: [Id])
  rankId                        String?                      @db.Uuid
  rankDate                      DateTime? // ngày phong quân hàm

  academicDegreeType            DM_HocVi?                    @relation(fields: [academicDegreeTypeId], references: [Id])
  academicDegreeTypeId          String?                      @db.Uuid
  academicDegreeDate            DateTime? // ngày cấp bằng học vị

  academicRankType              DM_HocHam?                   @relation(fields: [academicRankTypeId], references: [Id])
  academicRankTypeId            String?                      @db.Uuid
  academicRankDate              DateTime? // ngày cấp bằng học hàm

  level                         DM_ChucDanh?                 @relation(fields: [levelId], references: [Id])
  levelId                       String?                      @db.Uuid

  chiHuyQuanLy                  DM_ChiHuyQuanLy?             @relation(fields: [chiHuyQuanLyId], references: [id])
  chiHuyQuanLyId                String?

  chuyenMonKyThuat              DM_ChuyenMonKyThuat?         @relation(fields: [chuyenMonKyThuatId], references: [id])
  chuyenMonKyThuatId            String?

  sucKhoe                       DM_SucKhoe?                  @relation(fields: [sucKhoeId], references: [id])
  sucKhoeId                     String?

  nhomMau                       DM_NhomMau?                  @relation(fields: [nhomMauId], references: [id])
  nhomMauId                     String?

  // thông tin đoàn thể
  unionDate                     DateTime? // ngày vào Đoàn
  unionPlace                    String? // nơi vào Đoàn
  // ngày vào Đảng (ĐẢNG CỘNG SẢN VIỆT NAM – COMMUNIST PARTY OF VIET NAM (CPV) )
  CPVJoinDate                   DateTime? // ngày vào Đảng
  officialCPVDate               DateTime? // ngày chính thức
  CPVJoinPlace                  String? // nơi vào Đảng
  positionCPV                   DM_ChucVu?                   @relation(fields: [positionCPVId], references: [Id])
  positionCPVId                 String?                      @db.Uuid
  tenureDate                    DateTime? // ngày vào niên chế
  enlistmentDate                DateTime? // ngày nhập ngũ
  reEnlistmentDate              DateTime? // ngày tái nhập ngũ
  dischargeDate                 DateTime? // ngày xuất ngũ

  recruitmentDate               DateTime? // ngày tuyển dụng
  recruitmentAgency             String? // cơ quan tuyển dụng
  mainJobAssigned               String? // công việc chính được giao
  revolutionaryDate             DateTime? // ngày tham gia cách mạng

  //nguyên quán
  originalPlace                 String?

  // người thân
  familyPhone                   String?
  familyName                    String?

  //thân nhân
  relatives                     Relative[]

  trinhDoLyLuanChinhTri         TrinhDoLyLuanChinhTri[]
  trinhDoQuanLyNhaNuoc          TrinhDoQuanLyNhaNuoc[]
  ngoaiNgu                      NgoaiNgu[]
  tinHoc                        TinHoc[]
  boiDuongQuocPhongAnNinh       BoiDuongQuocPhongAnNinh[]
  capBac                        CapBac[]
  quaTrinhCongTac               QuaTrinhCongTac[]
  quaTrinhCuDiCongTac           QuaTrinhCuDiCongTac[]
  quaTrinhCuDiDaoTao            QuaTrinhCuDiDaoTao[]
  khenThuong                    KhenThuong[]
  kyLuat                        KyLuat[]
  doiTuongChinhSach             DoiTuongChinhSach[]
  keKhaiTaiSan                  KeKhaiTaiSan[]
  hocVi                         HocVi[]
  hocHam                        HocHam[]
  tiengDanToc                   TiengDanToc[]
  chienDau                      ChienDau[]
  diNuocNgoai                   NuocNgoai[]
  thuongTat                     ThuongTat[]
  danhHieu                      DanhHieu[]
  quaTrinhHocTap                QuaTrinhHocTap[]
  ToChucXaHoi                   ToChucXaHoi[]
  QuaTrinhLuong                 QuaTrinhLuong[]

  trinhDoHocVan                 DM_TrinhDoHocVan?            @relation(fields: [trinhDoHocVanId], references: [id])
  trinhDoHocVanId               String?

  /// hồ sơ đào tạo
  educationAndTraining          Student[]
  /// hồ sơ giảng viên
  lecturer                      Lecturer?
  lecturerHistory               LecturerHistory[]
  /// người cập nhật điểm
  studentSubjectScoreHistory    StudentSubjectScoreHistory[]
  /// hồ sơ cán bộ
  staffs                        Staff?
  staffHistory                  StaffHistory[]

  evidenceFiles                 EvidenceFile[]

  // Chatbot relations
  documentsUploaded             Document[]                   @relation("DocumentUploaded")
  documentsApproved             Document[]                   @relation("DocumentApproved")
  faqsUploaded                  FAQ[]                        @relation("FAQUploaded")
  faqsApproved                  FAQ[]                        @relation("FAQApproved")
  conversations                 Conversation[]
  subjectVersionHistory         SubjectVersionHistory[]
  subjectClassHistory           SubjectClassHistory[]
  changeLog                     ChangeLog[]
  surveySession                 SurveySession[]
  deadlineHistories             DeadlineHistory[]
  criterionAssignmentComments   CriterionAssignmentComment[]

  @@auth()
  @@schema("ql-nguoi-dung")
}

model HocHam extends Base {
  academicRankType   DM_HocHam?  @relation(fields: [academicRankTypeId], references: [Id])
  academicRankTypeId String?     @db.Uuid

  noiCap             String?
  soQuyetDinh        String?
  from               DateTime?
  to                 DateTime?

  userProfile        UserProfile @relation(fields: [userProfileId], references: [id])
  userProfileId      String

  @@schema("ql-ho-so")
}

model HocVi extends Base {
  academicDegreeType   DM_HocVi?             @relation(fields: [academicDegreeTypeId], references: [Id])
  academicDegreeTypeId String?               @db.Uuid

  nationality          DM_QuocGia?           @relation(fields: [nationalityId], references: [Id])
  nationalityId        String?               @db.Uuid

  linhVuc              String?
  truong               DM_TruongDaoTaoBacDH? @relation(fields: [truongId], references: [id])
  truongId             String?
  year                 Int?

  userProfile          UserProfile           @relation(fields: [userProfileId], references: [id])
  userProfileId        String

  @@schema("ql-ho-so")
}

enum RelativeType {
  FATHER
  MOTHER
  OLDER_BROTHER
  OLDER_SISTER
  YOUNGER_BROTHER
  YOUNGER_SISTER

  MARRIER
  FATHER_IN_LOW
  MOTHER_IN_LOW

  SON
  DAUGHTER

  @@schema("ql-ho-so")
}

//Thân nhân
model Relative extends Base {
  name          String
  type          RelativeType
  birthYear     Int?
  queQuan       String?
  noiOHienTai   String?
  job           String?
  information   String?

  userProfile   UserProfile  @relation(fields: [userProfileId], references: [id])
  userProfileId String

  @@schema("ql-ho-so")
}

model TrinhDoLyLuanChinhTri extends Base {
  hinhThucDaoTao  String?
  noiDaoTao       String?
  thoiGianBatDau  DateTime?
  thoiGianKetThuc DateTime?

  userProfile     UserProfile               @relation(fields: [userProfileId], references: [id])
  userProfileId   String

  trinhDo         DM_TrinhDoLyLuanChinhTri? @relation(fields: [trinhDoId], references: [id])
  trinhDoId       String?

  @@schema("ql-ho-so")
}

model TrinhDoQuanLyNhaNuoc extends Base {
  hinhThucDaoTao  String?
  noiDaoTao       String?
  thoiGianBatDau  DateTime?
  thoiGianKetThuc DateTime?

  userProfile     UserProfile              @relation(fields: [userProfileId], references: [id])
  userProfileId   String

  trinhDo         DM_TrinhDoQuanLyNhaNuoc? @relation(fields: [trinhDoId], references: [id])
  trinhDoId       String?

  @@schema("ql-ho-so")
}

model NgoaiNgu extends Base {
  ngonNgu         DM_NgoaiNgu?       @relation(fields: [ngonNguId], references: [Id])
  ngonNguId       String?            @db.Uuid
  hinhThucDaoTao  String?
  noiDaoTao       String?
  thoiGianBatDau  DateTime?
  thoiGianKetThuc DateTime?

  trinhDo         DM_TrinhDoNgoaiNgu @relation(fields: [trinhDoId], references: [Id])
  trinhDoId       String             @db.Uuid

  userProfile     UserProfile        @relation(fields: [userProfileId], references: [id])
  userProfileId   String

  @@schema("ql-ho-so")
}

model TinHoc extends Base {
  hinhThucDaoTao     String?
  noiDaoTao          String?
  thoiGianBatDau     DateTime?
  thoiGianKetThuc    DateTime?

  dM_TrinhDoTinHoc   DM_TrinhDoTinHoc @relation(fields: [dM_TrinhDoTinHocId], references: [Id])
  dM_TrinhDoTinHocId String           @db.Uuid

  userProfile        UserProfile      @relation(fields: [userProfileId], references: [id])
  userProfileId      String

  @@schema("ql-ho-so")
}

model BoiDuongQuocPhongAnNinh extends Base {
  name            String?
  thoiGianBatDau  DateTime?
  thoiGianKetThuc DateTime?

  userProfile     UserProfile @relation(fields: [userProfileId], references: [id])
  userProfileId   String

  @@schema("ql-ho-so")
}

model CapBac extends Base {
  noiRaQuyetDinh    String?
  capRaQuyetDinh    String?
  ngayNhanQuyetDinh DateTime?

  capBac            DM_CapBac   @relation(fields: [capBacId], references: [Id])
  capBacId          String      @db.Uuid

  userProfile       UserProfile @relation(fields: [userProfileId], references: [id])
  userProfileId     String

  @@schema("ql-ho-so")
}

model QuaTrinhCongTac extends Base {
  tuThangNam        DateTime?
  denThangNam       DateTime?

  donVi             String?
  diaChi            String?
  chucDanh          String?
  chucVuDangDoan    String?
  soQuyetDinh       String?
  ngayNhanQuyetDinh DateTime?

  chucVu            DM_ChucVu?          @relation(fields: [chucVuId], references: [Id])
  chucVuId          String?             @db.Uuid

  loaiHinhCongTac   DM_LoaiHinhCongTac? @relation(fields: [loaiHinhCongTacId], references: [id])
  loaiHinhCongTacId String?

  userProfile       UserProfile         @relation(fields: [userProfileId], references: [id])
  userProfileId     String

  @@schema("ql-ho-so")
}

model QuaTrinhCuDiCongTac extends Base {
  tuThangNam    DateTime?
  denThangNam   DateTime?

  donVi         String

  chucVu        DM_ChucVu   @relation(fields: [chucVuId], references: [Id])
  chucVuId      String      @db.Uuid

  userProfile   UserProfile @relation(fields: [userProfileId], references: [id])
  userProfileId String

  @@schema("ql-ho-so")
}

model QuaTrinhCuDiDaoTao extends Base {
  ten           String?
  donViToChuc   String?
  tuNgay        DateTime?
  denNgay       DateTime?
  vanBang       String?

  loai          DM_LoaiHinhDiHocTap @relation(fields: [loaiId], references: [id])
  loaiId        String

  userProfile   UserProfile         @relation(fields: [userProfileId], references: [id])
  userProfileId String

  @@schema("ql-ho-so")
}

model KhenThuong extends Base {
  hinhThucKhenThuong String?
  capKhenThuong      String?
  soQuyetDinh        String?
  nguoiKy            String?
  ngayNhanQuyetDinh  DateTime?
  lyDo               String?

  userProfile        UserProfile @relation(fields: [userProfileId], references: [id])
  userProfileId      String

  @@schema("ql-ho-so")
}

model KyLuat extends Base {
  hinhThucKyLuat    String?
  capKyLuat         String?
  soQuyetDinh       String?
  nguoiKy           String?
  ngayNhanQuyetDinh DateTime?
  lyDo              String?

  userProfile       UserProfile @relation(fields: [userProfileId], references: [id])
  userProfileId     String

  @@schema("ql-ho-so")
}

model DoiTuongChinhSach extends Base {
  tenDoiTuong   String?
  ngayBatDau    DateTime?
  ngayKetThuc   DateTime?
  ghiChu        String?

  userProfile   UserProfile @relation(fields: [userProfileId], references: [id])
  userProfileId String

  @@schema("ql-ho-so")
}

model KeKhaiTaiSan extends Base {
  loai           String?
  tenDot         String?
  thoiGianKeKhai DateTime?

  userProfile    UserProfile @relation(fields: [userProfileId], references: [id])
  userProfileId  String

  @@schema("ql-ho-so")
}

model TiengDanToc extends Base {
  danToc        DM_DanToc?  @relation(fields: [danTocId], references: [Id])
  danTocId      String?     @db.Uuid

  nghe          String?
  noi           String?
  viet          String?

  userProfile   UserProfile @relation(fields: [userProfileId], references: [id])
  userProfileId String

  @@schema("ql-ho-so")
}

model ChienDau extends Base {
  cuongVi         String?
  donVi           String?
  diaDiem         String?
  vaiTro          String?
  doiTuong        String?
  thoiGianBatDau  DateTime?
  thoiGianKetThuc DateTime?

  userProfile     UserProfile @relation(fields: [userProfileId], references: [id])
  userProfileId   String

  @@schema("ql-ho-so")
}

model NuocNgoai extends Base {
  tenNuoc       DM_QuocGia  @relation(fields: [tenNuocId], references: [Id])
  tenNuocId     String      @db.Uuid

  tuNgay        DateTime?
  denNgay       DateTime?
  lyDo          String?

  userProfile   UserProfile @relation(fields: [userProfileId], references: [id])
  userProfileId String

  @@schema("ql-ho-so")
}

model ThuongTat extends Base {
  loai             DM_LoaiThuongTat @relation(fields: [loaiId], references: [id])
  loaiId           String

  tiLe             Int?
  nguyenNhan       String?
  thoiGian         DateTime?
  noiBiThuong      String?
  thoiGianGiamDinh DateTime?

  userProfile      UserProfile      @relation(fields: [userProfileId], references: [id])
  userProfileId    String
  @@schema("ql-ho-so")
}

model DanhHieu extends Base {
  ten           String?
  thoiGian      DateTime?

  userProfile   UserProfile @relation(fields: [userProfileId], references: [id])
  userProfileId String
  @@schema("ql-ho-so")
}

model QuaTrinhHocTap extends Base {
  tenTruong      DM_TruongDaoTaoBacDH       @relation(fields: [tenTruongId], references: [id])
  tenTruongId    String

  nganhHoc       DM_NganhHoc                @relation(fields: [nganhHocId], references: [id])
  nganhHocId     String

  chuyenNganh    DM_ChuyenNganhDaoTaoBacDH? @relation(fields: [chuyenNganhId], references: [id])
  chuyenNganhId  String?

  tuNgay         DateTime?
  denNgay        DateTime?
  ketQua         String?
  loaiHinhDaoTao String?

  userProfile    UserProfile                @relation(fields: [userProfileId], references: [id])
  userProfileId  String

  @@schema("ql-ho-so")
}

model ToChucXaHoi extends Base {
  ten           DM_ToChucXaHoi @relation(fields: [tenId], references: [id])
  tenId         String

  tuNgay        DateTime?
  denNgay       DateTime?
  congViec      String?

  userProfile   UserProfile    @relation(fields: [userProfileId], references: [id])
  userProfileId String

  @@schema("ql-ho-so")
}

model QuaTrinhLuong extends Base {
  tuNgay        DateTime?
  denNgay       DateTime?
  ngach         DM_Ngach    @relation(fields: [ngachId], references: [id])
  ngachId       String
  bacLuong      DM_BacLuong @relation(fields: [bacLuongId], references: [id])
  bacLuongId    String
  heSo          String?
  maNgach       String
  phuCapChucVu  String?
  phuCapKhac    String?

  userProfile   UserProfile @relation(fields: [userProfileId], references: [id])
  userProfileId String

  @@schema("ql-ho-so")
}

