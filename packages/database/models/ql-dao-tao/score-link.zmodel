import '../base'
import '../ql-nguoi-dung/user'
import '../ql-ho-so/profile'
import '../ql-danh-muc/core-categories'
import '../ql-danh-muc/document'
import '../ql-danh-muc/common'
import 'categories'
import 'plan-training'
import 'student'

enum ScoreLinkStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("ql-dao-tao")
}

model ScoreLinkSheet extends Base {
  note             String?
  status           ScoreLinkStatus    @default(PENDING)

  fixedClass       FixedClass         @relation(fields: [fixedClassId], references: [id])
  fixedClassId     String

  semester         Semester           @relation(fields: [semesterId], references: [id])
  semesterId       String

  curriculum       Curriculum         @relation(fields: [curriculumId], references: [id])
  curriculumId     String

  trainingCourse   TrainingCourse     @relation(fields: [trainingCourseId], references: [id])
  trainingCourseId String

  students         ScoreLinkStudent[]
  documents        DocumentFile[]

  @@unique([fixedClassId, semesterId, curriculumId, trainingCourseId])
  @@schema("ql-dao-tao")
}

model ScoreLinkSubject extends Base {
  scoreLinkStudent      ScoreLinkStudent     @relation(fields: [scoreLinkStudentId], references: [id])
  scoreLinkStudentId    String

  subjectVersion        SubjectVersion       @relation(fields: [subjectVersionId], references: [id])
  subjectVersionId      String

  score                 Float
  note                  String?

  studentSubjectScore   StudentSubjectScore?
  studentSubjectScoreId String?

  @@unique([scoreLinkStudentId, subjectVersionId])
  @@schema("ql-dao-tao")
}



model ScoreLinkStudent extends Base {
  scoreLinkSheet   ScoreLinkSheet     @relation(fields: [scoreLinkSheetId], references: [id])
  scoreLinkSheetId String

  student          Student            @relation(fields: [studentId], references: [id])
  studentId        String

  subjects         ScoreLinkSubject[]

  @@unique([scoreLinkSheetId, studentId])
  @@schema("ql-dao-tao")
}