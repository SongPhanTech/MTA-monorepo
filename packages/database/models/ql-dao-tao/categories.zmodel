enum DiplomaTypeEnum {
  MASTER             // Thạc sĩ
  DOCTORATE          // Tiến sĩ
  ENGINEER           // Kỹ sư
  BACHELOR           // Cử nhân

  @@schema("ql-dao-tao")
}

model DiplomaType extends Base {
  name                         String                         @unique
  englishName                  String?
  type                         DiplomaTypeEnum
  // diplomaPlaceHolder DiplomaPlaceHolder[]
  curriculumVersion            CurriculumVersion[]
  graduationDecision           GraduationDecision[]
  studentGraduationApplication StudentGraduationApplication[]

  @@schema("ql-dao-tao")
}


/// Bảng chuyển đổi điểm từ hệ 10 sang hệ 4 và hệ chữ; order by base10Max desc
// | **Loại điểm** | **Thang điểm 10**       | **Điểm chữ** | **Thang điểm 4** |
// |---------------|--------------------------|--------------|------------------|
// | **Xuất sắc**  | Từ 9,0 đến 10            | A+           | 4.0              |
// | **Giỏi**      | Từ 8,5 đến 8,9           | A            | 3.7              |
// |               | Từ 8,0 đến 8,4           | B+           | 3.5              |
// | **Khá**       | Từ 7,0 đến 7,9           | B            | 3.0              |
// | **TBK**       | Từ 6,5 đến 6,9           | C+           | 2.5              |
// | **TB**        | Từ 5,5 đến 6,4           | C            | 2.0              |
// |               | Từ 5,0 đến 5,4           | D+           | 1.5              | (Được học cải thiện)
// | **Yếu**       | Từ 4,0 đến 4,9           | D            | 1.0              | (Được học cải thiện)
// | **Kém**       | Dưới 4,0                 | F            | 0.0              | (Không đạt)
model ScoreConvert extends Base {
  classification      String // Xếp loại: Xuất sắc; Giỏi; Khá; TBK; TB; Yếu; Kém
  base10Min           Float
  base10Max           Float
  letter              String
  base4               Float

  pass                Boolean
  improvementRegister Boolean        @default(false) // có thể học cải thiện

  trainingCourse      TrainingCourse @relation(fields: [trainingCourseId], references: [id])
  trainingCourseId    String

  @@schema("ql-dao-tao")
}

enum AcademicRankingBaseType {
  Base10
  Base4

  @@schema("ql-dao-tao")
}

/// Danh mục tính tải đào tạo
model LoadCategory extends Base {
  name                String
  
  // Đơn vị tính (ví dụ: 1 Tiết, 1 Ngày, 1 Bài, 1 Lớp)
  unit                String 
  
  // Giá trị quy đổi ra Giờ Chuẩn
  standardHours       Float 
  
  // Phân loại chính (Ví dụ: Đào tạo Đại học, Đào tạo Sau đại học, Xây dựng CSVC)
  category            String
  
  // Ghi chú nếu có điều kiện đặc biệt (Ví dụ: Ban ngày, Ban đêm, Hoạt động có đánh dấu *)
  note                String?
  
  // Cờ xác định công việc có tính vào tổng giờ chuẩn để xét vượt định mức hay không (dấu *)
  isOverageCalculated Boolean
  
  // Mối quan hệ: Tải thực tế (Chi tiết công việc) sẽ tham chiếu đến danh mục này
  // teachingLoadEntries TeachingLoadEntry[]

  @@schema("ql-dao-tao")
}

