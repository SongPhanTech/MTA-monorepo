import '../base'
import 'output-standard'
import '../ql-dao-tao/plan-training'
import '../ql-dao-tao/score-link'
import '../ql-dao-tao/student'
import '../ql-dao-tao/thesis'
import '../ql-danh-muc/common'
import '../ql-ho-so/profile'
import '../ql-danh-muc/core-categories'
import '../khao-thi/exam'
import '../ql-danh-muc/document'
import "../khao-thi/survey"
import 'training-score'
import 'ranking'
import 'thesis'

enum TrainingObjectTypes {
  MILITARY // Học viên quân sự
  CIVILIAN // Sinh viên dân sự
  INTERNATIONAL_MILITARY // Học viên quân sự quốc tế

  @@schema("ql-dao-tao")
}

/// Đối tượng đào tạo
model TrainingObjectType extends Base {
  name                  String                              @unique
  type                  TrainingObjectTypes

  trainingForm          TrainingForm?                       @relation(fields: [trainingFormId], references: [id])
  trainingFormId        String?

  trainingLevel         TrainingLevel?                      @relation(fields: [trainingLevelId], references: [id])
  trainingLevelId       String?

  trainingCourse        TrainingCourse[]
  curriculum            Curriculum[]
  curriculumVersion     CurriculumVersion[]
  trainingMajors        TrainingMajorOnTrainingObjectType[]
  trainingFields        TrainingFieldOnTrainingObjectType[]
  trainingScoreSession  TrainingScoreSession[]
  subjectClass          SubjectClass[]
  graduationSession     GraduationSession[]
  subjectVersion        SubjectVersion[]
  planTraining          PlanTraining[]
  thesisSession         ThesisSession[]
  trainingBlocks        TrainingBlock[]
  vaiTro                String[] // Array of DM_VaiTro IDs
  surveyObjectType      SurveyObjectType[]
  survey                Survey[]
  scoreCorrectionTicket ScoreCorrectionTicket[]
  scoreLinkSheet        ScoreLinkSheet[]
  availableTrainingTime AvailableTrainingTime[]
  planTrainingPractice  PlanTrainingPractice[]

  @@schema("ql-dao-tao")
}

/// đối tượng ưu tiên
model PriorityObject extends Base {
  name     String    @unique

  students Student[]
  @@schema("ql-dao-tao")
}

/// loại hình đào tạo (Chính quy, không chính quy, từ xa, tại chức)
model TrainingType extends Base {
  name              String              @unique

  curriculumVersion CurriculumVersion[]

  @@schema("ql-dao-tao")
}

/// Bậc đào tạo (Đại học, thạc sĩ, tiến sĩ)
model TrainingLevel extends Base {
  name               String               @unique

  curriculumVersion  CurriculumVersion[]
  trainingObjectType TrainingObjectType[]
  @@schema("ql-dao-tao")
}

/// hình thức đào tạo/hình thức huấn luyện (Trực tiếp, trực tuyến, kết hợp)
model TrainingForm extends Base {
  name               String               @unique

  trainingObjectType TrainingObjectType[]
  @@schema("ql-dao-tao")
}

/// địa điểm đào tạo
model TrainingLocation extends Base {
  name           String         @unique

  dM_Tinh        DM_Tinh?       @relation(fields: [dM_TinhId], references: [Id])
  dM_TinhId      String?        @db.Uuid

  dM_Tinh_New    DM_Tinh_New?   @relation(fields: [dM_Tinh_NewId], references: [Id])
  dM_Tinh_NewId  String?        @db.Uuid

  students       Student[]
  buildings      Building[]
  subjectClasses SubjectClass[] @relation("ClassTrainingLocation")

  @@schema("ql-dao-tao")
}

model Building extends Base {
  name               String
  floor              Int?

  trainingLocation   TrainingLocation? @relation(fields: [trainingLocationId], references: [id])
  trainingLocationId String?

  rooms              Room[]

  @@schema("ql-dao-tao")
}

model Room extends Base {
  name           String

  trainingRoom   Boolean         @default(true)
  computerRoom   Boolean         @default(false)
  laboratoryRoom Boolean         @default(false)
  examRoom       Boolean         @default(false)

  capacity       Int
  examCapacity   Int?

  building       Building?       @relation(fields: [buildingId], references: [id])
  buildingId     String?

  subjectClasses SubjectClass[]  @relation("ClassRoom")
  defenseRooms   SubjectClass[]  @relation("DefenseRooms") // DS phòng bảo vệ đồ án -> chọn phòng tự động
  thesisProject  ThesisProject[]
  classSchedules ClassSchedule[]
  examRooms      ExamRoom[]

  @@schema("ql-dao-tao")
}

/// ngành đào tạo
model TrainingField extends Base {
  name                String
  englishName         String
  publishDate         DateTime
  ///  số QĐ mở mã ngành
  decisionNo          String?
  organization        DM_DonVi                            @relation(fields: [organizationId], references: [Id])
  organizationId      String                              @db.Uuid
  trainingObjectTypes TrainingFieldOnTrainingObjectType[]
  trainingMajors      TrainingMajor[]
  curriculum          Curriculum[]
  surveyObjectTypes   SurveyObjectType[]
  documentFiles       DocumentFile[]
  students            Student[]

  @@schema("ql-dao-tao")
}

model TrainingFieldOnTrainingObjectType extends Base {
  trainingField        TrainingField      @relation(fields: [trainingFieldId], references: [id])
  trainingFieldId      String
  trainingObjectType   TrainingObjectType @relation(fields: [trainingObjectTypeId], references: [id])
  trainingObjectTypeId String

  @@unique([trainingFieldId, trainingObjectTypeId])

  @@schema("ql-dao-tao")
}

/// chuyên ngành đào tạo
model TrainingMajor extends Base {
  name                         String
  englishName                  String?
  shortName                    String? // Tên viết tắt
  summary                      String?
  /// Số tín chỉ chuyên ngành
  numberCreditsMajor           Int                                 @default(0)
  /// Số tín chỉ bắt buộc
  numberCreditsRequired        Int                                 @default(0)
  /// Số tín chỉ tự chọn
  numberCreditsElective        Int                                 @default(0)
  organization                 DM_DonVi                            @relation("organization", fields: [organizationId], references: [Id])
  organizationId               String                              @db.Uuid
  secondOrganization           DM_DonVi?                           @relation("secondOrganization", fields: [secondOrganizationId], references: [Id])
  secondOrganizationId         String?                             @db.Uuid
  thirdOrganization            DM_DonVi?                           @relation("thirdOrganization", fields: [thirdOrganizationId], references: [Id])
  thirdOrganizationId          String?                             @db.Uuid
  trainingField                TrainingField                       @relation(fields: [trainingFieldId], references: [id])
  trainingFieldId              String

  trainingObjectTypes          TrainingMajorOnTrainingObjectType[]
  curriculum                   Curriculum[]
  graduationDecision           GraduationDecision[]
  expert                       Expert[]
  studentGraduationApplication StudentGraduationApplication[]

  surveyObjectTypes            SurveyObjectType[]
  @@schema("ql-dao-tao")
}

model TrainingMajorOnTrainingObjectType extends Base {
  trainingMajor        TrainingMajor      @relation(fields: [trainingMajorId], references: [id])
  trainingMajorId      String
  trainingObjectType   TrainingObjectType @relation(fields: [trainingObjectTypeId], references: [id])
  trainingObjectTypeId String

  @@unique([trainingMajorId, trainingObjectTypeId])
  @@schema("ql-dao-tao")
}

/// khối kiến thức
model TrainingBlock extends BaseNoCode {
  code                 String?
  name                 String

  trainingObjectType   TrainingObjectType                 @relation(fields: [trainingObjectTypeId], references: [id])
  trainingObjectTypeId String
  isNationalDefense    Boolean                            @default(false)
  /// ưu tiên sắp xếp
  priority             Int                                @default(0)

  parent               TrainingBlock?                     @relation("ParentChild", fields: [parentId], references: [id])
  parentId             String?
  children             TrainingBlock[]                    @relation("ParentChild")

  curriculumVersions   TrainingBlockOnCurriculumVersion[]
  criteriaDefinitions  CriteriaDefinition[]

  @@unique([trainingObjectTypeId, name])
  @@schema("ql-dao-tao")
}

model TrainingBlockOnCurriculumVersion extends Base {
  trainingBlock           TrainingBlock          @relation(fields: [trainingBlockId], references: [id])
  trainingBlockId         String
  curriculumVersion       CurriculumVersion?     @relation(fields: [curriculumVersionId], references: [id])
  curriculumVersionId     String?

  /// ưu tiên sắp xếp
  priority                Int                    @default(0)
  electiveCreditsRequired Int                    @default(0)
  subjects                TrainingBlockSubject[]

  @@unique([trainingBlockId, curriculumVersionId])
  @@schema("ql-dao-tao")
}

/// thời gian đào tạo
model TrainingTime extends Base {
  name              String

  curriculumVersion CurriculumVersion[]
  @@schema("ql-dao-tao")
}

// quỹ thời gian có thể dào tạo
model AvailableTrainingTime extends Base {
  duration             Float                 // số lượng đơn vị thời gian tính theo ngày
  trainingObjectType   TrainingObjectType? @relation(fields: [trainingObjectTypeId], references: [id])
  trainingObjectTypeId String?
  semester             Semester?           @relation(fields: [semesterId], references: [id])
  semesterId           String?
  @@schema("ql-dao-tao")
}

/// Chứng chỉ
model Certificate extends Base {
  name                String
  englishName         String?

  /// chuẩn đầu ra
  outputStandard      OutputStandard?        @relation(fields: [outputStandardId], references: [id])
  outputStandardId    String?

  /// SV đạt
  archivedCertificate ArchivedCertificate[]
  /// môn học có thể phiên điểm
  subjects            CertificateOnSubject[]
  /// danh sách môn để xét chứng chỉ (e.g. SUM(finalScore * credit) / SUM(credit) > 5)
  subjectVersions     SubjectVersion[]

  scoreThreshold      Float @default(5)

  // phân biệt chứng chỉ dùng điểm hay đạt/không đạt
  isUsingScore        Boolean                @default(true)

  @@schema("ql-dao-tao")
}

model CertificateOnSubject extends Base {
  /// phiên điểm môn học
  finalScore    Float       @gte(0, 'Điểm tối thiểu là 0') @lte(10, 'Điểm tối đa là 10')

  certificate   Certificate @relation(fields: [certificateId], references: [id])
  certificateId String

  subject       Subject     @relation(fields: [subjectId], references: [id])
  subjectId     String

  @@schema("ql-dao-tao")
}

/// Giải thưởng
model Award extends Base {
  name          String
  englishName   String?
  bonusScore    Float

  /// môn học có thể cộng điểm
  subjects      Subject[]
  /// SV đạt
  archivedAward ArchivedAward[]

  @@schema("ql-dao-tao")
}

/// Chức vụ cán bộ lớp
enum OfficerPosition {
  CLASS_MONITOR          // Lớp trưởng
  UNION_SECRETARY        // Bí thư
  UNION_LEADER           // Bí thư liên chi đoàn
  DEPUTY_UNION_SECRETARY // Phó bí thư liên chi đoàn

  @@schema("ql-dao-tao")
}

/// Điểm cộng cán bộ lớp
model OfficerBonusScore extends Base {
  position   OfficerPosition @unique
  bonusScore Float           @default(0) @gte(0, 'Điểm tối thiểu là 0') @lte(10, 'Điểm tối đa là 10')

  @@schema("ql-dao-tao")
}



