import '../base'
import '../ql-nguoi-dung/user'
import '../ql-danh-muc/categories'
import '../ql-danh-muc/common'
import '../ql-dao-tao/categories'
import '../ql-dao-tao/plan-training'
import '../ql-nguoi-dung/profile'

model Staff extends Base {
  from            DateTime? // từ ngày

  // lecture/staff information
  lectureID       String?       @unique // giảng viên ID
  lectureCode     String?       @unique // mã giảng viên
  serviceDate     DateTime? // ngày vào ngành

  userProfile     UserProfile   @relation(fields: [userProfileId], references: [id])
  userProfileId   String        @unique

  organization    Organization  @relation(fields: [organizationId], references: [id])
  organizationId  String

  staffType       StaffType     @relation(fields: [staffTypeId], references: [id])
  staffTypeId     String

  staffPosition   StaffPosition @relation(fields: [staffPositionId], references: [id])
  staffPositionId String

  @@schema("ql-dao-tao")
}

model StaffHistory extends Base {
  from            DateTime? // từ ngày
  to              DateTime? // đến ngày

  userProfile     UserProfile   @relation(fields: [userProfileId], references: [id])
  userProfileId   String        @unique

  organization    Organization? @relation(fields: [organizationId], references: [id])
  organizationId  String?

  staffType       StaffType     @relation(fields: [staffTypeId], references: [id])
  staffTypeId     String

  staffPosition   StaffPosition @relation(fields: [staffPositionId], references: [id])
  staffPositionId String

  @@schema("ql-dao-tao")
}