import '../base'
import '../ql-nguoi-dung/user'
import '../ql-ho-so/profile'
import '../ql-danh-muc/core-categories'
import '../ql-danh-muc/common'
import 'categories'
import 'plan-training'
import 'student'

// Đợt đánh giá rèn luyện, đi theo kỳ và đối tượng đào tạo
model TrainingScoreSession extends Base {
  name                 String
  time                 DateTime               @default(now())// thời gian

  semester             Semester               @relation(fields: [semesterId], references: [id])
  semesterId           String

  trainingObjectType   TrainingObjectType     @relation(fields: [trainingObjectTypeId], references: [id]) // loại đối tượng đào tạo
  trainingObjectTypeId String

  studentTrainingScore StudentTrainingScore[]
  @@schema("ql-dao-tao")
}

enum TrainingScoreStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("ql-dao-tao")
}

// Điểm rèn luyện của sinh viên, được tính theo đợt đánh giá
model StudentTrainingScore extends Base {
  trainingScoreSession   TrainingScoreSession @relation(fields: [trainingScoreSessionId], references: [id])
  trainingScoreSessionId String

  student                Student              @relation(fields: [studentId], references: [id])
  studentId              String

  score                  Float?
  studentTrainingType    StudentTrainingType? @default(GOOD)

  status                 TrainingScoreStatus  @default(PENDING)

  @@unique([trainingScoreSessionId, studentId])
  @@schema("ql-dao-tao")
}


// Điểm rèn luyện theo học kỳ
model SemesterTrainingScore extends Base {
  semester                Semester              @relation(fields: [semesterId], references: [id])
  semesterId              String

  student                Student              @relation(fields: [studentId], references: [id])
  studentId              String

  score                  Int?

  status                 TrainingScoreStatus  @default(PENDING)

  @@schema("ql-dao-tao")
}

// Điểm rèn luyện theo năm học
model SchoolYearTrainingScore extends Base {
  schoolYear                SchoolYear              @relation(fields: [schoolYearId], references: [id])
  schoolYearId              String

  student                Student              @relation(fields: [studentId], references: [id])
  studentId              String

  score                  Int?
  
  status                 TrainingScoreStatus  @default(PENDING)

  @@schema("ql-dao-tao")
}

enum StudentTrainingType {
  EXCELLENT // Xuất sắc - cho SV DS
  GOOD      // Tốt
  FAIR      // Khá
  MEDIUM  // Trung bình khá
  AVERAGE   // Trung bình
  POOR      // Yếu
  VERY_POOR // Kém
  @@schema("ql-dao-tao")
}
