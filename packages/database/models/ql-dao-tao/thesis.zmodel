import '../base'
import '../ql-dao-tao/lecturer'
import '../ql-dao-tao/student'
import '../ql-dao-tao/plan-training'
import '../ql-dao-tao/categories'
import '../ql-danh-muc/core-categories'
import '../ql-danh-muc/document'

// Trạng thái đồ án
enum ThesisProjectStatus {
  PROPOSED // Mới đề xuất (GV đề xuất)
  APPROVED_BY_DEPT // Khoa/Bộ môn đã duyệt
  ASSIGNED // Đã giao cho SV
  IN_PROGRESS // Đang thực hiện
  DEFENSE_ELIGIBLE // Đủ điều kiện bảo vệ
  DEFENDED_PASSED // Đã bảo vệ - Đạt
  DEFENDED_FAILED // Đã bảo vệ - Không đạt
  COMPLETED // Đã hoàn thành (nộp lưu chiểu)
  CANCELED // Đã hủy

  @@schema("ql-dao-tao")
}

model ThesisSession extends Base {
  name                  String
  startDate             DateTime
  endDate               DateTime

  // Đối tượng đào tạo
  trainingObjectType    TrainingObjectType @relation(fields: [trainingObjectTypeId], references: [id])
  trainingObjectTypeId  String

  trainingCourse        TrainingCourse     @relation(fields: [trainingCourseId], references: [id])
  trainingCourseId      String

  /// Tờ trình đề tài
  proposalReport        String?

  /// Tờ trình hội đồng
  councilReport         String?
  /// Tờ trình tốt nghiệp
  graduationReport      String?

  /// Số QĐĐT
  decisionNumber        String?
  /// người ký quyết định
  decisionMaker         String?
  /// Ngày QĐĐT
  decisionDate          DateTime?

  /// Số QĐBVLV
  defenseDecisionNumber String?
  /// người ký QĐBVLV
  defenseDecisionMaker  String?
  /// Ngày QĐBVLV
  defenseDecisionDate   DateTime?

  // Số QĐ tốt nghiệp
  graduationNumber String?
  /// Người ký QĐ tốt nghiệp
  graduationDecisionMaker  String?
  /// Ngày QĐ tốt nghiệp
  graduationDecisionDate   DateTime?

  /// Trưởng phòng sau đại học
  chief                 String?

  /// Phó phòng sau đại học
  deputy                String?

  /// Hạn nhập đề tài
  topicEntryDeadline    DateTime?
  /// Hạn nhập hội đồng
  councilDeadline       DateTime?

  thesisProject         ThesisProject[]
  configPayment         ConfigPaymentSession?

  @@schema("ql-dao-tao")
}

enum ThesisType {
  THESIS // Luận văn
  PROJECT // Đồ án
  @@schema("ql-dao-tao")
}

// Bảng đồ án
model ThesisProject extends Base {
  title                     String?                       // Tên đồ án
  titleEN                   String?                       // Tên đồ án (Tiếng Anh)
  summary                   String?                     @db.Text() // Tóm tắt đồ án
  objectives                String?                     @db.Text() // Mục tiêu
  scope                     String?                     @db.Text() // Phạm vi thực hiện
  methodology               String?                     @db.Text() // Phương pháp thực hiện
  expectedResults           String?                     @db.Text() // Kết quả mong đợi
  requirements              String?                     @db.Text() // Yêu cầu với học viên
  technologies              String?                     @db.Text() // Công nghệ sử dụng
  thesisType                ThesisType                  @default(PROJECT)
  status                    ThesisProjectStatus         @default(PROPOSED)
  language                  String?                     @db.Text() // Ngôn ngữ
  type                      String?                     @db.Text() // Loại luận văn (Luận văn/Đề án)
  isLock                    Boolean                     @default(false) //Khoá đồ án
  editProject               String?                     @db.Text() // Chỉnh sửa đồ án (Thư ký tổng hợp nhập)

  researchTopicAssociated   String? // gán với đề tài nghiên cứu

  // Tiến độ kiểm tra
  firstCheckProgress        Int?                        // Tiến độ kiểm tra lần 1 % (0-100)
  secondCheckProgress       Int?                        // Tiến độ kiểm tra lần 2 % (0-100)
  isEligibleForDefense      Boolean                     @default(true) // Đủ điều kiện bảo vệ

  //GVHD1 cho đồ án
  primarySupervisor         Lecturer?                   @relation("PrimarySupervisorToThesis", fields: [primarySupervisorId], references: [id])
  primarySupervisorId       String?                   

  //GVHD2 cho đồ án
  secondarySupervisor       Lecturer?                   @relation("SecondarySupervisorToThesis", fields: [secondarySupervisorId], references: [id])
  secondarySupervisorId     String?

  //GVHD3 cho đồ án
  thirdSupervisor           ExpertProfile?              @relation("ThirdSupervisorToThesis", fields: [thirdSupervisorId], references: [id])
  thirdSupervisorId         String?

  isProductProject          Boolean                     @default(false) // Đồ án sản phẩm
  isGroupProject            Boolean                     @default(false) // Đồ án nhóm
  isLanguage                Boolean                     @default(false) // Ngoại ngữ
  externalUnit              Boolean                     @default(false) // Đơn vị ngoài đề xuất

  subjectClass              SubjectClass?               @relation(fields: [subjectClassId], references: [id])
  subjectClassId            String?

  thesisSession             ThesisSession?              @relation(fields: [thesisSessionId], references: [id])
  thesisSessionId           String?

  supervisorName            String?
  /// Chuyên gia hướng dẫn
  supervisor                ExpertProfile?              @relation("SupervisorToThesis", fields: [supervisorId], references: [id])
  supervisorId              String?
  supervisorPayment         SupervisorPaymentRecord?    @relation("SupervisorToSupervisorPayment", fields: [supervisorPaymentId], references: [id])
  supervisorPaymentId       String?

  coSupervisorName          String?
  /// Chuyên gia hướng dẫn bảo vệ phụ
  coSupervisor              ExpertProfile?              @relation("CoSupervisorToThesis", fields: [coSupervisorId], references: [id])
  coSupervisorId            String?
  coSupervisorPayment       SupervisorPaymentRecord?    @relation("CoSupervisorToSupervisorPayment", fields: [coSupervisorPaymentId], references: [id])
  coSupervisorPaymentId     String?
  singleSupervisorPayment   SupervisorPaymentRecord?    @relation("SingleSupervisorPayment", fields: [singleSupervisorPaymentId], references: [id])
  singleSupervisorPaymentId String?
  singlePayment             Decimal?

  CHUTICH                   String?
  THUKY                     String?
  PHANBIEN1                 String?
  PHANBIEN2                 String?
  UYVIEN3                   String?

  /// Đơn vị quản lý
  organization              DM_DonVi?                   @relation(fields: [organizationId], references: [Id])
  organizationId            String?                     @db.Uuid

  // Thông tin đăng ký
  maxStudents               Int?                           // Số lượng học viên tối đa

  /// Hội đồng đánh giá
  council                   Council?                    @relation(fields: [councilId], references: [id])
  councilId                 String?

  /// phòng bảo vệ
  room                      Room?                       @relation(fields: [roomId], references: [id])
  roomId                    String?

  /// Ngày bảo vệ
  defenseDate               DateTime?
  defenseSession            DefenseSession?             @relation(fields: [defenseSessionId], references: [id])
  defenseSessionId          String?

  // Thời gian
  registrationStart         DateTime?                     // Thời gian mở đăng ký
  registrationEnd           DateTime?                     // Thời gian đóng đăng ký
  projectStart              DateTime?                     // Thời gian bắt đầu thực hiện
  projectEnd                DateTime?                     // Thời gian kết thúc dự kiến

  defenseRecord             DefenseRecord?
  librarySubmission         LibrarySubmission?

  decisions                 Decision[]
  registrations             StudentThesisRegistration[]
  // supervisorPayments SupervisorPaymentRecord[]

  @@schema("ql-dao-tao")
}

/// Ca bảo vệ
model DefenseSession extends Base {
  startTime     DateTime        @db.Time(0)
  thesisProject ThesisProject[]

  @@schema("ql-dao-tao")
}

// Enum trạng thái đăng ký đồ án của học viên
enum StudentThesisRegistrationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELED
  @@schema("ql-dao-tao")
}

// Bảng đăng ký đồ án của học viên
model StudentThesisRegistration extends Base {
  // keep this for backward compatibility
  student               Student                         @relation(fields: [studentId], references: [id])
  studentId             String

  studentSubjectScore   StudentSubjectScore?            @relation("ScoreToRegistration", fields: [studentSubjectScoreId], references: [id])
  studentSubjectScoreId String?

  thesisProject         ThesisProject                   @relation(fields: [thesisProjectId], references: [id])
  thesisProjectId       String

  // Thông tin đăng ký
  registeredAt          DateTime                        @default(now()) // Thời gian đăng ký
  motivation            String?                         @db.Text() // Lý do muốn tham gia
  experience            String?                         @db.Text() // Kinh nghiệm liên quan
  proposedIdeas         String?                         @db.Text() // Ý tưởng đóng góp

  status                StudentThesisRegistrationStatus @default(PENDING)
  reviewedAt            DateTime?                   // Thời gian phê duyệt
  reviewedBy            Lecturer?                       @relation(fields: [reviewedById], references: [id])
  reviewedById          String?
  reviewNote            String?                         @db.Text() // Ghi chú của giảng viên

  council               Council?

  @@unique([studentId, thesisProjectId])
  @@schema("ql-dao-tao")
}

/// Model cho Chuyên gia (Giảng viên trong và ngoài trường)
model ExpertProfile extends Base {
  lecturer                     Lecturer?              @relation(fields: [lecturerId], references: [id])
  lecturerId                   String?                @unique // Null nếu là chuyên gia ngoài trường
  name                         String?   // Họ tên
  academicDegreeType           DM_HocVi?              @relation(fields: [academicDegreeTypeId], references: [Id])
  academicDegreeTypeId         String?                @db.Uuid
  academicRankType             DM_HocHam?             @relation(fields: [academicRankTypeId], references: [Id])
  academicRankTypeId           String?                @db.Uuid
  organization                 String?   // Đơn vị
  position                     String?   // Chức vụ
  specialization               String?   // Chuyên ngành
  major                        TrainingMajor[]
  workplace                    String?   // Đơn vị công tác
  phone                        String?
  email                        String?                @email // Dùng email này để liên lạc nếu là chuyên gia ngoài
  bankAccountNumber            String? // số tài khoản ngân hàng
  bankName                     String? // tên ngân hàng

  projectExpert                Boolean                @default(false)
  thesisExpert                 Boolean                @default(false)

  eligiblePresident            Boolean                @default(false) // có thể làm chủ tịch
  eligibleSecretary            Boolean                @default(false) // có thể làm thư ký

  supervisedTheses             ThesisProject[]        @relation("SupervisorToThesis")
  coSupervisedTheses           ThesisProject[]        @relation("CoSupervisorToThesis")
  thirdSupervisedTheses        ThesisProject[]        @relation("ThirdSupervisorToThesis")
  supervisorResearchTopic      StudentResearchTopic[] @relation("SupervisorToResearchTopic")
  coSupervisorResearchTopic    StudentResearchTopic[] @relation("CoSupervisorToResearchTopic")
  thirdSupervisorResearchTopic StudentResearchTopic[] @relation("ThirdSupervisorToResearchTopic")
  supervisorInternship         StudentInternship[]    @relation("SupervisorToInternship")
  coSupervisorInternship       StudentInternship[]    @relation("CoSupervisorToInternship")
  subjectClass                 SubjectClass[] // DS lớp đồ án chuyên gia tham gia hội đồng
  councilMemberships           CouncilMember[]
  // payments                PaymentRecord[]
  // supervisorPaymentRecord SupervisorPaymentRecord[]

  @@schema("ql-dao-tao")
}

/// Loại quyết định
enum DecisionType {
  SUPERVISION_GUIDE // Quyết định Hướng dẫn
  EVALUATION_COUNCIL // Quyết định Thành lập Hội đồng

  @@schema("ql-dao-tao")
}

/// Quản lý các Quyết định liên quan
model Decision extends Base {
  issueDate       DateTime // Ngày ban hành
  type            DecisionType
  documentFile    DocumentFile[]

  thesisProject   ThesisProject  @relation(fields: [thesisProjectId], references: [id])
  thesisProjectId String

  @@schema("ql-dao-tao")
}

/// Quản lý Giấy mời
model Invitation extends Base {
  sentDate        DateTime      @default(now())
  isConfirmed     Boolean       @default(false)

  councilMember   CouncilMember @relation(fields: [councilMemberId], references: [id])
  councilMemberId String        @unique

  @@schema("ql-dao-tao")
}

/// Trạng thái đề xuất thành lập hội đồng
enum CouncilProposalStatus {
  PENDING // Chờ phê duyệt
  APPROVED // Đã phê duyệt
  REJECTED // Từ chối

  @@schema("ql-dao-tao")
}


/// Hội đồng đánh giá
model Council extends Base {
  proposedDate                DateTime                   @default(now())
  status                      CouncilProposalStatus      @default(PENDING)

  studentThesisRegistration   StudentThesisRegistration? @relation(fields: [studentThesisRegistrationId], references: [id])
  studentThesisRegistrationId String?                    @unique

  thesis                      ThesisProject[]
  members                     CouncilMember[]

  @@schema("ql-dao-tao")
}

enum CouncilRole {
  CHAIRMAN // Chủ tịch
  SECRETARY // Thư ký
  REVIEWER_1 // Phản biện 1
  REVIEWER_2 // Phản biện 2
  MEMBER // Ủy viên

  @@schema("ql-dao-tao")
}

enum SupervisorRole {
  SUPERVISOR // Chuyên gia hướng dẫn
  CO_SUPERVISOR // Chuyên gia hướng dẫn phụ
  SINGLE // Chuyên gia hướng dẫn đơn lẻ

  @@schema("ql-dao-tao")
}
/// Thành viên trong một Hội đồng
model CouncilMember extends Base {
  role        CouncilRole
  councilId   String
  council     Council        @relation(fields: [councilId], references: [id])
  expertId    String?
  expert      ExpertProfile?  @relation(fields: [expertId], references: [id])
  payment     PaymentRecord?

  invitations Invitation?

  // @@unique([councilId, expertId ?? ""])

  @@schema("ql-dao-tao")
}

/// Hồ sơ và Kết quả bảo vệ
model DefenseRecord extends Base {
  finalScore        Decimal?       @db.Decimal(5, 2) // Điểm cuối cùng
  comments          String?        @db.Text // Nhận xét chung của hội đồng
  isProfileComplete Boolean        @default(false)

  thesis            ThesisProject  @relation(fields: [thesisId], references: [id])
  thesisId          String         @unique

  documents         DocumentFile[]

  @@schema("ql-dao-tao")
}

/// Quản lý việc nộp Luận văn cho Thư viện
model LibrarySubmission extends Base {
  submissionDate DateTime       @default(now())
  isHardcopy     Boolean        @default(false) // Đã nộp bản cứng
  isSoftcopy     Boolean        @default(false) // Đã nộp bản mềm
  librarianNote  String?

  thesis         ThesisProject  @relation(fields: [thesisId], references: [id])
  thesisId       String         @unique
  confirmedById  String? // ID của thủ thư đã xác nhận

  documentFile   DocumentFile[]

  @@schema("ql-dao-tao")
}

/// Bộ định mức thanh toán gắn với một đợt xét
model ConfigPaymentSession extends Base {
  name      String
  sessionId String        @unique
  session   ThesisSession @relation(fields: [sessionId], references: [id])

  councilPayAmounts    DefaultCouncilRolePayAmount[] @relation("ConfigCouncilPayAmounts")
  supervisorPayAmounts DefaultSupervisorPayAmount[] @relation("ConfigSupervisorPayAmounts")

  @@schema("ql-dao-tao")
}

/// Định mức hội đồng
model DefaultCouncilRolePayAmount extends Base {
  role      CouncilRole
  amount    Decimal
  inAcademy Boolean     @default(true)

  configPaymentSessionId String?
  configPaymentSession   ConfigPaymentSession? @relation(
    "ConfigCouncilPayAmounts",
    fields: [configPaymentSessionId],
    references: [id]
  )

  @@unique([configPaymentSessionId, role, inAcademy, description])
  @@schema("ql-dao-tao")
}

/// Định mức hướng dẫn
model DefaultSupervisorPayAmount extends Base {
  role      SupervisorRole
  amount    Decimal
  inAcademy Boolean        @default(true)

  configPaymentSessionId String?
  configPaymentSession   ConfigPaymentSession? @relation(
    "ConfigSupervisorPayAmounts",
    fields: [configPaymentSessionId],
    references: [id]
  )

  @@unique([configPaymentSessionId, role, inAcademy, description])
  @@schema("ql-dao-tao")
}
enum PaymentStatus {
  PENDING // Chờ thanh toán
  PROCESSING // Đang xử lý
  PAID // Đã thanh toán
  FAILED // Thanh toán lỗi

  @@schema("ql-dao-tao")
}

/// Quản lý việc thanh toán hội đồng
model PaymentRecord  extends Base {
  amount          Decimal
  status          PaymentStatus  @default(PENDING)
  paymentDate     DateTime?
  transactionCode String?

  // expert          ExpertProfile  @relation(fields: [expertId], references: [id])
  // expertId        String

  // Có thể liên kết với thành viên hội đồng
  councilMemberId String?        @unique
  councilMember   CouncilMember? @relation(fields: [councilMemberId], references: [id])

  @@schema("ql-dao-tao")
}

/// Quản lý việc thanh toán hướng dẫn
model SupervisorPaymentRecord  extends Base {
  // thesisProject   ThesisProject @relation(fields: [thesisProjectId], references: [id])
  // thesisProjectId String
  // expert          ExpertProfile @relation(fields: [expertId], references: [id])
  // expertId        String
  amount                  Decimal
  status                  PaymentStatus   @default(PENDING)
  paymentDate             DateTime?
  transactionCode         String?
  thesisProjects          ThesisProject[] @relation("SupervisorToSupervisorPayment")
  coThesisProjects        ThesisProject[] @relation("CoSupervisorToSupervisorPayment")
  singleSupervisorPayment ThesisProject[] @relation("SingleSupervisorPayment")
  @@schema("ql-dao-tao")
}