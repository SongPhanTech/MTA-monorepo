import '../base'
import '../ql-dao-tao/lecturer'
import '../ql-dao-tao/student'
import '../ql-danh-muc/core-categories.zmodel'

// Enum trạng thái đồ án
enum ThesisProjectStatus {
  OPEN            // Đang mở đăng ký
  FULL            // Đã đủ thành viên
  CLOSED          // Đã đóng đăng ký
  IN_PROGRESS     // Đang thực hiện
  COMPLETED       // Đã hoàn thành

  @@schema("ql-dao-tao")
}

// Enum trạng thái đăng ký đồ án của học viên
enum ThesisRegistrationStatus {
  PENDING         // Chờ phê duyệt
  APPROVED        // Đã phê duyệt
  REJECTED        // Bị từ chối
  CANCELLED       // Đã hủy

  @@schema("ql-dao-tao")
}

// Bảng đồ án
model ThesisProject extends Base {
  title                 String                        // Tên đồ án
  summary               String                        @db.Text() // Tóm tắt đồ án
  objectives            String?                       @db.Text() // Mục tiêu
  scope                 String?                       @db.Text() // Phạm vi thực hiện
  methodology           String?                       @db.Text() // Phương pháp thực hiện
  expectedResults       String?                       @db.Text() // Kết quả mong đợi
  requirements          String?                       @db.Text() // Yêu cầu với học viên
  technologies          String?                       @db.Text() // Công nghệ sử dụng
  
  // Giáo viên hướng dẫn
  supervisor            Lecturer                      @relation(fields: [supervisorId], references: [id])
  supervisorId          String
  
  // Đơn vị quản lý
  organization          DM_DonVi                      @relation(fields: [organizationId], references: [Id])
  organizationId        String
  
  // Thông tin đăng ký
  maxStudents           Int                           // Số lượng học viên tối đa
  currentStudents       Int                           @default(0) // Số học viên hiện tại
  
  // Thời gian
  registrationStart     DateTime                      // Thời gian mở đăng ký
  registrationEnd       DateTime                      // Thời gian đóng đăng ký
  projectStart          DateTime?                     // Thời gian bắt đầu thực hiện
  projectEnd            DateTime?                     // Thời gian kết thúc dự kiến
  
  status                ThesisProjectStatus           @default(OPEN)
  
  // Đăng ký của học viên
  registrations         StudentThesisRegistration[]
  
  @@schema("ql-dao-tao")
}

// Bảng đăng ký đồ án của học viên
model StudentThesisRegistration extends Base {
  student               Student                     @relation(fields: [studentId], references: [id])
  studentId             String
  
  thesisProject         ThesisProject               @relation(fields: [thesisProjectId], references: [id])
  thesisProjectId       String
  
  // Thông tin đăng ký
  registeredAt          DateTime                    @default(now()) // Thời gian đăng ký
  motivation            String?                     @db.Text() // Lý do muốn tham gia
  experience            String?                     @db.Text() // Kinh nghiệm liên quan
  proposedIdeas         String?                     @db.Text() // Ý tưởng đóng góp
  
  // Trạng thái
  status                ThesisRegistrationStatus    @default(PENDING)
  
  // Phê duyệt
  reviewedAt            DateTime?                   // Thời gian phê duyệt
  reviewedBy            Lecturer?                   @relation(fields: [reviewedById], references: [id])
  reviewedById          String?
  reviewNote            String?                     @db.Text() // Ghi chú của giáo viên
  
  @@unique([studentId, thesisProjectId])
  @@schema("ql-dao-tao")
}