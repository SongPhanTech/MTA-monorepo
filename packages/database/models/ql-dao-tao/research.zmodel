import '../base'
import '../ql-dao-tao/lecturer'
import '../ql-dao-tao/student'
import '../ql-danh-muc/core-categories'

// Enum trạng thái đề tài
enum ResearchProjectStatus {
  OPEN            // Đang mở đăng ký
  FULL            // Đã đủ thành viên
  CLOSED          // Đã đóng đăng ký
  COMPLETED       // Đã hoàn thành

  @@schema("ql-dao-tao")
}

// Enum trạng thái đăng ký của học viên
enum RegistrationStatus {
  PENDING         // Chờ phê duyệt
  APPROVED        // Đã phê duyệt
  REJECTED        // Bị từ chối
  CANCELLED       // Đã hủy

  @@schema("ql-dao-tao")
}

// Bảng đề tài nghiên cứu
model ResearchProject extends Base {
  title             String                      // Tên đề tài
  summary           String                        @db.Text() // Tóm tắt đề tài
  objectives        String?                       @db.Text() // Mục tiêu nghiên cứu
  methodology       String?                       @db.Text() // Phương pháp nghiên cứu
  expectedResults   String?                       @db.Text() // Kết quả mong đợi
  requirements      String?                       @db.Text() // Yêu cầu với học viên
  
  // Giáo viên hướng dẫn
  supervisor        Lecturer                      @relation(fields: [supervisorId], references: [id])
  supervisorId      String
  
  // Đơn vị quản lý
  organization      DM_DonVi                      @relation(fields: [organizationId], references: [Id])
  organizationId    String                        @db.Uuid
  
  // Thông tin đăng ký
  maxStudents       Int                         // Số lượng học viên tối đa
  currentStudents   Int                           @default(0) // Số học viên hiện tại
  
  // Thời gian
  registrationStart DateTime                    // Thời gian mở đăng ký
  registrationEnd   DateTime                    // Thời gian đóng đăng ký
  projectStart      DateTime?                   // Thời gian bắt đầu thực hiện
  projectEnd        DateTime?                   // Thời gian kết thúc dự kiến

  status            ResearchProjectStatus         @default(OPEN)
  
  // Đăng ký của học viên
  registrations     StudentResearchRegistration[]

  @@schema("ql-dao-tao")
}

// Bảng đăng ký đề tài của học viên
model StudentResearchRegistration extends Base {
  student           Student            @relation(fields: [studentId], references: [id])
  studentId         String

  researchProject   ResearchProject    @relation(fields: [researchProjectId], references: [id])
  researchProjectId String
  
  // Thông tin đăng ký
  registeredAt      DateTime           @default(now()) // Thời gian đăng ký
  motivation        String?            @db.Text() // Lý do muốn tham gia
  experience        String?            @db.Text() // Kinh nghiệm liên quan
  
  // Trạng thái
  status            RegistrationStatus @default(PENDING)
  
  // Phê duyệt
  reviewedAt        DateTime?                 // Thời gian phê duyệt
  reviewedBy        Lecturer?          @relation(fields: [reviewedById], references: [id])
  reviewedById      String?
  reviewNote        String?            @db.Text() // Ghi chú của giáo viên

  @@unique([studentId, researchProjectId])
  @@schema("ql-dao-tao")
}