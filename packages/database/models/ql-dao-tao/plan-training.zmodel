import '../base'
import '../ql-danh-muc/edu'
import '../ql-danh-muc/common'
import '../ql-nguoi-dung/profile'

// năm học
model SchoolYear extends Base {
  name      String
  startDate DateTime
  endDate   DateTime?
  semesters Semester[]
  milestone Milestone[]
  @@schema("ql-dao-tao")
}

// kỳ học
model Semester extends Base {
  name         String
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id])
  schoolYearId String
  startDate    DateTime
  endDate      DateTime?
  @@schema("ql-dao-tao")
}

// Mốc huấn luyện
model Milestone extends Base {
  name         String
  period       String? // Thời gian thực hiện
  startDate    DateTime
  endDate      DateTime
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id])
  schoolYearId String
  @@schema("ql-dao-tao")
}

enum TrainingCourseStatus {
  ACTIVE // Đang hoạt động
  COMPLETED // Hoàn thành
  SUSPEND // Tạm dừng
  CANCEL // Hủy bỏ
  @@schema("ql-dao-tao")
}

// Khóa học
model TrainingCourse extends Base {
  name                 String
  startDate            DateTime
  endDate              DateTime?
  trainingObjectType   TrainingObjectType   @relation(fields: [trainingObjectTypeId], references: [id]) // Đối tượng đào tạo
  trainingObjectTypeId String
  trainingType         TrainingType         @relation(fields: [trainingTypeId], references: [id]) // Loại hình đào tạo
  trainingTypeId       String
  trainingLevel        TrainingLevel        @relation(fields: [trainingLevelId], references: [id]) // Bậc đào tạo
  trainingLevelId      String
  trainingForm         TrainingForm         @relation(fields: [trainingFormId], references: [id]) // Hình thức đào tạo
  trainingFormId       String
  status               TrainingCourseStatus @default(ACTIVE)
  fixedClass           FixedClass[]
  @@schema("ql-dao-tao")
}
// lớp biên chế
model FixedClass extends Base {
  name                     String

  trainingCourse           TrainingCourse?     @relation(fields: [trainingCourseId], references: [id]) // Khóa học
  trainingCourseId         String?

  managementOrganization   Organization?       @relation(fields: [managementOrganizationId], references: [id]) // Đơn vị phụ trách
  managementOrganizationId String?

  classSize                Int                 @default(0) // sĩ số

  fixedClassStudent        FixedClassStudent[]
  @@schema("ql-dao-tao")
}

enum CurriculumStatus {
  ACTIVE
  INACTIVATED
  @@schema("ql-dao-tao")
}

// chương trình giảng dạy
model Curriculum extends Base {
  name                     String
  status                   CurriculumStatus    @default(ACTIVE) //Có thể có endDate nhưng vẫn active do có lớp đang học
  startDate                DateTime
  endDate                  DateTime?
  managementOrganization   Organization        @relation(fields: [managementOrganizationId], references: [id]) // Đơn vị phụ trách
  managementOrganizationId String
  trainingObjectType       TrainingObjectType  @relation(fields: [trainingObjectTypeId], references: [id]) // Đối tượng đào tạo
  trainingObjectTypeId     String
  trainingLevel            TrainingLevel       @relation(fields: [trainingLevelId], references: [id]) // Bậc đào tạo
  trainingLevelId          String
  trainingTime             TrainingTime        @relation(fields: [trainingTimeId], references: [id]) // Thời gian đào tạo
  trainingTimeId           String

  trainingMajor            TrainingMajor       @relation(fields: [trainingMajorId], references: [id]) // Chuyên ngành đào tạo
  trainingMajorId          String

  information              String   //Thông tin
  documentPath             String?  // Đường dẫn tài liệu
  renderPath               String?  // Đường dẫn tài liệu kết xuất

  curriculumVersion        CurriculumVersion[]
  @@schema("ql-dao-tao")
}

// Phiên bản chương trình đào tạo
model CurriculumVersion extends Base {
  name                     String
  status                   CurriculumStatus           @default(ACTIVE) //Có thể có endDate nhưng vẫn active do có lớp đang học
  startDate                DateTime
  endDate                  DateTime?
  curriculum               Curriculum                 @relation(fields: [curriculumId], references: [id]) // Chương trình giảng dạy
  curriculumId             String

  information              String?   //Thông tin
  documentPath             String?  // Đường dẫn tài liệu
  renderPath               String?  // Đường dẫn tài liệu kết xuất

  curriculumVersionSubject CurriculumVersionSubject[]
  @@schema("ql-dao-tao")
}


// nhóm môn học
model SubjectGroup extends Base {
  name                     String

  managementOrganization   Organization @relation(fields: [managementOrganizationId], references: [id]) // Đơn vị phụ trách
  managementOrganizationId String
  information              String?   //Thông tin

  subject                  Subject[]
  @@schema("ql-dao-tao")
}

enum SubjectEquivalentType { // loại môn học tương đương
  NONE // không tương đương
  OneByOne // tương đương 1-1
  TwoByOne // hai môn tương đương 1
  ThreeByOne // ba môn tương đương 1
  FourByOne // bốn môn tương đương 1
  OneByTwo // một môn tương đương hai
  OneByThree // một môn tương đương ba
  @@schema("ql-dao-tao")
}

// môn học
model Subject extends Base {
  name                     String
  subjectEquivalentType    SubjectEquivalentType      @default(NONE) // loại môn học tương đương
  credit                   Int                        @default(0)   // số tín chỉ
  period                   Int                        @default(0)  // số tiết học
  numberOfTheory           Int                        @default(0)   // số tiết lý thuyết
  numberOfPractice         Int                        @default(0)   // số tiết thực hành
  numberOfSelfStudy        Int                        @default(0)   // số tiết tự học
  numberOfProject          Int                        @default(0) // số tiết đồ án
  numberOfInternship       Int                        @default(0)   // số tiết thực tập
  numberOfOther            Int                        @default(0)    // số tiết khác

  managementOrganization   Organization               @relation(fields: [managementOrganizationId], references: [id]) // Đơn vị phụ trách
  managementOrganizationId String

  subjectGroup             SubjectGroup               @relation(fields: [subjectGroupId], references: [id])
  subjectGroupId           String

  curriculumVersionSubject CurriculumVersionSubject[]
  @@schema("ql-dao-tao")

  prerequisiteSubject      PrerequisiteSubject[]
  coRequisiteSubject       CoRequisiteSubject[]

  subjectClass             SubjectClass[]
}

enum CurriculumVersionSubjectType { // loại môn học
  None // không xác định
  Mandatory // bắt buộc
  Optional // tự chọn
  Elective // tự chọn tự do
  @@schema("ql-dao-tao")
}

// môn học chương trình
model CurriculumVersionSubject extends Base {
  curriculumVersion   CurriculumVersion            @relation(fields: [curriculumVersionId], references: [id]) // Chương trình giảng dạy
  curriculumVersionId String

  subject             Subject                      @relation(fields: [subjectId], references: [id])
  subjectId           String

  trainingBlock       TrainingBlock?               @relation(fields: [trainingBlockId], references: [id]) // Khối kiến thức
  trainingBlockId     String?

  type                CurriculumVersionSubjectType @default(None) // loại môn học
  information         String?   //Thông tin
  documentPath        String?  // Đường dẫn tài liệu
  renderPath          String?  // Đường dẫn tài liệu kết xuất
  @@schema("ql-dao-tao")

  coRequisiteSubject  CoRequisiteSubject[]

  prerequisiteSubject PrerequisiteSubject[]
}

// Môn học tiên quyết
model PrerequisiteSubject extends Base {
  curriculumVersionSubject   CurriculumVersionSubject @relation(fields: [curriculumVersionSubjectId], references: [id]) // Môn học chương trình
  curriculumVersionSubjectId String

  subject                    Subject                  @relation(fields: [subjectId], references: [id]) // Môn học
  subjectId                  String

  @@schema("ql-dao-tao")
}

// Môn học song hành
model CoRequisiteSubject extends Base {
  curriculumVersionSubject   CurriculumVersionSubject @relation(fields: [curriculumVersionSubjectId], references: [id]) // Môn học chương trình
  curriculumVersionSubjectId String

  subject                    Subject                  @relation(fields: [subjectId], references: [id]) // Môn học
  subjectId                  String

  @@schema("ql-dao-tao")
}

// Lớp môn học
model SubjectClass extends Base {
  name                String
  startDate           DateTime
  endDate             DateTime?
  subject             Subject               @relation(fields: [subjectId], references: [id])
  subjectId           String

  examDate            DateTime?
  @@schema("ql-dao-tao")

  subjectClassStudent SubjectClassStudent[]
}

