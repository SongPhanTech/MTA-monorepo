import '../base'
import './note'
import './categories'
import '../ql-danh-muc/common'
import '../ql-danh-muc/document'
import '../ql-danh-muc/core-categories'
import '../ql-ho-so/profile'
import './student'
import './lecturer'
import './staff'
import 'training-score'
import 'scholarship'
import 'warning'
import 'training-action'
import 'score-link'
import 'ranking'
import 'thesis'
import '../ql-danh-muc/notification'
import '../ql-dao-tao/thesis'
import '../ql-dao-tao/research'
import '../ql-dao-tao/output-standard'
import '../khao-thi/exam'
import "../khao-thi/survey"
import "../khao-thi/evaluate"

/// Kế hoạch đào tạo
model PlanTraining extends BaseNoCode {
  trainingObjectType   TrainingObjectType    @relation(fields: [trainingObjectTypeId], references: [id])
  trainingObjectTypeId String
  semester             Semester              @relation(fields: [semesterId], references: [id])
  semesterId           String

  trainingCourseId     String? // Khoá học
  trainingCourse       TrainingCourse?       @relation(fields: [trainingCourseId], references: [id])

  planTrainingSubjects PlanTrainingSubject[]
  @@unique([trainingObjectTypeId, semesterId, trainingCourseId])
  @@schema("ql-dao-tao")
}

/// Kế hoạch huấn luyện
model PlanTrainingPractice extends BaseNoCode {
  trainingObjectType   TrainingObjectType @relation(fields: [trainingObjectTypeId], references: [id])
  trainingObjectTypeId String
  semester             Semester           @relation(fields: [semesterId], references: [id])
  semesterId           String

  trainingCourseId     String? // Khoá học
  trainingCourse       TrainingCourse?    @relation(fields: [trainingCourseId], references: [id])

  name                 String

  isDayOff             Boolean            @default(false)

  startDate            DateTime
  endDate              DateTime?

  @@schema("ql-dao-tao")
}

model PlanTrainingSubject extends BaseNoCode {
  planTraining           PlanTraining          @relation(fields: [planTrainingId], references: [id])
  planTrainingId         String

  trainingBlockSubjectId String?
  trainingBlockSubject   TrainingBlockSubject? @relation(fields: [trainingBlockSubjectId], references: [id])

  studentCount           Int                   @default(0) // Số SV đăng ký học phần này trong kỳ
  subjectClassType       SubjectClassType      @default(NORMAL)
  fixedClass             FixedClass[]

  @@schema("ql-dao-tao")
}



model StudentScoreConvert extends Base {
  student             Student               @relation(fields: [studentId], references: [id])
  studentId           String

  documentFiles       DocumentFile[]
  subjectScoreConvert SubjectScoreConvert[]

  @@schema("ql-dao-tao")
}

enum ScoreConvertStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("ql-dao-tao")
}

model SubjectScoreConvert extends Base {
  studentScoreConvert   StudentScoreConvert @relation(fields: [studentScoreConvertId], references: [id])
  studentScoreConvertId String

  subjectVersion        SubjectVersion      @relation(fields: [subjectVersionId], references: [id])
  subjectVersionId      String

  // APPROVED => create(Many) StudentSubjectScore from SubjectScoreConvert => StudentSubjectScore.manualScore = SubjectScoreConvert.score
  // khi APPROVED thì không cho sửa
  status                ScoreConvertStatus  @default(PENDING)

  score                 Float

  @@schema("ql-dao-tao")
}

/// Điểm môn học SV - lớp môn học
// Phòng đào tạo có thể trực tiếp tạo Điểm môn học SV - khi HV/SV chuyển trường, đổi điểm chứng chỉ
// Lấy bản ghi có finalScore cao nhất làm kết quả cuối cùng
model StudentSubjectScore extends Base {
  subjectClass                 SubjectClass?                              @relation(fields: [subjectClassId], references: [id])
  subjectClassId               String?

  subjectVersion               SubjectVersion                             @relation(fields: [subjectVersionId], references: [id])
  subjectVersionId             String

  student                      Student                                    @relation(fields: [studentId], references: [id])
  studentId                    String

  semester                     Semester?                                  @relation(fields: [semesterId], references: [id])
  semesterId                   String?

  /// điểm thường xuyên
  attendanceScore              Float?                                     @gte(0, 'Điểm tối thiểu là 0') @lte(10, 'Điểm tối đa là 10')
  /// điểm định kỳ
  midtermScore                 Float?                                     @gte(0, 'Điểm tối thiểu là 0') @lte(10, 'Điểm tối đa là 10')
  /// điểm thi
  examScore                    Float?                                     @gte(0, 'Điểm tối thiểu là 0') @lte(10, 'Điểm tối đa là 10')

  // dùng hàm `calcFinalScore` từ @workspace/libs/utils
  // cần cập nhật khi: thay đổi điểm CC | TX | thi | điểm cộng
  // examScore < 4 => liệt
  // computedFinalScore = if examScore < 4 ? examScore : Math.max((attendanceScore*hs1 + midtermScore*hs2 + examScore*hs3) + bonusScore, 10)
  // maxCertFinalScore = Math.max(.certificates.archivedCertificate.finalScore)
  // bonusScore = sum(.awards.archivedAward.bonusScore)
  // finalScore = Math.max(computedFinalScore, maxCertFinalScore) + bonusScore
  /// điểm tổng kết
  finalScore                   Decimal?                                   @db.Decimal(5, 1) @gte(0, 'Điểm tối thiểu là 0') @lte(10, 'Điểm tối đa là 10')
  // TODO?: phòng đào tạo có thể tạo và nhập trực tiếp manualFinalScore khi SV chuyển trường khác (phiên điểm từ chứng chỉ !?)
  /// điểm tổng kết chuyển trường
  manualFinalScore             Float?                                     @gte(0, 'Điểm tối thiểu là 0') @lte(10, 'Điểm tối đa là 10')

  // Điểm I là điểm sử dụng trong trường hợp học viên không thể dự thi kết thúc học phần do bị ốm,
  // gặp tai nạn hoặc vì những lý do khách quan khác (Điều 26).
  examPostponed                Boolean                                    @default(false) // hoãn thi
  examPostponedReason          String?

  // Điểm R là điểm áp dụng cho học phần mà học viên được phép miễn học và
  // bảo lưu kết quả khi học viên chuyển từ trường khác đến hoặc chuyển đổi giữa các CTĐT.
  exempted                     Boolean                                    @default(false) // được miễn học

  // Điểm W được sử dụng để ghi chú cho học phần mà học viên
  // đã làm đơn xin rút khỏi danh sách đăng ký đúng hạn và được chấp nhận.
  withdrew                     Boolean                                    @default(false) // rút khỏi

  // Điểm X được sử dụng đối với những học phần
  // mà Phòng Đào tạo chưa nhận được kết quả học tập của học viên.
  // ~ if finalScore === null

  /// cấm thi
  examBanned                   Boolean                                    @default(false)
  examBannedReason             String?
  /// đình chỉ
  suspended                    Boolean                                    @default(false)
  suspendedReason              String?
  /// lưu ban
  repeated                     Boolean                                    @default(false)
  repeatedReason               String?

  isImproving                  Boolean                                    @default(false) // học cải thiện

  /// thí sinh trong kì thi
  examPaper                    ExamPaper?
  /// chuyên đề nghiên cứu
  studentResearchTopic         StudentResearchTopic?
  /// thực tập
  studentInternship            StudentInternship?

  graduationGpaScores          StudentGraduationApplication[]             @relation("gpaScore")
  graduationSupplementaryScore StudentGraduationApplication[]             @relation("supplementaryScore")

  certificates                 ArchivedCertificateOnStudentSubjectScore[]
  awards                       ArchivedAwardOnStudentSubjectScore[]
  studentThesisRegistration    StudentThesisRegistration[]                @relation("ScoreToRegistration")
  studentSubjectScoreHistory   StudentSubjectScoreHistory[]
  scoreCorrectionItem          ScoreCorrectionItem[]

  @@index([subjectClassId])
  @@index([subjectVersionId])

  @@unique([subjectClassId, studentId])
  @@schema("ql-dao-tao")
}

model StudentSubjectScoreHistory extends Base {
  studentSubjectScore   StudentSubjectScore @relation(fields: [studentSubjectScoreId], references: [id])
  studentSubjectScoreId String
  /// điểm thường xuyên
  attendanceScore       Float?              @gte(0, 'Điểm tối thiểu là 0') @lte(10, 'Điểm tối đa là 10')
  /// điểm giữa kỳ
  midtermScore          Float?              @gte(0, 'Điểm tối thiểu là 0') @lte(10, 'Điểm tối đa là 10')
  /// điểm cuối kỳ
  examScore             Float?              @gte(0, 'Điểm tối thiểu là 0') @lte(10, 'Điểm tối đa là 10')
  /// điểm tổng kết
  finalScore            Decimal?            @db.Decimal(5, 1) @gte(0, 'Điểm tối thiểu là 0') @lte(10, 'Điểm tối đa là 10')
  /// điểm tổng kết chuyển trường
  manualFinalScore      Float?              @gte(0, 'Điểm tối thiểu là 0') @lte(10, 'Điểm tối đa là 10')

  /// hoãn thi
  examPostponed         Boolean?
  examPostponedReason   String?

  /// cấm thi
  examBanned            Boolean?
  examBannedReason      String?

  /// đình chỉ
  suspended             Boolean?
  suspendedReason       String?

  updatedBy             UserProfile?        @relation(fields: [updatedById], references: [id])
  updatedById           String?             @db.Uuid

  @@schema("ql-dao-tao")
}

/// chuyên đề nghiên cứu
model StudentResearchTopic extends Base {
  studentSubjectScore   StudentSubjectScore @relation(fields: [studentSubjectScoreId], references: [id])
  studentSubjectScoreId String              @unique

  /// hạn nhập chuyên đề
  deadline              DateTime?
  /// tên chuyên đề
  name                  String?
  /// nội dung chính
  mainContent           String?

  /// GVHD 1
  supervisor            ExpertProfileVersion? @relation("SupervisorToResearchTopic", fields: [supervisorVersionId], references: [id])
  supervisorVersionId   String?

  /// GVHD 2
  coSupervisor          ExpertProfileVersion? @relation("CoSupervisorToResearchTopic", fields: [coSupervisorVersionId], references: [id])
  coSupervisorVersionId String?

  /// GVHD 3
  thirdSupervisor       ExpertProfileVersion? @relation("ThirdSupervisorToResearchTopic", fields: [thirdSupervisorVersionId], references: [id])
  thirdSupervisorVersionId String?

  /// ngày báo cáo
  reportDate            DateTime?

  @@schema("ql-dao-tao")
}

model StudentInternship extends Base {
  studentSubjectScore   StudentSubjectScore @relation(fields: [studentSubjectScoreId], references: [id])
  studentSubjectScoreId String              @unique

  /// hạn nhập thực tập
  deadline              DateTime?
  /// nội dung thực tập
  internshipContent     String?
  /// cơ quan thực tập
  institution           String?
  /// đơn vị thực tập
  unit                  String?
  /// địa chỉ thực tập
  address               String?
  /// GVHD 1
  supervisor            ExpertProfileVersion? @relation("SupervisorToInternship", fields: [supervisorVersionId], references: [id])
  supervisorVersionId   String?
  /// GVHD 2
  coSupervisor          ExpertProfileVersion? @relation("CoSupervisorToInternship", fields: [coSupervisorVersionId], references: [id])
  coSupervisorVersionId String?
  /// thời gian bắt đầu thực tập
  startDate             DateTime?
  /// thời gian kết thúc thực tập
  endDate               DateTime?
  /// thời gian báo cáo
  reportDate            DateTime?

  @@schema("ql-dao-tao")
}

model ArchivedCertificateOnStudentSubjectScore extends Base {
  studentSubjectScore   StudentSubjectScore @relation(fields: [studentSubjectScoreId], references: [id])
  studentSubjectScoreId String

  archivedCertificate   ArchivedCertificate @relation(fields: [archivedCertificateId], references: [id])
  archivedCertificateId String

  @@unique([studentSubjectScoreId, archivedCertificateId])
  @@schema("ql-dao-tao")
}

/// Trạng thái khi SV nộp chứng chỉ online
enum ArchivedCertificateStatus {
  PENDING
  CANCEL
  APPROVED
  REJECTED

  @@schema("ql-dao-tao")
}

/// Chứng chỉ của SV
model ArchivedCertificate extends Base {
  certificate         Certificate                                @relation(fields: [certificateId], references: [id])
  certificateId       String

  student             Student                                    @relation(fields: [studentId], references: [id])
  studentId           String

  finalScore          Float                                      @default(0)
  // TODO: dùng `code` cho mã/ID chứng chỉ

  /// điểm nghe
  listeningScore      Float?

  /// điểm nói
  speakingScore       Float?

  /// điểm đọc
  readingScore        Float?

  /// điểm viết
  writingScore        Float?

  /// điểm chứng chỉ
  score               Float?
  /// nơi cấp
  issuedBy            String?
  /// ngày cấp
  issuedDate          DateTime?
  /// ngày hết hạn
  expiredDate         DateTime?
  status              ArchivedCertificateStatus                  @default(PENDING)

  documentFiles       DocumentFile[]
  decisionNumber      String? // Số QĐ công nhận chứng chỉ
  studentSubjectScore ArchivedCertificateOnStudentSubjectScore[]
  /// môn + điểm phiên chọn theo SV (trước phê duyệt)
  subjectScores       ArchivedCertificateSubjectScore[]
  @@schema("ql-dao-tao")
}

/// Điểm phiên từng môn của chứng chỉ SV
model ArchivedCertificateSubjectScore extends Base {
  /// điểm phiên môn học
  finalScore            Float               @gte(0, 'Điểm tối thiểu là 0') @lte(10, 'Điểm tối đa là 10')

  archivedCertificate   ArchivedCertificate @relation(fields: [archivedCertificateId], references: [id])
  archivedCertificateId String

  subjectVersion        SubjectVersion      @relation(fields: [subjectVersionId], references: [id])
  subjectVersionId      String

  @@unique([archivedCertificateId, subjectVersionId])
  @@schema("ql-dao-tao")
}

model ArchivedAwardOnStudentSubjectScore extends Base {
  studentSubjectScore   StudentSubjectScore       @relation(fields: [studentSubjectScoreId], references: [id])
  studentSubjectScoreId String

  archivedAward         ArchivedAward             @relation(fields: [archivedAwardId], references: [id])
  archivedAwardId       String

  status                ArchivedCertificateStatus @default(PENDING)

  @@unique([studentSubjectScoreId, archivedAwardId])
  @@schema("ql-dao-tao")
}

/// Giải thưởng của SV
model ArchivedAward extends Base {
  award               Award                                @relation(fields: [awardId], references: [id])
  awardId             String

  student             Student                              @relation(fields: [studentId], references: [id])
  studentId           String

  bonusScore          Float

  /// ngày nhận
  date                DateTime?

  status              ArchivedCertificateStatus            @default(PENDING)

  /// minh chứng
  documentFiles       DocumentFile[]

  studentSubjectScore ArchivedAwardOnStudentSubjectScore[]
  @@schema("ql-dao-tao")
}

/// Năm học
// Giao diện tạo năm học có ô stt tự động tăng (useCount), người dùng chọn năm học bắt đầu và kết thúc => SchoolYear
model SchoolYear extends Base {
  name                    String
  startDate               DateTime
  endDate                 DateTime?
  semesters               Semester[]
  milestone               Milestone[]

  studentYearResult       StudentYearResult[]
  studentAcademicDecision StudentAcademicDecision[]
  evaluationPeriod        EvaluationPeriod[]
  schoolYearTrainingScore SchoolYearTrainingScore[]
  guestTeachingRateConfig GuestTeachingRateConfig[]

  @@schema("ql-dao-tao")
}

enum SemesterType {
  FIRST // Học kỳ 1
  FIRST_SUPPLEMENTARY // HK phụ HK1
  SECOND // Học kỳ 2
  SECOND_SUPPLEMENTARY // HK phụ HK2
  SUMMER // Học kỳ hè
  @@schema("ql-dao-tao")
}

/// Kỳ học
// Giao diện tạo kỳ học có ô stt tự động tăng (useCount), người dùng chọn kỳ học là kỳ 1 hay kỳ 2 => HK chính => SemesterType
model Semester extends Base {
  name                    String
  shortName               String? // tên ngắn gọn
  semesterType            SemesterType?
  schoolYear              SchoolYear                @relation(fields: [schoolYearId], references: [id])
  schoolYearId            String
  startDate               DateTime
  endDate                 DateTime

  subjectClasses          SubjectClass[]
  trainingCoursesStart    TrainingCourse[]
  trainingScoreSession    TrainingScoreSession[]
  studentSemesterResult   StudentSemesterResult[]
  scholarshipAward        ScholarshipAward[]
  academicWarning         AcademicWarning[]
  disciplinaryWarning     DisciplinaryWarning[]
  studentAcademicDecision StudentAcademicDecision[]
  classRegisterSession    ClassRegisterSession[]
  planTraining            PlanTraining[]
  survey                  Survey[]
  exam                    Exam[]
  scoreLinkSheets         ScoreLinkSheet[]
  semesterTrainingScore   SemesterTrainingScore[]
  availableTrainingTime   AvailableTrainingTime[]
  studentSubjectScore     StudentSubjectScore[]
  planTrainingPractice    PlanTrainingPractice[]
  guestTeachingPayments   GuestTeachingPayment[]

  @@schema("ql-dao-tao")
}

/// Mốc huấn luyện
model Milestone extends Base {
  name         String
  startPeriod  Int?    // Tiết bắt đầu
  period       String? // Số tiết
  startDate    DateTime
  endDate      DateTime
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id])
  schoolYearId String
  @@schema("ql-dao-tao")
}

model TrainingLanguage extends Base {
  name              String

  trainingCourses   TrainingCourse[]
  curriculumVersion CurriculumVersion[]

  @@schema("ql-dao-tao")
}

/// Khoá học
model TrainingCourse extends Base {
  name                       String
  semesterStart              Semester                   @relation(fields: [semesterStartId], references: [id]) // Kỳ học bắt đầu
  semesterStartId            String
  startYear                  Int?
  endYear                    Int?
  academicYear               String?
  maxTrainingTime            Float?

  // Khoá này có được thi lại không
  isRetakeExam               Boolean                    @default(false)

  /// Chỉ tiêu tuyển sinh
  admissionQuota             Int?
  /// Số lượng trúng tuyển
  admittedStudent            Int?
  /// Số lượng nhập học
  enrolledStudent            Int?
  /// Ngày nhập học
  admissionStartDate         DateTime?
  /// Ngày kết thúc
  admissionEndDate           DateTime?
  /// Số QĐ tuyển sinh
  admissionDecision          String?
  /// Số QĐ công nhận SV
  studentRecognitionDecision String?
  /// Số quy chế đào tạo
  regulation                 String?
  // Số QĐ trúng tuyển
  admissionDecisionNumber    String?

  trainingLanguage           TrainingLanguage?          @relation(fields: [trainingLanguageId], references: [id])
  trainingLanguageId         String?
  /// khoá sửa tham số của "Thông tin chung"
  isGeneralInfoLocked        Boolean                    @default(false)
  /// khoá sửa tham số của "Quyết định/Quy chế"
  isRegulationLocked         Boolean                    @default(false)
  /// khoá sửa tham số của "Thông tin điểm và Tham số bổ sung"
  isScoreConfigLocked        Boolean                    @default(false)
  baseScore                  AcademicRankingBaseType

  coef_1                     Float                      @default(0.1) // Hệ số 1
  coef_2                     Float                      @default(0.3) // Hệ số 2
  coef_3                     Float                      @default(0.6) // Hệ số 3

  scoreToTakeExam            Float                      @default(5) // Điểm tối thiểu để được thi (điểm liệt)
  examScoreToPass            Float                      @default(5) // Điểm thi tối thiểu
  scoreToPass                Float                      @default(5) // Điểm tối thiểu để qua môn
  scoreToPassConditional     Float                      @default(5) // Điểm tối thiểu để qua môn điều kiện (5 đối với QS, =scoreToPass đối với DS)

  scoreToTakeGraduation      Float                      @default(5) // Điểm liệt môn tốt nghiệp
  scoreToPassGraduation      Float                      @default(5.5) // Điểm tối để qua môn tốt nghiệp

  /// điểm tối đa khi thi lại
  maxReExamScore             Float                      @default(6.9)
  /// trừ điểm khi thi lại
  reduceReExamScore          Float                      @default(1)

  /// điểm giữ lại khi lưu ban
  scoreToRetain              Float                      @default(10.5)

  trainingObjectType         TrainingObjectType         @relation(fields: [trainingObjectTypeId], references: [id]) // Đối tượng đào tạo
  trainingObjectTypeId       String

  trainingCourseRegulation   TrainingCourseRegulation[]
  curriculumVersion          CurriculumVersion[]
  fixedClass                 FixedClass[]
  scoreConverts              ScoreConvert[]
  academicRankingConvert     AcademicRankingConvert[]
  scholarships               Scholarship[]
  academicWarningRule        AcademicWarningRule[]
  academicActionConfig       AcademicActionConfig[]
  notifications              Notification[]  // Thông báo cho khoá
  surveyObjectTypes          SurveyObjectType[]
  classRegisterSession       ClassRegisterSession[]
  documentFiles              DocumentFile[]
  thesisSessions             ThesisSession[]
  planTrainings              PlanTraining[]
  graduationSessions         GraduationSession[]
  planTrainingPractice       PlanTrainingPractice[]

  @@schema("ql-dao-tao")
}

/// Quy chế động của khoá
model TrainingCourseRegulation extends BaseNoCode {
  trainingCourse   TrainingCourse @relation(fields: [trainingCourseId], references: [id])
  trainingCourseId String
  code             String
  name             String
  value            Float
  @@schema("ql-dao-tao")
}
enum FixedClassType {
  APPLICATION // Lớp ứng dụng
  RESEARCH // Lớp nghien cứu
  NORMAL // lớp thường
  @@schema("ql-dao-tao")
}
/// lớp quản lý
model FixedClass extends Base {
  name                     String
  summary                  String?
  startYear                Int?
  graduated                Boolean              @default(false)

  classMonitor             Student?             @relation("ClassMonitor", fields: [classMonitorId], references: [id])
  classMonitorId           String?

  unionLeader              Student?             @relation("UnionLeader", fields: [unionLeaderId], references: [id])
  unionLeaderId            String?

  deputyUnionSecretary     Student?             @relation("DeputyUnionSecretary", fields: [deputyUnionSecretaryId], references: [id])
  deputyUnionSecretaryId   String?

  unionSecretary           Student?             @relation("UnionSecretary", fields: [unionSecretaryId], references: [id])
  unionSecretaryId         String?

  trainingCourse           TrainingCourse       @relation(fields: [trainingCourseId], references: [id]) // Khoá học
  trainingCourseId         String

  managementOrganization   DM_DonVi?            @relation(fields: [managementOrganizationId], references: [Id])
  managementOrganizationId String?              @db.Uuid

  lecturerManagement       Lecturer?            @relation(name: "ManageLecturer", fields: [lecturerManagementId], references: [id])
  lecturerManagementId     String?

  staffManagement          Staff?               @relation(name: "ManageStaff", fields: [staffManagementId], references: [id])
  staffManagementId        String?

  students                 Student[]

  curriculumVersion        CurriculumVersion?   @relation(fields: [curriculumVersionId], references: [id])
  curriculumVersionId      String?              
  classType                FixedClassType       @default(NORMAL)

  subjectClasses           SubjectClass[]
  notifications            Notification[]  // Thông báo cho lớp
  surveyObjectTypes        SurveyObjectType[]

  scoreLinkSheets          ScoreLinkSheet[]
  planTrainingSubject      PlanTrainingSubject? @relation(fields: [planTrainingSubjectId], references: [id])
  planTrainingSubjectId    String?
  @@unique([name, trainingCourseId, curriculumVersionId])

  @@schema("ql-dao-tao")
}

/// chương trình đào tạo
model Curriculum extends BaseNoCode {
  code                     String?
  name                     String
  englishName              String?

  managementOrganization   DM_DonVi            @relation(fields: [managementOrganizationId], references: [Id])
  managementOrganizationId String              @db.Uuid

  trainingMajor            TrainingMajor?      @relation(fields: [trainingMajorId], references: [id]) // Chuyên ngành đào tạo
  trainingMajorId          String?
  trainingField            TrainingField?      @relation(fields: [trainingFieldId], references: [id]) // Chuyên ngành đào tạo
  trainingFieldId          String?

  trainingObjectType       TrainingObjectType  @relation(fields: [trainingObjectTypeId], references: [id]) // Đối tượng đào tạo
  trainingObjectTypeId     String

  information              String?   //Thông tin
  renderPath               String? // Đường dẫn tài liệu kết xuất

  documentFiles            DocumentFile[]
  curriculumVersion        CurriculumVersion[]

  @@schema("ql-dao-tao")
}

enum CurriculumVersionType {
  FRAMEWORK //CTĐT khung
  FULL_COURSE // CTĐT Toàn khoá
  @@schema("ql-dao-tao")
}

/// Phiên bản chương trình đào tạo
model CurriculumVersion extends BaseNoCode {
  code                             String?
  name                             String
  shortName                        String?
  englishName                      String?
  trainingLanguage                 TrainingLanguage?                  @relation(fields: [trainingLanguageId], references: [id])
  trainingLanguageId               String?
  numberOfSemesters                Int? // Số kỳ học
  yearCreation                     Int? // Năm tạo chương trình đào tạo
  yearApplication                  Int? // Năm áp dụng chương trình đào tạo
  isLock                           Boolean                            @default(false) // khoá phiên bản chương trình đào tạo
  curriculum                       Curriculum                         @relation(fields: [curriculumId], references: [id]) // Chương trình giảng dạy
  curriculumId                     String
  type                             CurriculumVersionType              @default(FULL_COURSE) // Loại chương trình đào tạo
  trainingObjectType               TrainingObjectType                 @relation(fields: [trainingObjectTypeId], references: [id]) // Đối tượng đào tạo
  trainingObjectTypeId             String
  trainingCourse                   TrainingCourse?                    @relation(fields: [trainingCourseId], references: [id]) // Khoá học
  trainingCourseId                 String?
  trainingLevel                    TrainingLevel?                     @relation(fields: [trainingLevelId], references: [id]) // Bậc đào tạo
  trainingLevelId                  String?
  trainingType                     TrainingType?                      @relation(fields: [trainingTypeId], references: [id])
  trainingTypeId                   String?
  trainingTime                     TrainingTime?                      @relation(fields: [trainingTimeId], references: [id]) // Thời gian đào tạo
  trainingTimeId                   String?

  diplomaType                      DiplomaType?                       @relation(fields: [diplomaTypeId], references: [id]) // Loại văn bằng
  diplomaTypeId                    String?

  // TODO: Thêm các quy chế cho chương trình đào tạo
  requiredCredits                  Int? // Số tín chỉ bắt buộc
  electiveCredits                  Int? // Số tín chỉ tự chọn

  jobPosition                      String? // I.10 Vị trí công việc
  objectives                       String? // II. Mục tiêu
  learningOutcome                  String? // III. Chuẩn đầu ra
  inputStandard                    String? // IV. Chuẩn đầu vào
  time                             String? // V. Thời gian toàn khoá
  structure                        String? // VI. Cấu trúc chương trình đào tạo
  matrixLearningOutcome            String? // VII. Ma trận chuẩn đầu ra
  summary                          String? // VIII. Mô tả tóm tắt nội dung các học phần
  learningDiagram                  String? // IX. Sơ đồ mối liên hệ, tiến trình đào tạo các học phần và mô hình đào tạo, phân phối kiến thức trong CTĐT
  guide                            String? // X. Hướng dẫn thực hiện
  renderPath                       String? // Đường dẫn tài liệu kết xuất

  outputStandardOnCurriculum       OutputStandardOnCurriculum[]
  documentFiles                    DocumentFile[]
  trainingBlocks                   TrainingBlockOnCurriculumVersion[]
  fixedClasses                       FixedClass[]
  students                         Student[]                          @relation('CurriculumVersion') // Học viên
  studentCurriculumVersionParallel Student[]                          @relation('CurriculumVersionParallel') // Học viên học song song CTĐT

  @@schema("ql-dao-tao")
}

/// môn học
model Subject extends Base {
  name                     String
  englishName              String?

  managementOrganization   DM_DonVi?              @relation(fields: [managementOrganizationId], references: [Id])
  managementOrganizationId String?                @db.Uuid
  information              String?   //Thông tin

  subjectVersion           SubjectVersion[]       @relation(name: "SubjectVersion")
  certificateOnSubject     CertificateOnSubject[]
  awardOnSubject           Award[]

  @@unique([code,name,managementOrganizationId])

  @@schema("ql-dao-tao")
}

/// loại hình thi
// bảo đảm tối thiếu có 02 mã đề thi đối với hình thức thi tự luận
// và gấp 1,5 lần số học viên dự thi đối với hình thức thi vấn đáp, thực hành.
enum ExamType {
  OfflineWritten // thi viết (trắc nghiệm hoặc tự luận, hoặc kết hợp trắc nghiệm và tự luận)
  OnlineWritten // thi viết trực tuyến (trắc nghiệm hoặc tự luận, hoặc kết hợp trắc nghiệm và tự luận)
  // OfflineChoices // thi trắc nghiệm
  // OnlineChoices // thi trắc nghiệm trực tuyến
  Oral // thi vấn đáp
  Practice // thi thực hành
  Project // thi đồ án
  Other // loại khác
  @@schema("ql-dao-tao")
}

/// Nhóm phiên bản môn học
model SubjectVersionCategory extends Base {
  name            String
  subjectVersions SubjectVersion[]
  @@schema("ql-dao-tao")
}

enum SubjectVersionType {
  Normal // Học phần lý thuyết
  Practice // Thí nghiệm/Thực hành
  Internship // Thực tập
  Research // Chuyên đề nghiên cứu
  Project // Đồ án
  Thesis // Luận văn/đề án
  Graduation // Thi tốt nghiệp

  @@schema("ql-dao-tao")
}

/// Phiên bản môn học
model SubjectVersion extends BaseNoCode {
  code                     String
  isLocked                 Boolean                   @default(false)
  name                     String
  codeTkb                  String?
  examType                 ExamType
  /// loại học phần
  type                     SubjectVersionType        @default(Normal)
  /// 1 đầu điểm
  onePoint                 Boolean                   @default(false)
  credit                   Int // số tín chỉ
  week                     Int? // số tuần
  /// số tiết
  period                   Int?
  /// số tiết TKB
  schedulePeriod           Int?
  numberOfTheory           Int? // số tiết lý thuyết
  numberOfPractical        Int? // số tiết bài tập
  numberOfSelfStudy        Int? // số tiết thảo luận/tự học
  numberOfPractice         Int? // số tiết thí nghiệm/thực hành
  numberOfReview           Int? // số tiết ôn tập
  numberOfExam             Int? // số tiết KT/thi
  numberOfOther            Int? // số tiết khác

  // description ~ IV. MÔ TẢ
  objectives               String? // II. Mục tiêu
  learningOutcome          String? // III. Chuẩn đầu ra
  structure                String? // V. Cấu trúc chương trình đào tạo
  guild                    String? // ​VI. Kế hoạch và phương pháp dạy học
  academicResults          String? // ​VII. Đánh giá kết quả học tập
  materials                String? // VIII. Cơ sở vật chất, học liệu
  rules                    String? // ​IX. Quy định của học phần

  managementOrganization   DM_DonVi?                 @relation(fields: [managementOrganizationId], references: [Id])
  managementOrganizationId String?                   @db.Uuid

  subject                  Subject                   @relation(name: "SubjectVersion", fields: [subjectId], references: [id])
  subjectId                String

  trainingObjectType       TrainingObjectType        @relation(fields: [trainingObjectTypeId], references: [id])
  trainingObjectTypeId     String

  subjectVersionCategory   SubjectVersionCategory?   @relation(fields: [subjectVersionCategoryId], references: [id])
  subjectVersionCategoryId String?

  /// môn học khối kiến thức - CTĐT
  trainingBlocks           TrainingBlockSubject[]

  /// môn học tiên quyết
  prerequisiteSubject      SubjectVersion[]          @relation(name: "PrerequisiteSubject")
  dependentSubject         SubjectVersion[]          @relation(name: "PrerequisiteSubject")

  // môn học học trước
  coRequisiteSubject       SubjectVersion[]          @relation(name: "CoRequisiteSubject")
  depCoRequisiteSubject    SubjectVersion[]          @relation(name: "CoRequisiteSubject")

  // Nhóm môn tương đương
  equivalencyGroups        SubjectInGroup[]

  knowledgeBlocks          KnowledgeBlock[]
  subjectClass             SubjectClass[]
  studentSubjectScore      StudentSubjectScore[]
  documentFiles            DocumentFile[]
  questionBanks            QuestionBank[]
  subjectScoreConvert      SubjectScoreConvert[]
  subjectVersionHistory    SubjectVersionHistory[]
  exams                    Exam[]
  examFramework            ExamFramework[]
  scoreLinkSubjectVersion          ScoreLinkSubjectVersion[]
  certificate                      Certificate[]
  archivedCertificateSubjectScores ArchivedCertificateSubjectScore[]

  // @@unique([trainingObjectTypeId, name, credit, period, managementOrganizationId])
  // @@unique([trainingObjectTypeId, codeTkb])
  @@index([name, trainingObjectTypeId])
  @@index([subjectId])
  @@schema("ql-dao-tao")
}

model SubjectVersionHistory extends Base {
  subjectVersion   SubjectVersion @relation(fields: [subjectVersionId], references: [id])
  subjectVersionId String

  content          String
  action           String

  updatedBy        UserProfile    @relation(fields: [updatedById], references: [id])
  updatedById      String         @db.Uuid

  @@schema("ql-dao-tao")
}

/// Đại diện cho MỘT quy tắc tương đương, ví dụ: (A + B) <=> (C)
model EquivalencyGroup extends Base {
  subjects SubjectInGroup[]

  @@schema("ql-dao-tao")
}

/// Bảng liên kết giữa Môn học và Nhóm tương đương
model SubjectInGroup extends Base {
  subject            SubjectVersion   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId          String
  equivalencyGroup   EquivalencyGroup @relation(fields: [equivalencyGroupId], references: [id], onDelete: Cascade)
  equivalencyGroupId String

  /// Xác định môn học này nằm ở vế nào của quy tắc tương đương
  /// SOURCE: Vế nguồn (bên trái)
  /// TARGET: Vế đích (bên phải)
  side               EquivalencySide

  @@unique([subjectId, equivalencyGroupId])
  @@schema("ql-dao-tao")
}

/// Enum để định nghĩa các vế của một quy tắc
enum EquivalencySide {
  SOURCE
  TARGET

  @@schema("ql-dao-tao")
}

/// loại bắt buộc
enum SubjectRequirementType {
  Mandatory // bắt buộc
  Optional // tự chọn
  @@schema("ql-dao-tao")
}

/// môn học khối kiến thức chương trình
model TrainingBlockSubject extends Base {
  subject                            SubjectVersion                   @relation(fields: [subjectId], references: [id])
  subjectId                          String

  trainingBlockOnCurriculumVersion   TrainingBlockOnCurriculumVersion @relation(fields: [trainingBlockOnCurriculumVersionId], references: [id])
  trainingBlockOnCurriculumVersionId String

  semester                           Int? // kỳ học

  type                               SubjectRequirementType           @default(Mandatory) // loại bắt buộc
  /// tính điểm thi cuối ~ !môn điều kiện ~ in trên bảng điểm
  useForFinalScore                   Boolean
  /// môn tốt nghiệp (dùng trong bảng tốt nghiệp, điểm đạt tốt nghiệp)
  graduation                         Boolean

  planTrainingSubjects               PlanTrainingSubject[]

  // @@unique([subjectId, trainingBlockOnCurriculumVersionId])

  @@schema("ql-dao-tao")
}

// Giới hạn tín chỉ đăng ký
model ClassRegisterSessionCredit extends Base {
  classRegisterSession   ClassRegisterSession    @relation(fields: [classRegisterSessionId], references: [id])
  classRegisterSessionId String
  minCredit              Int                     @default(0) // tối thiểu số tín chỉ phải đăng ký
  maxCredit              Int                     @default(25)        // tối đa số tín chỉ được đăng ký
  baseScore              AcademicRankingBaseType @default(Base10) // loại điểm làm cơ sở tính toán
  base10Min              Float?
  base10Max              Float?
  base4Min               Float?
  base4Max               Float?
  @@schema("ql-dao-tao")
}

model ClassRegisterSession extends Base {
  name              String
  startDate         DateTime
  endDate           DateTime
  semester          Semester                     @relation(fields: [semesterId], references: [id])
  semesterId        String
  /// học phí/tín chỉ
  tuitionPerCredit  Float                        @default(0)

  creditLimit       ClassRegisterSessionCredit[] // giới hạn tín chỉ
  trainingCourses   TrainingCourse[]
  classRegisterLogs ClassRegisterLogs[]
  classRegisterAttempts ClassRegisterAttempt[]
  dataSyncHistories DataSyncHistory[]
  @@schema("ql-dao-tao")
}

enum ClassRegisterStatus {
  PENDING
  CANCELLED
  SUCCESS
  FAILED

  @@schema("ql-dao-tao")
}

model ClassRegisterLogs extends Base {
  classRegisterSession   ClassRegisterSession @relation(fields: [classRegisterSessionId], references: [id])
  classRegisterSessionId String
  subjectClass           SubjectClass         @relation(fields: [subjectClassId], references: [id])
  subjectClassId         String
  student                Student              @relation(fields: [studentId], references: [id])
  studentId              String
  status                 ClassRegisterStatus  @default(PENDING)
  reason                 String?

  @@unique([classRegisterSessionId, studentId, subjectClassId])
  @@index([subjectClassId])
  @@index([studentId])
  @@schema("ql-dao-tao")
}

/// Lưu lần đăng ký thất bại (từ Kafka events / sync fallback) phục vụ thống kê
enum ClassRegisterAttemptStatus {
  FAILED

  @@schema("ql-dao-tao")
}

model ClassRegisterAttempt extends Base {
  classRegisterSession   ClassRegisterSession         @relation(fields: [classRegisterSessionId], references: [id])
  classRegisterSessionId String
  student                Student?                     @relation(fields: [studentId], references: [id])
  studentId              String?
  userProfileId          String                       @db.Uuid
  jobId                  String?                      @unique
  status                 ClassRegisterAttemptStatus   @default(FAILED)
  /// Mã lỗi nghiệp vụ (CLASS_FULL, MISSING_PREREQUISITE, ...)
  errorCode              String?
  message                String                       @db.Text
  subjectClassIds        String[]
  occurredAt             DateTime
  attempts               Int                          @default(0)

  @@index([classRegisterSessionId, occurredAt])
  @@index([studentId])
  @@index([userProfileId])
  @@schema("ql-dao-tao")
}

enum SubjectClassSchedule {
  MORNING
  AFTERNOON
  EVENING

  @@schema("ql-dao-tao")
}

// Trạng thái điểm danh sinh viên
enum AttendanceStatus {
  PRESENT          // Có mặt
  EXCUSED_ABSENT   // Vắng có phép
  UNEXCUSED_ABSENT // Vắng không phép

  @@schema("ql-dao-tao")
}

// Enum cho loại tiết học
enum PeriodType {
  THEORY      // Lý thuyết
  PRACTICE    // Thực hành
  LAB         // Thí nghiệm
  SEMINAR     // Seminar
  EXAM        // Thi/kiểm tra
  MAKEUP      // Học bù
  REVIEW      // Ôn tập
  CHECK       // Kiểm tra giảng dạy
  WEEK        // Lịch tuần/tháng học viện

  @@schema("ql-dao-tao")
}

enum SubjectClassType {
  NORMAL // Lớp thường
  LINKED // Lớp liên kết
  REEXAM // Thi lại
  RETAKE // Học lại
  STAYBACK // Lớp lưu ban
  TRANSFER // Lớp chuyển trường
  @@schema("ql-dao-tao")
}

enum SubjectClassStatus {
  DRAFT // Nháp
  OFFICIAL // Chính thức
  @@schema("ql-dao-tao")
}

/// Lớp môn học
model SubjectClass extends BaseNoCode {
  code                        String
  name                        String
  startDate                   DateTime?
  endDate                     DateTime?
  subject                     SubjectVersion           @relation(fields: [subjectId], references: [id])
  subjectId                   String
  schedule                    SubjectClassSchedule?
  maxStudent                  Int // Số SV tối đa
  /// Sĩ số đã đăng ký (denormalized) — cập nhật atomic khi đăng ký/hủy đăng ký
  enrolledCount               Int                      @default(0)
  /// Optimistic-locking version — tăng mỗi lần cập nhật sĩ số, dùng chống race condition
  version                     Int                      @default(0)
  type                        SubjectClassType         @default(NORMAL)
  status                      SubjectClassStatus       @default(DRAFT)
  // Đối tượng đào tạo
  trainingObjectType          TrainingObjectType       @relation(fields: [trainingObjectTypeId], references: [id])
  trainingObjectTypeId        String

  semester                    Semester                 @relation(fields: [semesterId], references: [id])
  semesterId                  String

  cancelled                   Boolean                  @default(false) // đã hủy lớp

  lecturerAssignmentDeadline  DateTime? // hạn phân công giảng dạy
  sendLecturerAssignmentAt    DateTime? // ngày gửi phân công giảng dạy
  submitLecturerAssignmentAt  DateTime? // ngày nộp phân công giảng dạy
  approveLecturerAssignmentAt DateTime? // ngày phê duyệt phân công giảng dạy
  examDate                    DateTime? // ngày thi

  // hình thức thi copy từ phiên bản môn học; hình thức thi của lớp có thể thay đổi giữa kỳ học
  examType                    ExamType

  exam                        Exam?                    @relation(fields: [examId], references: [id])
  examId                      String?

  /// ngày bắt đầu nhập điểm TX/ĐK
  scoreDeadLineStart          DateTime? // default 20 ngày trước ngày thi
  /// ngày kết thúc nhập điểm TX/ĐK
  scoreDeadline               DateTime? // default 10 ngày trước ngày thi
  /// hạn nhập điểm thi
  examScoreDeadline           DateTime? // : default 10 ngày sau ngày thi

  enteredScore                Boolean                  @default(false)
  enteredExamScore            Boolean                  @default(false)

  // khi xuất phiếu điểm cuối cùng
  issuedScoreAt               DateTime? // ngày xuất phiếu điểm

  // khoá khi xuất phiếu điểm, lên DS thi. (P2/P7 có thể mở khoá)
  /// khoá điểm TX/ĐK
  isLockScore                 Boolean                  @default(false)
  // khoá khi xuất phiếu điểm. (P13 có thể mở khoá)
  /// khoá điểm thi
  isLockExamScore             Boolean                  @default(false)
  // khoá phân công giảng viên
  isLockLecturer              Boolean                  @default(true)

  // P13 kiểm tra phiếu điểm và gửi
  scoreSubmitted              Boolean                  @default(false)

  // P2/P7 kiểm tra lại phiếu điểm và dữ liệu phần mềm
  scoreChecked                Boolean                  @default(false)

  room                        Room?                    @relation(name: "ClassRoom", fields: [roomId], references: [id])
  roomId                      String?

  trainingLocation            TrainingLocation?        @relation(name: "ClassTrainingLocation", fields: [trainingLocationId], references: [id])
  trainingLocationId          String?

  mainLecturer                Lecturer?                @relation(name: "MainLecturer", fields: [lecturerId], references: [id])
  lecturerId                  String?

  extraLecturer               Lecturer?                @relation(name: "ExtraLecturer", fields: [extraLecturerId], references: [id])
  extraLecturerId             String?

  enterGradeLecturer          Lecturer?                @relation(name: "EnterGradeLecturer", fields: [enterGradeLecturerId], references: [id])
  enterGradeLecturerId        String?

  scoreLinkSubjectVersion     ScoreLinkSubjectVersion? @relation(fields: [scoreLinkSubjectVersionId], references: [id])
  scoreLinkSubjectVersionId   String?                  @unique

  subjectClassStudent         StudentSubjectScore[]
  fixedClasses                FixedClass[]
  classSchedules              ClassSchedule[]        // Thêm relation với thời khoá biểu
  studentPersonalEvents       StudentPersonalEvent[]

  // Môn đồ án
  thesisProjects              ThesisProject[] // DS đồ án
  expert                      Expert[] // DS chuyên gia hướng dẫn -> tạo hội đồng tự động
  defenseRooms                Room[]                   @relation("DefenseRooms") // DS phòng -> chọn phòng tự động

  surveyObjectTypes           SurveyObjectType[]
  classRegisterLogs           ClassRegisterLogs[]
  subjectClassTimes           SubjectClassTime[]  // Thứ trong tuần và tiết học
  survey                      Survey[] // Đợt khảo sát cho giảng viên

  subjectClassHistory         SubjectClassHistory[]
  examBank                    ExamBank[]
  subjectClassAttendances     SubjectClassAttendance[]

  @@index([lecturerId])
  @@index([extraLecturerId])
  @@index([enterGradeLecturerId])
  @@index([subjectId])
  @@schema("ql-dao-tao")
}

// Điểm danh
model SubjectClassAttendance extends Base {
  time                          DateTime
  subjectClass                  SubjectClass                    @relation(fields: [subjectClassId], references: [id])
  subjectClassId                String
  // Người điểm danh
  profile                       UserProfile?                    @relation(fields: [profileId], references: [id])
  profileId                     String?                         @db.Uuid
  // Buổi học cụ thể (lấy tiết học, phòng học, ngày học từ đây)
  classSchedule                 ClassSchedule?                  @relation(fields: [classScheduleId], references: [id])
  classScheduleId               String?
  // Ghi chú buổi học
  note                          String?
  subjectClassAttendanceStudent SubjectClassAttendanceStudent[]
  @@schema("ql-dao-tao")
}

// Danh sách điểm danh
model SubjectClassAttendanceStudent extends Base {
  subjectClassAttendance   SubjectClassAttendance @relation(fields: [subjectClassAttendanceId], references: [id])
  subjectClassAttendanceId String

  student                  Student                @relation(fields: [studentId], references: [id])
  studentId                String
  //Trạng thái điểm danh
  attendanceStatus         AttendanceStatus       @default(PRESENT)
  // Ghi chú từng sinh viên
  note                     String?

  @@schema("ql-dao-tao")
}



model SubjectClassHistory extends Base {
  subjectClass       SubjectClass @relation(fields: [subjectClassId], references: [id])
  subjectClassId     String

  scoreDeadLineStart DateTime?
  scoreDeadline      DateTime?
  examScoreDeadline  DateTime?

  isLockScore        Boolean?
  isLockExamScore    Boolean?
  isLockLecturer     Boolean?

  scoreSubmitted     Boolean?
  scoreChecked       Boolean?

  updatedBy          UserProfile? @relation(fields: [updatedById], references: [id])
  updatedById        String?      @db.Uuid

  @@schema("ql-dao-tao")
}

// Bảng thứ trong tuần và tiết học
model SubjectClassTime extends Base {
  subjectClass   SubjectClass @relation(fields: [subjectClassId], references: [id])
  subjectClassId String

  dayOfWeek      Int            // Thứ trong tuần (2-8 tương ứng với Thứ Hai - Chủ Nhật)
  startPeriod    Int            // Tiết bắt đầu (1, 2, 3, ...)
  endPeriod      Int            // Tiết kết thúc (1, 2, 3, ...)

  @@index([subjectClassId])
  @@schema("ql-dao-tao")
}

// Bảng thời khoá biểu / Lịch làm việc
model ClassSchedule extends Base {
  // Liên kết với lớp môn học
  subjectClass            SubjectClass?            @relation(fields: [subjectClassId], references: [id])
  subjectClassId          String?

  periodType              PeriodType               @default(THEORY)
  startPeriod             Int              // Tiết bắt đầu (1, 2, 3, ...)
  endPeriod               Int              // Tiết kết thúc (1, 2, 3, ...)
  // Thông tin thời gian cụ thể
  startTime               DateTime?       // Thời gian bắt đầu cụ thể
  endTime                 DateTime?       // Thời gian kết thúc cụ thể
  // Thông tin ngày học cụ thể
  classDate               DateTime                 @db.Date

  // Phòng học và giảng viên
  room                    Room?                    @relation(fields: [roomId], references: [id])
  roomId                  String?
  lecturer                Lecturer?                @relation(name: "MainLecturer", fields: [lecturerId], references: [id])
  lecturerId              String?
  extraLecturer           Lecturer?                @relation(name: "ExtraLecturer", fields: [extraLecturerId], references: [id])
  extraLecturerId         String?

  userProfiles            UserProfile[]  // Người tham gia thêm

  location                String?        // Địa điểm cụ thể nếu có

  notes                   String?

  // Thông tin học bù
  isReplacement           Boolean                  @default(false)  // Có phải tiết học bù
  originalSchedule        ClassSchedule?           @relation("ReplacementSchedule", fields: [originalScheduleId], references: [id])
  originalScheduleId      String?                  @unique()
  replacementSchedule     ClassSchedule?           @relation("ReplacementSchedule")

  cancelReason            String?          // Lý do hủy

  subjectClassAttendances SubjectClassAttendance[]

  @@index([subjectClassId, classDate], map: "ClassSchedule_subjectClass_date_idx")
  @@schema("ql-dao-tao")
}

/// Trạng thái phiếu sửa điểm
enum ScoreCorrectionStatus {
  INITIALIZED       // Khởi tạo
  PENDING_APPROVAL  // Chờ duyệt
  APPROVED          // Đã duyệt

  @@schema("ql-dao-tao")
}

/// Phiếu sửa điểm
model ScoreCorrectionTicket extends Base {
  trainingObjectType   TrainingObjectType    @relation(fields: [trainingObjectTypeId], references: [id])
  trainingObjectTypeId String

  number               Int                   @default(0) // Số lượng (dự kiến)
  proposal             String?             // Tờ trình
  decision             String?             // Số quyết định
  date                 DateTime              @default(now()) // Ngày
  deadline             DateTime?           // Hạn nhập

  status               ScoreCorrectionStatus @default(INITIALIZED)

  items                ScoreCorrectionItem[]

  @@schema("ql-dao-tao")
}

/// Chi tiết sửa điểm
model ScoreCorrectionItem extends Base {
  ticket                ScoreCorrectionTicket @relation(fields: [ticketId], references: [id])
  ticketId              String

  studentSubjectScore   StudentSubjectScore   @relation(fields: [studentSubjectScoreId], references: [id])
  studentSubjectScoreId String

  // Điểm mới
  newAttendanceScore    Float?
  newMidtermScore       Float?
  newExamScore          Float?

  // Điểm cũ (lưu lại để đối chiếu)
  oldAttendanceScore    Float?
  oldMidtermScore       Float?
  oldExamScore          Float?

  @@unique([ticketId, studentSubjectScoreId])
  @@schema("ql-dao-tao")
}

enum DataSyncType {
  IMPORT
  EXPORT

  @@schema("ql-dao-tao")
}

enum DataSyncStatus {
  PENDING
  SUCCESS
  FAILED

  @@schema("ql-dao-tao")
}

/// Lịch sử đồng bộ dữ liệu giữa phần mềm nội bộ và cổng đăng ký học internet
model DataSyncHistory extends Base {
  type                   DataSyncType
  status                 DataSyncStatus        @default(PENDING)
  sessionName            String
  classRegisterSession   ClassRegisterSession? @relation(fields: [classRegisterSessionId], references: [id])
  classRegisterSessionId String?
  fileName               String?
  fileVersion            String?
  sourceExportedAt       DateTime?
  errorMessage           String?               @db.Text
  recordCounts           Json?
  performedBy            UserProfile?          @relation(fields: [performedById], references: [id])
  performedById          String?               @db.Uuid

  @@index([classRegisterSessionId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@schema("ql-dao-tao")
}
