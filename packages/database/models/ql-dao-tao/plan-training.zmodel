import '../base'
import './categories'
import '../ql-danh-muc/common'
import '../ql-nguoi-dung/profile'
import './student'
import './lecturer'
import './staff'

/// học viên - lớp môn học
model SubjectClassStudent extends Base {
  subjectClass    SubjectClass @relation(fields: [subjectClassId], references: [id])
  subjectClassId  String

  student         Student      @relation(fields: [studentId], references: [id])
  studentId       String

  attendanceScore Float? // điểm chuyên cần
  midtermScore    Float? // điểm giữa kỳ
  finalScore      Float? // điểm thi

  @@schema("ql-dao-tao")
}

/// Năm học
// Giao diện tạo năm học có ô stt tự động tăng (useCount), người dùng chọn năm học bắt đầu và kết thúc => SchoolYear
model SchoolYear extends Base {
  name      String
  order     Int         @unique // số thứ tự của kỳ học trong năm học (1, 2, 3, ...) 
  startDate DateTime
  endDate   DateTime?
  semesters Semester[]
  milestone Milestone[]
  @@schema("ql-dao-tao")
}

enum SemesterType {
  FIRST // Kỳ học đầu tiên
  SECOND // Kỳ học thứ hai
  @@schema("ql-dao-tao")
}

/// Kỳ học
// Giao diện tạo kỳ học có ô stt tự động tăng (useCount), người dùng chọn kỳ học là kỳ 1 hay kỳ 2 => HK chính => SemesterType
model Semester extends Base {
  name                 String
  shortName            String? // tên ngắn gọn
  semesterType         SemesterType? // dựa vào semesterType để xác định kỳ học là kỳ 1 hay kỳ 2 => môn học sẽ có kỳ học tương ứng
  order                Int // số thứ tự của kỳ học trong năm học (1, 2, 3, ...) 
  schoolYear           SchoolYear       @relation(fields: [schoolYearId], references: [id])
  schoolYearId         String
  startDate            DateTime
  endDate              DateTime?

  subjectClasses       SubjectClass[]
  trainingCoursesStart TrainingCourse[]

  @@unique([schoolYearId, order]) // stt kỳ học trong một năm học không được trùng nhau
  @@unique([schoolYearId, semesterType]) // mỗi năm học chỉ có một kỳ học chính (kỳ 1 hoặc kỳ 2)
  @@schema("ql-dao-tao")
}

/// Mốc huấn luyện
model Milestone extends Base {
  name         String
  period       String? // Thời gian thực hiện
  startDate    DateTime
  endDate      DateTime
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id])
  schoolYearId String
  @@schema("ql-dao-tao")
}

enum TrainingCourseStatus {
  ACTIVE // Đang hoạt động
  COMPLETED // Hoàn thành
  SUSPEND // Tạm dừng
  CANCEL // Hủy bỏ
  @@schema("ql-dao-tao")
}

/// Khoá học
model TrainingCourse extends Base {
  name                 String
  semesterStart        Semester             @relation(fields: [semesterStartId], references: [id]) // Kỳ học bắt đầu
  semesterStartId      String
  startYear            Int?
  endYear              Int?
  academicYear         String?
  maxTrainingTime      Float?
  admissionQuota       Int?
  trainingObjectType   TrainingObjectType   @relation(fields: [trainingObjectTypeId], references: [id]) // Đối tượng đào tạo
  trainingObjectTypeId String

  status               TrainingCourseStatus @default(ACTIVE)
  fixedClass           FixedClass[]
  @@schema("ql-dao-tao")
}
/// lớp biên chế
model FixedClass extends Base {
  name                     String
  summary                  String?
  startYear                Int?
  graduated                Boolean?           @default(false)

  trainingCourse           TrainingCourse?    @relation(fields: [trainingCourseId], references: [id]) // Khóa học
  trainingCourseId         String?

  managementOrganization   Organization?      @relation(fields: [managementOrganizationId], references: [id]) // Đơn vị phụ trách
  managementOrganizationId String?

  lecturerManagement       Lecturer?          @relation(name: "ManageLecturer", fields: [lecturerManagementId], references: [id])
  lecturerManagementId     String?

  staffManagement          Staff?             @relation(name: "ManageStaff", fields: [staffManagementId], references: [id])
  staffManagementId        String?

  initSize                 Int                @default(0) // sĩ số
  students                 Student[]

  curriculumVersion        CurriculumVersion? @relation(fields: [curriculumVersionId], references: [id])
  curriculumVersionId      String?

  @@schema("ql-dao-tao")
}

enum CurriculumStatus {
  ACTIVE
  INACTIVATED
  @@schema("ql-dao-tao")
}

/// chương trình đào tạo
model Curriculum extends Base {
  name                     String
  englishName              String?
  status                   CurriculumStatus    @default(ACTIVE) //Có thể có endDate nhưng vẫn active do có lớp đang học
  managementOrganization   Organization        @relation(fields: [managementOrganizationId], references: [id]) // Đơn vị phụ trách
  managementOrganizationId String

  trainingMajor            TrainingMajor       @relation(fields: [trainingMajorId], references: [id]) // Chuyên ngành đào tạo
  trainingMajorId          String

  information              String?   //Thông tin
  documentPaths            String[] // Đường dẫn tài liệu
  renderPath               String? // Đường dẫn tài liệu kết xuất

  curriculumVersion        CurriculumVersion[]
  @@schema("ql-dao-tao")
}

enum TrainingLanguage {
  Vietnamese // Tiếng Việt
  English // Tiếng Anh

  @@schema("ql-dao-tao")
}

/// Phiên bản chương trình đào tạo
model CurriculumVersion extends Base {
  name                 String
  shortName            String?
  englishName          String?
  trainingLanguage     TrainingLanguage                   @default(Vietnamese) // Ngôn ngữ đào tạo
  numberOfSemesters    Int
  yearCreation         Int? // Năm tạo chương trình đào tạo
  yearApplication      Int? // Năm áp dụng chương trình đào tạo
  curriculum           Curriculum                         @relation(fields: [curriculumId], references: [id]) // Chương trình giảng dạy
  curriculumId         String

  trainingObjectType   TrainingObjectType                 @relation(fields: [trainingObjectTypeId], references: [id]) // Đối tượng đào tạo
  trainingObjectTypeId String
  trainingLevel        TrainingLevel                      @relation(fields: [trainingLevelId], references: [id]) // Bậc đào tạo
  trainingLevelId      String
  trainingTime         TrainingTime                       @relation(fields: [trainingTimeId], references: [id]) // Thời gian đào tạo
  trainingTimeId       String

  coef_1               Float? // Hệ số 1
  coef_2               Float? // Hệ số 2
  coef_3               Float? // Hệ số 3

  // TODO: Thêm các quy chế cho chương trình đào tạo
  scoreToTakeExam      Float? // Điểm tối thiểu để được thi
  scoreToPass          Float? // Điểm tối thiểu để qua môn
  requiredCredits      Int? // Số tín chỉ bắt buộc
  electiveCredits      Int? // Số tín chỉ tự chọn

  objectives           String? // Mục tiêu
  inputStandard        String? // Chuẩn đầu vào
  outputStandard       String? // Chuẩn đầu ra
  information          String? // Thông tin
  documentPaths        String[] // Đường dẫn tài liệu
  renderPath           String? // Đường dẫn tài liệu kết xuất

  trainingBlocks       TrainingBlockOnCurriculumVersion[]
  fixedClasses         FixedClass[] // Lớp biên chế
  students             Student[] // Học viên

  @@schema("ql-dao-tao")
}

/// môn học
model Subject extends Base {
  name                     String

  managementOrganization   Organization     @relation(fields: [managementOrganizationId], references: [id]) // Đơn vị phụ trách
  managementOrganizationId String
  information              String?   //Thông tin

  subjectVersion           SubjectVersion[] @relation(name: "SubjectVersion")

  @@schema("ql-dao-tao")
}

enum SubjectEquivalentType { // loại môn học tương đương
  NONE // không tương đương
  OneByOne // tương đương 1-1
  TwoByOne // hai môn tương đương 1
  ThreeByOne // ba môn tương đương 1
  FourByOne // bốn môn tương đương 1
  OneByTwo // một môn tương đương hai
  OneByThree // một môn tương đương ba
  @@schema("ql-dao-tao")
}

/// loại hình thi
enum ExamType {
  OfflineWritten // thi viết
  OnlineWritten // thi viết trực tuyến
  OfflineChoices // thi trắc nghiệm
  OnlineChoices // thi trắc nghiệm trực tuyến
  Oral // thi vấn đáp
  Practice // thi thực hành
  Project // thi đồ án
  Other // loại khác
  @@schema("ql-dao-tao")
}

/// Phiên bản môn học
// Giao diện nhập điểm sẽ phụ thuộc vào hệ số (e.g. 1 hay 2 điểm giữa kỳ)
model SubjectVersion extends Base {
  name                     String
  examType                 ExamType
  subjectEquivalentType    SubjectEquivalentType  @default(NONE) // loại môn học tương đương
  credit                   Int // số tín chỉ
  period                   Int                    @default(0) // số tiết học
  numberOfTheory           Int                    @default(0) // số tiết lý thuyết
  numberOfPractice         Int                    @default(0) // số tiết thực hành
  numberOfSelfStudy        Int                    @default(0) // số tiết tự học
  numberOfProject          Int                    @default(0) // số tiết đồ án
  numberOfInternship       Int                    @default(0) // số tiết thực tập
  numberOfOther            Int                    @default(0) // số tiết khác
  objectives               String? // Mục tiêu
  outputStandard           String? // Chuẩn đầu ra
  documentPaths            String[] // Đường dẫn tài liệu

  managementOrganization   Organization           @relation(fields: [managementOrganizationId], references: [id]) // Đơn vị phụ trách
  managementOrganizationId String

  subject                  Subject                @relation(name: "SubjectVersion", fields: [subjectId], references: [id])
  subjectId                String

  /// môn học khối kiến thức - CTĐT
  trainingBlocks           TrainingBlockSubject[]

  /// môn học tiên quyết
  prerequisiteSubject      SubjectVersion[]       @relation(name: "PrerequisiteSubject")
  dependentSubject         SubjectVersion[]       @relation(name: "PrerequisiteSubject")

  // môn học song hành
  coRequisiteSubject       SubjectVersion[]       @relation(name: "CoRequisiteSubject")
  depCoRequisiteSubject    SubjectVersion[]       @relation(name: "CoRequisiteSubject")

  subjectClass             SubjectClass[]

  @@schema("ql-dao-tao")
}

/// loại bắt buộc
enum SubjectRequirementType {
  None // không xác định
  Mandatory // bắt buộc
  Optional // tự chọn
  Elective // tự chọn tự do
  @@schema("ql-dao-tao")
}

/// môn học khối kiến thức chương trình
model TrainingBlockSubject extends Base {
  subject                            SubjectVersion                   @relation(fields: [subjectId], references: [id])
  subjectId                          String

  trainingBlockOnCurriculumVersion   TrainingBlockOnCurriculumVersion @relation(fields: [trainingBlockOnCurriculumVersionId], references: [id])
  trainingBlockOnCurriculumVersionId String

  semester                           Int? // kỳ học

  type                               SubjectRequirementType           @default(None) // loại bắt buộc
  useForFinalScore                   Boolean // có sử dụng để tính điểm thi cuối kỳ hay không
  graduation                         Boolean // có phải là môn học tốt nghiệp hay không
  project                            Boolean // có phải là môn học đồ án hay không
  print                              Boolean // có in trên bảng điểm hay không
  @@schema("ql-dao-tao")
}

/// Lớp môn học
model SubjectClass extends Base {
  name                String
  startDate           DateTime
  endDate             DateTime?
  subject             SubjectVersion        @relation(fields: [subjectId], references: [id])
  subjectId           String

  examDate            DateTime?

  semester            Semester              @relation(fields: [semesterId], references: [id])
  semesterId          String

  mainLecturer        Lecturer?             @relation(name: "MainLecturer", fields: [lecturerId], references: [id])
  lecturerId          String?

  extraLecturer       Lecturer?             @relation(name: "ExtraLecturer", fields: [extraLecturerId], references: [id])
  extraLecturerId     String?

  subjectClassStudent SubjectClassStudent[]
  @@schema("ql-dao-tao")
}

