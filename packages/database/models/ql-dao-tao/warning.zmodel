import '../base'
import '../ql-nguoi-dung/profile'
import 'student'
import 'training-score'
import 'categories'
import 'plan-training'
import 'scholarship'

model AcademicWarningRule extends Base {
  ruleType          AcademicWarningRuleType
  threshold         Float?    // Ngưỡng giới hạn (nếu có)
  semesterCondition Int?      // Áp dụng cho học kỳ thứ mấy, null nếu áp dụng mọi học kỳ
  yearCondition     Int?      // Áp dụng cho năm học thứ mấy, null nếu áp dụng mọi năm
  severity          Int      // 1 hoặc 2 mức tăng

  trainingCourse    TrainingCourse          @relation(fields: [trainingCourseId], references: [id])
  trainingCourseId  String

  academicWarning   AcademicWarning[]

  @@schema("ql-dao-tao")
}

enum AcademicWarningRuleType {
  GPA_SEMESTER_BELOW
  GPA_CUMULATIVE_BELOW
  FAILED_CREDITS_SEMESTER
  FAILED_CREDITS_TOTAL
  GPA_ZERO
  NO_REGISTRATION

  @@schema("ql-dao-tao")
}

/// Cảnh cáo học tập
model AcademicWarning extends Base {
  student       Student               @relation(fields: [studentId], references: [id])
  studentId     String
  semester      Semester              @relation(fields: [semesterId], references: [id])
  semesterId    String

  level         Int      // Mức CBHT hiện tại (0–4)
  increasedFrom Int?     // Ghi nhận mức cũ nếu có nâng
  decreasedFrom Int?     // Ghi nhận mức cũ nếu có giảm

  rules         AcademicWarningRule[] // các quy chế vi phạm

  @@schema("ql-dao-tao")
}

/// Cảnh cáo học đường
model DisciplinaryWarning extends Base {
  studentId     String
  semesterId    String
  level         Int      // Mức CCHĐ hiện tại (0–4)
  increasedFrom Int?

  reasonDetails DisciplinaryWarningReason[]

  @@schema("ql-dao-tao")
}

model DisciplinaryWarningReason extends Base {
  warning       DisciplinaryWarning           @relation(fields: [warningId], references: [id])
  warningId     String
  reasonType    DisciplinaryWarningReasonType
  severityLevel Int      // 1 hoặc 2 mức nâng

  @@schema("ql-dao-tao")
}

enum DisciplinaryWarningReasonType {
  DISCIPLINE_PENALTY                 // Bị kỷ luật từ cảnh cáo trở lên
  EXAM_VIOLATION                     // Bị đình chỉ hoặc cảnh cáo thi
  EXAM_PROXY_FIRST                   // Thi hộ lần đầu
  EXAM_PROXY_REPEAT                  // Thi hộ lần hai
  LATE_TUITION_1                     // Nộp học phí muộn <= 4 tuần
  LATE_TUITION_2                     // Nộp học phí muộn > 4 tuần

  @@schema("ql-dao-tao")
}