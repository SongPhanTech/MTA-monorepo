import '../base'
import '../ql-ho-so/profile'
import 'student'
import 'training-score'
import 'categories'
import 'plan-training'
import 'scholarship'
import 'criteria'

/// Quy tắc cấu hình Cảnh báo học tập
model AcademicWarningRule extends Base {
  field             CriteriaField      // Trường dữ liệu để kiểm tra, ví dụ: SEMESTER_GPA
  operator          CriteriaOperator   // Toán tử so sánh, ví dụ: LTE (nhỏ hơn hoặc bằng)
  invert            Boolean           @default(false) // đảo ngược operator
  threshold         Float              // Ngưỡng giá trị để so sánh
  tuple             String[]          @default([]) // giá trị sử dụng cho operator IN

  severity          Int                // Mức độ cảnh cáo sẽ tăng nếu vi phạm (1 hoặc 2)

  // Các điều kiện phụ để quy tắc được áp dụng
  yearCondition     Int?     // Áp dụng cho sinh viên năm thứ mấy, null nếu áp dụng mọi năm
  semesterCondition Int?     // Áp dụng cho học kỳ thứ mấy trong năm, null nếu áp dụng mọi học kỳ

  trainingCourse    TrainingCourse    @relation(fields: [trainingCourseId], references: [id])
  trainingCourseId  String

  academicWarning   AcademicWarning[]

  @@schema("ql-dao-tao")
}

/// Cảnh báo học tập
model AcademicWarning extends Base {
  student       Student               @relation(fields: [studentId], references: [id])
  studentId     String
  semester      Semester              @relation(fields: [semesterId], references: [id])
  semesterId    String

  level         Int      // Mức CBHT hiện tại (0–4)
  increasedFrom Int?     // Ghi nhận mức cũ nếu có nâng
  decreasedFrom Int?     // Ghi nhận mức cũ nếu có giảm

  rules         AcademicWarningRule[] // các quy chế vi phạm

  @@schema("ql-dao-tao")
}

/// Cảnh cáo học đường
model DisciplinaryWarning extends Base {
  student       Student                     @relation(fields: [studentId], references: [id])
  studentId     String
  semester      Semester?                   @relation(fields: [semesterId], references: [id])
  semesterId    String?
  level         Int      // Mức CCHĐ hiện tại (0–4)
  increasedFrom Int?

  reasonDetails DisciplinaryWarningReason[]

  @@schema("ql-dao-tao")
}

// Bị kỷ luật từ cảnh cáo trở lên
// Bị đình chỉ hoặc cảnh cáo thi
// Thi hộ lần đầu
// Thi hộ lần hai
// Nộp học phí muộn <= 4 tuần
// Nộp học phí muộn > 4 tuần
model DisciplinaryWarningReason extends Base {
  name          String                @unique
  warning       DisciplinaryWarning[]
  severityLevel Int      // 1 hoặc 2 mức nâng

  @@schema("ql-dao-tao")
}
