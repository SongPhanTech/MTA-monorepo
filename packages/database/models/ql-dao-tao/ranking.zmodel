import '../base'
import '../ql-dao-tao/plan-training'
import '../ql-dao-tao/student'
import '../ql-danh-muc/common'
import '../ql-ho-so/profile'
import 'categories'
import 'training-score'
import 'criteria'
import '../ql-danh-muc/document'
import 'output-standard'

enum GraduationSessionStatus {
  PLANNING              // Đang lên kế hoạch
  OPEN_FOR_APPLICATION  // Đang mở nhận đơn
  IN_REVIEW             // Đang trong quá trình xét duyệt
  COMPLETED             // Đã hoàn tất
  CLOSED                // Đã đóng

  @@schema("ql-dao-tao")
}

/// Đợt xét tốt nghiệp 
model GraduationSession extends Base {
  name                     String
  sessionDate              DateTime             // Ngày diễn ra phiên họp của hội đồng
  applicationStart         DateTime             // Ngày bắt đầu nhận đơn
  applicationEnd           DateTime             // Ngày kết thúc nhận đơn

  // Đối tượng đào tạo
  trainingObjectType       TrainingObjectType             @relation(fields: [trainingObjectTypeId], references: [id])
  trainingObjectTypeId     String

  status                   GraduationSessionStatus        @default(PLANNING)

  /// Danh sách các đơn xét tốt nghiệp trong đợt này
  applications             StudentGraduationApplication[]

  /// chuẩn đầu ra áp dụng
  outputStandard           OutputStandard[]

  trainingCourse           TrainingCourse?                @relation(fields: [trainingCourseId], references: [id])
  trainingCourseId         String?

  eligibleCount            Int? // SoDuDieuKien
  excellentCount           Int? // SoXS

  // Topic Decision (QD_DETAI)
  topicDecisionNumber      String?
  topicDecisionDate        DateTime?
  topicDecisionSigner      String?

  // Defense Decision (QD_BVLV)
  defenseDecisionNumber    String?
  defenseDecisionDate      DateTime?
  defenseDecisionSigner    String?

  // Graduation Decision (QDtotNghiep)
  graduationDecisionNumber String?
  graduationDecisionDate   DateTime?
  graduationDecisionSigner String?

  councilMeetingDate       DateTime? // NgayHopHDXTN

  councilMeetingBasis      String? // CanCuHopHDXTN
  proposalTopic            String? // ToTrinhDeTai
  proposalCouncil          String? // ToTrinhHoiDong
  proposalGraduation       String? // ToTrinhTotNghiep
  skipCertificateCheck     Boolean? // BoQuaChungChi

  @@schema("ql-dao-tao")
}

enum ApplicationStatus {
  SUBMITTED  // Mới nộp
  IN_REVIEW  // Đang được xem xét
  APPROVED   // Được chấp thuận
  REJECTED   // Bị từ chối

  @@schema("ql-dao-tao")
}

/// Quản lý đơn đăng ký xét tốt nghiệp của sinh viên
model StudentGraduationApplication extends Base {
  student                 Student                  @relation(fields: [studentId], references: [id])
  studentId               String

  session                 GraduationSession        @relation(fields: [sessionId], references: [id])
  sessionId               String

  applicationDate         DateTime                 @default(now())
  status                  ApplicationStatus        @default(SUBMITTED)

  graduation              Boolean?
  gpa                     Decimal?                 @db.Decimal(5, 2)
  reason                  String?

  downgraded              ApplicationDowngraded?

  rank                    AcademicRankingConvert?  @relation(fields: [rankId], references: [id])
  rankId                  String?

  trainingMajor           TrainingMajor?           @relation(fields: [trainingMajorId], references: [id])
  trainingMajorId         String?

  diplomaType             DiplomaType?             @relation(fields: [diplomaTypeId], references: [id])
  diplomaTypeId           String?

  thesisScore             Float?
  thesisReExam            Boolean?
  politicalScore          Float?
  politicalReExam         Boolean?
  foreignLanguageScore    Float?
  foreignLanguageReExam   Boolean?
  defenseEduCert          Boolean?
  physicalEduCert         Boolean?
  foreignLangCert         Boolean?
  itCert                  Boolean?
  accumulatedCredits      Int?
  gpa10                   Float?
  reExamCredits           Int?
  totalSubjects           Int?
  failedSubjects          Int?
  failedCredits           Int?
  mandatoryFailedSubjects Int?
  mandatoryFailedCredits  Int?
  rankDowngraded          Boolean?

  applicationCheckResult  ApplicationCheckResult[]
  gpaScore                StudentSubjectScore[]    @relation("gpaScore")
  supplementaryScore      StudentSubjectScore[]    @relation("supplementaryScore")
  // Quyết định cuối cùng cho đơn này
  decision                GraduationDecision?

  @@unique([studentId, sessionId])
  @@schema("ql-dao-tao")
}

model ApplicationDowngraded extends Base {
  studentGraduationApplication   StudentGraduationApplication       @relation(fields: [studentGraduationApplicationId], references: [id])
  studentGraduationApplicationId String                             @unique

  from                           AcademicRankingConvert             @relation(fields: [fromId], references: [id])
  fromId                         String

  conditions                     GraduationRankDowngradeCondition[]

  @@schema("ql-dao-tao")
}

/// Kết quả kiểm tra điều kiện tự động của hệ thống
model ApplicationCheckResult extends Base {
  studentGraduationApplication   StudentGraduationApplication @relation(fields: [studentGraduationApplicationId], references: [id])
  studentGraduationApplicationId String                       @unique

  rankingCondition               RankingCondition             @relation(fields: [rankingConditionId], references: [id])
  rankingConditionId             String

  passed                         Boolean
  actualValue                    Float?

  @@unique([studentGraduationApplicationId, rankingConditionId])
  @@schema("ql-dao-tao")
}

/// Lưu trữ quyết định tốt nghiệp cuối cùng cho một sinh viên
model GraduationDecision extends Base {
  application           StudentGraduationApplication @relation(fields: [applicationId], references: [id])
  applicationId         String                       @unique
  student               Student                      @relation(fields: [studentId], references: [id])
  studentId             String                       @unique // Mỗi sinh viên chỉ có 1 quyết định tốt nghiệp

  decisionDate          DateTime                     @default(now()) @db.Date
  notes                 String?  // Ghi chú của hội đồng

  // Thông tin tại thời điểm tốt nghiệp (snapshot)
  finalGpa              Decimal                      @db.Decimal(5, 2)            // GPA cuối cùng
  trainingMajor         TrainingMajor?               @relation(fields: [trainingMajorId], references: [id])
  trainingMajorId       String?
  finalRanking          AcademicRankingConvert       @relation(fields: [finalRankingId], references: [id])
  finalRankingId        String

  diplomaType           DiplomaType?                 @relation(fields: [diplomaTypeId], references: [id])
  diplomaTypeId         String?  // curriculumVersion.diplomaId
  originalDiplomaNumber String?                      @unique // Số vào sổ gốc văn bằng
  diplomaNumber         String?                      @unique // Số hiệu văn bằng
  diplomaIssueDate      DateTime?                    @db.Date      // Ngày cấp bằng

  diplomaFront          DocumentFile?                @relation("DiplomaFront")
  diplomaBack           DocumentFile?                @relation("DiplomaBack")

  totalCopy             Int?                         @default(0) // Số lần sao y 

  @@schema("ql-dao-tao")
}

enum RankingContext {
  STUDYING    // Xếp loại trong quá trình học (học lực)
  GRADUATION  // Xếp loại khi tốt nghiệp

  @@schema("ql-dao-tao")
}

/// Xếp loại học tập/Xếp loại tốt nghiệp
model AcademicRankingConvert extends Base {
  classification               String           // Xếp loại: Xuất sắc; Giỏi; Khá; TBK; TB; Yếu
  classificationEnglish        String?          // Xếp loại: Excellent; Distinction; Average; BelowAverage; Poor
  context                      RankingContext   // Bối cảnh áp dụng: Học tập hay Tốt nghiệp
  rankOrder                    Int              // Thứ tự ưu tiên của xếp loại (1 là cao nhất)

  // dựa vào type yêu cầu người dùng nhập hệ 10 hoặc hệ 4
  // dựa vào type để xếp loại học lực theo hệ 10 hoặc hệ 4
  baseScore                    AcademicRankingBaseType
  base10Min                    Float?
  base10Max                    Float?
  base4Min                     Float?
  base4Max                     Float?
  graduated                    Boolean

  trainingCourse               TrainingCourse                 @relation(fields: [trainingCourseId], references: [id])
  trainingCourseId             String

  rankingCondition             RankingCondition[]
  downgradeRules               GraduationRankDowngradeRule[]
  graduationDecision           GraduationDecision[]
  studentGraduationApplication StudentGraduationApplication[]
  applicationDowngraded        ApplicationDowngraded[]
  studentSemesterResult        StudentSemesterResult[]
  studentYearResult            StudentYearResult[]

  @@validate(!(baseScore == Base10 && (base10Min == null || base10Max == null)), message: "Xếp loại theo hệ 10 phải khai báo base10Min, base10Max")
  @@validate(!(baseScore == Base4 && (base4Min == null || base4Max == null)), message: "Xếp loại theo hệ 4 phải khai báo base4Min, base4Max")

  @@unique([trainingCourseId, context, rankOrder])
  @@schema("ql-dao-tao")
}

/// Quy tắc cấu hình việc hạ bậc xếp hạng tốt nghiệp
model GraduationRankDowngradeRule extends Base {
  // Xếp loại ban đầu (trước khi xét hạ bậc) mà quy tắc này áp dụng
  // Ví dụ: quy tắc này áp dụng cho những SV ban đầu được xếp loại "Giỏi"
  initialRank   AcademicRankingConvert             @relation(fields: [initialRankId], references: [id])
  initialRankId String

  conditions    GraduationRankDowngradeCondition[]

  @@schema("ql-dao-tao")
}

/// Một điều kiện cụ thể trong bộ quy tắc hạ bậc
model GraduationRankDowngradeCondition extends Base {
  downgradeRule         GraduationRankDowngradeRule @relation(fields: [downgradeRuleId], references: [id])
  downgradeRuleId       String

  // Tiêu chí được đánh giá (hệ thống hoặc tự định nghĩa), lấy từ danh mục CriteriaDefinition
  criteria              CriteriaDefinition          @relation(fields: [criteriaId], references: [id])
  criteriaId            String
  /// @deprecated Giữ lại để chuyển dữ liệu, sẽ xoá ở migration sau. Dùng criteriaId.
  field                 CriteriaField?
  operator              CriteriaOperator // Toán tử so sánh (GTE, LTE...)
  invert                Boolean                     @default(false) // đảo ngược operator
  value                 Float          // Giá trị ngưỡng
  tuple                 String[]                    @default([]) // giá trị sử dụng cho operator IN

  applicationDowngraded ApplicationDowngraded[]

  @@index([criteriaId])
  @@schema("ql-dao-tao")
}

/// Điều kiện để đạt được một mức xếp loại
model RankingCondition extends Base {
  ranking                AcademicRankingConvert   @relation(fields: [rankingId], references: [id])
  rankingId              String

  // Quy tắc điều kiện
  field                  CriteriaField    // Trường dữ liệu để kiểm tra (ví dụ: CUMULATIVE_GPA)
  operator               CriteriaOperator // Toán tử so sánh (ví dụ: GTE)
  invert                 Boolean                  @default(false) // đảo ngược operator
  value                  Float            // Giá trị ngưỡng (ví dụ: 5.5 đối với hệ QS)
  tuple                  String[]                 @default([]) // giá trị sử dụng cho operator IN

  applicationCheckResult ApplicationCheckResult[]

  @@schema("ql-dao-tao")
}

/// Đơn xác minh văn bằng
model DiplomaVerificationApplication extends Base {
  fullname                String // Họ và tên học viên (không liên kết userProfile vì cho phép nhập tay)
  idCardNumber            String   // Căn cước công dân / CMND
  dateOfBirth             DateTime?                 @db.Date // ngày sinh
  phoneNumber             String // số điện thoại
  email                   String // email
  reason                  String // Lý do làm đơn

  originalDiplomaNumber   String // Số vào sổ gốc văn bằng
  diplomaNumber           String // Số hiệu văn bằng
  trainingMajor           String?
  trainingLevel           String?
  trainingForm            String?
  trainingCourseStartYear Int?
  trainingCourseEndYear   Int?
  diplomaIssueDate        DateTime?                 @db.Date // ngày cấp bằng
  classification          String?

  /// Tệp đính kèm khác (nhiều)
  attachments             DocumentFile[]            @relation("DiplomaVerificationAttachments")

  /// Ảnh mặt trước văn bằng
  diplomaFront            DocumentFile?             @relation("DiplomaVerificationFront")

  /// Ảnh mặt sau văn bằng
  diplomaBack             DocumentFile?             @relation("DiplomaVerificationBack")

  /// Trạng thái xử lý
  status                  DiplomaVerificationStatus @default(PENDING)

  /// Liên kết học viên (nếu cần)
  studentId               String?
  student                 Student?                  @relation(fields: [studentId], references: [id])

  @@schema("ql-dao-tao")
}


enum DiplomaVerificationStatus {
  PENDING       // Đang chờ xử lý
  IN_PROGRESS   // Đang xử lý
  APPROVED      // Đã duyệt
  REJECTED      // Từ chối

  @@schema("ql-dao-tao")
}
/// Nguồn của tiêu chí đánh giá
enum CriteriaSource {
  SYSTEM // Tiêu chí hệ thống: giá trị lấy từ CriteriaField tính sẵn ở backend
  CUSTOM // Tiêu chí tự định nghĩa: giá trị tính bằng calculator theo calcType + params

  @@schema("ql-dao-tao")
}

/// Danh mục tiêu chí đánh giá, dùng chung cho các bộ quy tắc (hiện áp dụng cho quy tắc hạ bậc tốt nghiệp).
/// - SYSTEM: systemField != null, calcType == null (27 dòng tạo sẵn bởi migration)
/// - CUSTOM: systemField == null, calcType != null (người dùng tạo trên giao diện)
/// Ràng buộc CHECK "CriteriaDefinition_source_chk" ở DB đảm bảo điều này.
model CriteriaDefinition extends Base {
  name                String
  source              CriteriaSource
  systemField         CriteriaField?                     @unique
  /// Mã calculator đăng ký ở backend (be-ql-dao-tao/src/services/criteria-calculators).
  /// Dùng String thay vì enum để thêm kiểu tính mới không cần sửa DB.
  calcType            String?
  /// Tham số của calculator, kiểm tra bằng zod theo calcType
  params              Json                               @default("{}")

  /// Phạm vi môn (CUSTOM): khối kiến thức (gồm khối con) và/hoặc môn học. Bỏ trống = toàn bộ CTĐT
  trainingBlocks      TrainingBlock[]
  subjects            Subject[]

  downgradeConditions GraduationRankDowngradeCondition[]

  @@schema("ql-dao-tao")
}
