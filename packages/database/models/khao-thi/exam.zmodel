/// Bảng kỳ thi
model Exam  extends Base {
  title              String
  status             ExamStatus          @default(DRAFT)
  questionBank       QuestionBank        @relation(fields: [questionBankId], references: [id])
  questionBankId     String

  startTime          DateTime // copy from subjectClass.examDate
  endTime            DateTime
  duration           Int

  passScore          Float               @default(5) // Điểm đạt
  maxScore           Float               @default(10) // Điểm tối đa
  shuffleQuestions   Boolean             @default(true) // Xáo trộn câu hỏi
  shuffleAnswers     Boolean             @default(true) // Xáo trộn đáp án
  showResult         Boolean             @default(false) // Hiển thị kết quả ngay

  subjectClass       SubjectClass[]
  examBank           ExamBank[]
  testStructureRules TestStructureRule[]
  examSessions       ExamSession[]

  @@schema("khao-thi")
}

/// Cấu hình tạo đề tự động cho kỳ thi
model TestStructureRule extends Base {
  exam             Exam           @relation(fields: [examId], references: [id])
  examId           String
  knowledgeBlock   KnowledgeBlock @relation(fields: [knowledgeBlockId], references: [id])
  knowledgeBlockId String
  questionPoint    Float
  // difficulty       Difficulty     @relation(fields: [difficultyId], references: [id])
  // difficultyId     String         // Dùng ID của mức độ khó
  questionType     QuestionType
  count            Int

  @@unique([examId, knowledgeBlockId, questionPoint, questionType])
  @@schema("khao-thi")
}

/// Đề thi
model ExamBank extends Base {
  exam        Exam               @relation(fields: [examId], references: [id])
  examId      String

  examSession ExamSession[]
  questions   ExamBankQuestion[] // Danh sách câu hỏi trong đề thi
  @@schema("khao-thi")
}

/// Bảng nối, xác định câu hỏi nào thuộc về phiên thi nào
model ExamBankQuestion extends Base {
  examBankId String
  examBank   ExamBank @relation(fields: [examBankId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  order      Int? // Thứ tự câu hỏi trong đề thi của phiên này

  @@unique([examBankId, questionId])
  @@unique([examBankId, order])
  @@schema("khao-thi")
}

/// Bài thi
model ExamSession extends Base {
  startTime  DateTime  @default(now())
  endTime    DateTime?
  score      Decimal?  @db.Decimal(5, 2)
  isGraded   Boolean   @default(false)

  student    Student?  @relation(fields: [studentId], references: [id])
  studentId  String?
  exam       Exam      @relation(fields: [examId], references: [id])
  examId     String
  room       Room?     @relation(fields: [roomId], references: [id])
  roomId     String?

  examBank   ExamBank? @relation(fields: [examBankId], references: [id])
  examBankId String?

  answers    Answer[]              // Tất cả câu trả lời trong phiên này

  @@unique([studentId, examId])
  @@schema("khao-thi")
}
