/// Đề thi
model ExamBank extends Base {
  exam           Exam               @relation(fields: [examId], references: [id])
  examId         String
  examTime       Int?               

  examCode       String

  subjectClass   SubjectClass?      @relation(fields: [subjectClassId], references: [id])
  subjectClassId String?

  explain        String?
  examDay        DateTime?
  examType       ExamType?
  questions      ExamBankQuestion[] // Danh sách câu hỏi trong đề thi
  examMatrix     ExamMatrix?        @relation(fields: [examMatrixId], references: [id])
  examMatrixId   String?
  isLock         Boolean?           @default(false)
  /// được sử dụng tài liệu hay không
  isNote         Boolean?           @default(false)
  isGroup        Boolean?           @default(true)

  @@unique([examId, examCode])
  @@schema("khao-thi")
}

/// Bảng nối, xác định câu hỏi nào thuộc về đề thi nào
model ExamBankQuestion extends Base {
  examBankId String
  examBank   ExamBank @relation(fields: [examBankId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  order      Int? // Thứ tự câu hỏi trong đề thi

  @@unique([examBankId, questionId])
  @@unique([examBankId, order])
  @@schema("khao-thi")
}

/// Bài thi
model ExamPaper extends Base {
  examList              ExamList?           @relation(fields: [examListId], references: [id])
  examListId            String?

  studentSubjectScore   StudentSubjectScore @relation(fields: [studentSubjectScoreId], references: [id])
  studentSubjectScoreId String              @unique

  /// phách
  examCode              String?
  // startTime             DateTime?
  // endTime               DateTime?

  // examBank              ExamBank?           @relation(fields: [examBankId], references: [id])
  // examBankId            String?

  // answers               Answer[]              // Tất cả câu trả lời trong phiên này

  @@unique([examCode, examListId])

  @@schema("khao-thi")
}

//khung đề thi
model ExamFramework extends Base {
  name             String
  time             Int

  subjectVersion   SubjectVersion @relation(fields: [subjectVersionId], references: [id])
  subjectVersionId String

  examMatrixs      ExamMatrix[]
  documentFiles    DocumentFile[]
  @@schema("khao-thi")
}

// ma trận đề thi
model ExamMatrix extends Base {
  name            String
  isDefault       Boolean          @default(false)
  examFramework   ExamFramework    @relation(fields: [examFrameworkId], references: [id])
  examFrameworkId String
  knowledgeBlocks KnowledgeBlock[]
  examBank        ExamBank[]
  @@schema("khao-thi")
}

/// Khối kiến thức / Chuẩn đầu ra
model KnowledgeBlock extends Base {
  name             String // Tên chương / khối kiến thức
  examMatrix       ExamMatrix      @relation(fields: [examMatrixId], references: [id])
  examMatrixId     String

  questions        Question[]


  documentFiles    DocumentFile[]
  configExams      ConfigExam[]
  subjectVersion   SubjectVersion? @relation(fields: [subjectVersionId], references: [id])
  subjectVersionId String?

  @@schema("khao-thi")
}

// Cấu hình trọng số sinh đề
model ConfigExam extends Base {
  difficult        Difficult
  type             QuestionType? // null thì là tất cả
  quantity         Int            @default(0)
  point            Float          @default(0)
  knowledgeBlock   KnowledgeBlock @relation(fields: [knowledgeBlockId], references: [id])
  knowledgeBlockId String
  @@schema("khao-thi")
}
