/// Câu trả lời của thí sinh
model Answer extends Base {
  sessionId   String
  session     ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question    @relation(fields: [questionId], references: [id])

  // Điểm và nhận xét chung cho câu trả lời này
  isCorrect   Boolean?
  score       Float?
  comment     String?

  // Liên kết đến dữ liệu trả lời chi tiết, tùy thuộc vào loại câu hỏi
  essayAnswer String
  // multipleChoiceSelections SelectedMultipleChoiceOption[]
  // fillInBlankAnswers       FillInBlankAnswer[]
  // orderingAnswers          OrderingAnswer[]

  @@unique([sessionId, questionId])
  @@schema("khao-thi")
}

