/// Kỳ thi
model Exam extends Base {
  /// khoá DS thi
  // giao diện đánh phách, nhập điểm theo phách chỉ query lockExamSessions=true
  lockExamSessions Boolean        @default(false)

  /// thời gian thi
  duration         Int?

  // Số ca thi
  session          Int            @default(1)

  // passScore          Float               @default(5) // Điểm đạt
  // maxScore           Float               @default(10) // Điểm tối đa
  // shuffleQuestions   Boolean             @default(true) // Xáo trộn câu hỏi
  // shuffleAnswers     Boolean             @default(true) // Xáo trộn đáp án
  // showResult         Boolean             @default(false) // Hiển thị kết quả ngay

  subjectVersionId String               // Môn thi
  subjectVersion   SubjectVersion @relation(fields: [subjectVersionId], references: [id])

  // xuất sang PM quản lý đề
  semester         Semester       @relation(fields: [semesterId], references: [id])
  semesterId       String

  /// Lớp môn học
  subjectClass     SubjectClass[] // subjectClassStudent.subjectClassStudent (!examBanned) => thí sinh

  examBank         ExamBank[]
  examRooms        ExamRoom[]
  @@schema("khao-thi")
}

// Phòng thi cho kỳ thi
model ExamRoom extends Base {
  exam     Exam       @relation(fields: [examId], references: [id])
  examId   String

  // Null khi là phòng chung ảo (không xác định cụ thể, dùng để gom thí sinh khi không phân phòng, hoặc bị cấm thi, hoãn thi)
  room     Room?      @relation(fields: [roomId], references: [id])
  roomId   String?

  capacity Int        @default(0)

  examList ExamList[]

  @@unique([examId, roomId])
  @@schema("khao-thi")
}

/// Danh sách thi trong phòng thi
model ExamList extends Base {
  examRoom           ExamRoom?   @relation(fields: [examRoomId], references: [id])
  examRoomId         String?

  firstSupervisor    Lecturer?   @relation("FirstSupervisor", fields: [firstSupervisorId], references: [id])
  firstSupervisorId  String?

  secondSupervisor   Lecturer?   @relation("SecondSupervisor", fields: [secondSupervisorId], references: [id])
  secondSupervisorId String?

  /// Đã đánh phách
  createdExamCode    Boolean     @default(false)

  // khoá phách
  lockExamCode       Boolean     @default(false)

  start              Int?
  end                Int?

  // Bài thi trong phòng này
  examPapers         ExamPaper[]
  // @@unique([examId, roomId])
  @@schema("khao-thi")
}

