import '../base'
import '../ql-dao-tao/plan-training'
import '../ql-dao-tao/student'
import '../ql-dao-tao/categories'

/// Loại câu hỏi
enum QuestionType {
  ESSAY              // Tự luận
  ORAL               // Vấn đáp
  // SINGLE_CHOICE   // Trắc nghiệm một lựa chọn
  // MULTIPLE_CHOICE // Trắc nghiệm nhiều lựa chọn
  // FILL_IN_BLANK   // Điền vào chỗ trống
  // ORDERING        // Sắp xếp thứ tự

  @@schema("khao-thi")
}

/// Trạng thái của kỳ thi
enum ExamStatus {
  DRAFT     // Bản nháp, đang soạn thảo
  PUBLISHED // Đã công bố, sẵn sàng cho thí sinh
  ONGOING   // Đang diễn ra
  FINISHED  // Đã kết thúc
  ARCHIVED  // Đã lưu trữ

  @@schema("khao-thi")
}

/// Phiên bản ngân hàng câu hỏi
model QuestionBank extends Base {
  name             String           // Tên ngân hàng câu hỏi

  subjectVersion   SubjectVersion @relation(fields: [subjectVersionId], references: [id])
  subjectVersionId String

  questions        Question[]
  exam             Exam[]

  @@unique([subjectVersionId, name])
  @@schema("khao-thi")
}

/// Mức độ khó
model Difficulty extends Base {
  name      String     @unique // VD: "Nhận biết", "Thông hiểu", "Vận dụng", "Vận dụng cao"
  level     Int?       @unique // Mức độ ưu tiên hoặc sắp xếp, VD: 1, 2, 3, 4

  questions Question[]
  // structureRules TestStructureRule[]

  @@schema("khao-thi")
}

/// Khối kiến thức / Chương mục
model KnowledgeBlock extends Base {
  subjectVersion   SubjectVersion      @relation(fields: [subjectVersionId], references: [id])
  subjectVersionId String

  name             String // Tên chương / khối kiến thức

  questions        Question[]
  structureRules   TestStructureRule[]

  @@unique([name])
  @@schema("khao-thi")
}

/// Câu hỏi
model Question extends Base {
  content          String // Nội dung câu hỏi. Với FILL_IN_BLANK, có thể chứa placeholder như {$1}
  type             QuestionType       @default(ESSAY)
  point            Float              @default(1) // Điểm số
  explanation      String? // Giải thích đáp án
  isAutoGraded     Boolean            @default(false)

  // // Liên kết với các bảng dữ liệu chi tiết theo từng loại câu hỏi
  // multipleChoiceOptions MultipleChoiceOption[]
  // fillInBlankSlots      FillInBlankSlot[]
  // orderingItems         OrderingItem[]

  questionBank     QuestionBank       @relation(fields: [questionBankId], references: [id])
  questionBankId   String
  knowledgeBlock   KnowledgeBlock?    @relation(fields: [knowledgeBlockId], references: [id])
  knowledgeBlockId String?
  difficulty       Difficulty?        @relation(fields: [difficultyId], references: [id])
  difficultyId     String?

  sessionQuestions ExamBankQuestion[]
  /// Câu trả lời của thí sinh trong các phiên thi
  answers          Answer[]

  @@schema("khao-thi")
}

