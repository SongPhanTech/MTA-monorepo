import '../base'
import '../ql-dao-tao/plan-training'
import '../ql-nguoi-dung/profile'
import '../ql-nguoi-dung/user'


// đối tượng khảo sát (Sinh viên, giảng viên, cán bộ quản lý,...)
model SurveyObjectType extends Base {
  name   String
  survey Survey[]
  @@schema("khao-thi")
}

// chủ đề khảo sát (Đánh giá giảng viên, đánh giá cơ sở vật chất,...)
model SurveyTopic extends Base {
  name   String
  survey Survey[]
  @@schema("khao-thi")
}

// Loại câu hỏi khảo sát (Trắc nghiệm, ý kiến,...)
model SurveyQuestionType extends Base {
  name           String
  surveyQuestion SurveyQuestion[]
  @@schema("khao-thi")
}

// đợt khảo sát
model Survey extends Base {
  name             String
  startDate        DateTime
  endDate          DateTime?

  surveyObjectType SurveyObjectType @relation(fields: [surveyObjectId], references: [id])
  surveyObjectId   String

  surveyTopic      SurveyTopic      @relation(fields: [surveyTopicId], references: [id])
  surveyTopicId    String

  @@schema("khao-thi")

  surveyQuestion   SurveyQuestion[]
}

// câu hỏi khảo sát
model SurveyQuestion extends Base {
  name                 String

  surveyQuestionType   SurveyQuestionType @relation(fields: [surveyQuestionTypeId], references: [id])
  surveyQuestionTypeId String

  survey               Survey             @relation(fields: [surveyId], references: [id])
  surveyId             String

  surveyAnswer         SurveyAnswer[]

  @@schema("khao-thi")
}

// trả lời khảo sát
model SurveyAnswer extends Base {
  answer           String?

  surveyQuestion   SurveyQuestion @relation(fields: [surveyQuestionId], references: [id])
  surveyQuestionId String

  @@schema("khao-thi")
}

