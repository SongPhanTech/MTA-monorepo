import '../base'
import '../ql-dao-tao/plan-training'
import '../ql-nguoi-dung/profile'
import '../ql-nguoi-dung/user'

// đối tượng khảo sát (Sinh viên, giảng viên, cán bộ quản lý,...)
model SurveyObjectType extends Base {
  name   String
  survey Survey[]
  @@schema("khao-thi")
}

// chủ đề khảo sát (Đánh giá giảng viên, đánh giá cơ sở vật chất,...)
model SurveyTopic extends Base {
  name   String
  survey Survey[]
  @@schema("khao-thi")
}

// Loại câu hỏi khảo sát (Trắc nghiệm, ý kiến,...)
model SurveyQuestionType extends Base {
  name           String
  surveyQuestion SurveyQuestion[]
  @@schema("khao-thi")
}

// đợt khảo sát
model Survey extends Base {
  name             String
  startDate        DateTime
  endDate          DateTime?

  surveyObjectType SurveyObjectType @relation(fields: [surveyObjectId], references: [id])
  surveyObjectId   String

  surveyTopic      SurveyTopic      @relation(fields: [surveyTopicId], references: [id])
  surveyTopicId    String

  surveyQuestion   SurveyQuestion[]
  surveySessions   SurveySession[]   // Thêm relation mới

  @@schema("khao-thi")
}

// câu hỏi khảo sát
model SurveyQuestion extends Base {
  name                 String

  surveyQuestionType   SurveyQuestionType @relation(fields: [surveyQuestionTypeId], references: [id])
  surveyQuestionTypeId String

  survey               Survey             @relation(fields: [surveyId], references: [id])
  surveyId             String

  surveyAnswer         SurveyAnswer[]
  surveyResponses      SurveyResponse[]  // Thêm relation mới

  @@schema("khao-thi")
}

// trả lời khảo sát
model SurveyAnswer extends Base {
  answer           String?

  surveyQuestion   SurveyQuestion @relation(fields: [surveyQuestionId], references: [id])
  surveyQuestionId String

  surveyResponses  SurveyResponse[]  // Thêm relation mới

  @@schema("khao-thi")
}

// Bảng lưu phiên khảo sát của từng học viên
model SurveySession extends Base {
  survey      Survey    @relation(fields: [surveyId], references: [id])
  surveyId    String
  
  student     Student   @relation(fields: [studentId], references: [id])
  studentId   String

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  isCompleted Boolean   @default(false)

  responses   SurveyResponse[]

  @@unique([surveyId, studentId])
  @@schema("khao-thi")
}

// Bảng lưu câu trả lời cụ thể của học viên cho từng câu hỏi
model SurveyResponse extends Base {
  surveySession    SurveySession  @relation(fields: [surveySessionId], references: [id])
  surveySessionId  String
  
  surveyQuestion   SurveyQuestion @relation(fields: [surveyQuestionId], references: [id])
  surveyQuestionId String

  // Câu trả lời của học viên
  answerText       String?        // Câu trả lời dạng text
  selectedAnswer   SurveyAnswer?  @relation(fields: [selectedAnswerId], references: [id])
  selectedAnswerId String?        // ID của đáp án được chọn (cho câu hỏi trắc nghiệm)

  answeredAt       DateTime       @default(now())

  @@unique([surveySessionId, surveyQuestionId])
  @@schema("khao-thi")
}