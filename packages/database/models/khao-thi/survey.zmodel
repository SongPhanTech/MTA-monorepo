import '../base'
import '../ql-dao-tao/plan-training'
import '../ql-ho-so/profile'
import '../ql-nguoi-dung/user'
import '../ql-dao-tao/student'
import '../ql-danh-muc/core-categories'
import '../ql-dao-tao/categories'

enum SurveyQuestionType {
  ESSAY
  SINGLE_CHOICE

  @@schema("khao-thi")
}

enum  SurveyObject {
  STUDENT
  LECTURER

  @@schema("khao-thi")
}

// đối tượng khảo sát (Sinh viên, giảng viên, cán bộ quản lý,...)
model SurveyObjectType extends Base {
  name            String
  survey          Survey[]
  type            SurveyObject[]
  organizations   DM_DonVi[]
  trainingFields  TrainingField[]
  trainingMajors  TrainingMajor[]
  trainingCourses TrainingCourse[]
  fixedClasses    FixedClass[]
  subjectClasses  SubjectClass[]
  @@schema("khao-thi")
}

// chủ đề khảo sát (Đánh giá giảng viên, đánh giá cơ sở vật chất,...)
model SurveyTopic extends Base {
  name                String
  survey              Survey[]
  surveyQuestionGroup SurveyQuestionGroup[]
  @@schema("khao-thi")
}

// Nhóm câu hỏi khảo sát
model SurveyQuestionGroup extends Base {
  name           String
  surveyQuestion SurveyQuestion[]
  surveyTopic    SurveyTopic      @relation(fields: [surveyTopicId], references: [id])
  surveyTopicId  String
  @@schema("khao-thi")
}

// đợt khảo sát
model Survey extends Base {
  name                 String
  startDate            DateTime
  endDate              DateTime?

  surveyObjectType     SurveyObjectType[]

  surveyTopic          SurveyTopic        @relation(fields: [surveyTopicId], references: [id])
  surveyTopicId        String

  // Có góp ý bổ sung không?
  additionalSuggestion Boolean

  // 1. Rất hài lòng
  // 2. Hài lòng
  // 3. Không hài lòng
  // 4. Rất không hài lòng
  // 0. Phân vân
  surveyChoice         SurveyChoice[]
  surveyQuestion       SurveyQuestion[]
  surveySessions       SurveySession[]   // Thêm relation mới

  @@schema("khao-thi")
}

// câu hỏi khảo sát
model SurveyQuestion extends Base {
  name                  String

  // Hiển thị surveyChoice khi type = SINGLE_CHOICE
  type                  SurveyQuestionType

  surveyQuestionGroup   SurveyQuestionGroup? @relation(fields: [surveyQuestionGroupId], references: [id])
  surveyQuestionGroupId String?

  survey                Survey               @relation(fields: [surveyId], references: [id])
  surveyId              String

  surveyResponses       SurveyResponse[]  // Thêm relation mới

  @@schema("khao-thi")
}

/// Lựa chọn của câu hỏi khảo sát
model SurveyChoice extends Base {
  answer          String?

  survey          Survey           @relation(fields: [surveyId], references: [id])
  surveyId        String

  surveyResponses SurveyResponse[]  // Thêm relation mới

  @@schema("khao-thi")
}

/// Bảng lưu phiên khảo sát của từng học viên
model SurveySession extends Base {
  survey               Survey           @relation(fields: [surveyId], references: [id])
  surveyId             String

  additionalSuggestion String?

  student              Student?         @relation(fields: [studentId], references: [id])
  studentId            String?

  startedAt            DateTime         @default(now())
  completedAt          DateTime?
  isCompleted          Boolean          @default(false)

  responses            SurveyResponse[]

  @@unique([surveyId, studentId])
  @@schema("khao-thi")
}

/// Bảng lưu câu trả lời cụ thể của học viên cho từng câu hỏi
model SurveyResponse extends Base {
  surveySession    SurveySession  @relation(fields: [surveySessionId], references: [id])
  surveySessionId  String

  surveyQuestion   SurveyQuestion @relation(fields: [surveyQuestionId], references: [id])
  surveyQuestionId String

  // Câu trả lời của học viên
  answerText       String?        // Câu trả lời dạng text
  surveyChoice     SurveyChoice?  @relation(fields: [surveyChoiceId], references: [id])
  surveyChoiceId   String?

  answeredAt       DateTime       @default(now())

  @@unique([surveySessionId, surveyQuestionId])
  @@schema("khao-thi")
}