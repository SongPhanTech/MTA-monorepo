import '../base'
import '../ql-dao-tao/plan-training'
import '../ql-dao-tao/student'
import '../ql-dao-tao/categories'
import '../ql-ho-so/profile'
import '../ql-dao-tao/lecturer'


/// Đợt đánh giá CTDT
model EvaluationPeriod extends Base {
  name                       String
  startDate                  DateTime                    @default(now())
  endDate                    DateTime?

  standards                  EvaluationStandard[]
  councils                   EvaluationCouncil[]
  evaluationSecretarYCouncil EvaluationSecretarYCouncil?

  @@schema("khao-thi")
}

/// Danh mục tiêu chuẩn
model StandardCatalog extends Base {
  order    Int
  name     String
  criteria CriterionCatalog[]

  @@schema("khao-thi")
}

/// Danh mục tiêu chí
model CriterionCatalog extends Base {
  standard                    StandardCatalog               @relation(fields: [standardId], references: [id])
  standardId                  String
  order                       Int
  name                        String
  scoreScale                  ScoreScaleCatalog             @relation(fields: [scoreScaleId], references: [id])
  scoreScaleId                String  // mặc định dùng thang đánh giá nào

  requirementCriterionCatalog RequirementCriterionCatalog[]

  @@schema("khao-thi")
}

/// Danh mục yêu cầu
model RequirementCriterionCatalog extends Base {
  criterionCatalog   CriterionCatalog @relation(fields: [criterionCatalogId], references: [id])
  criterionCatalogId String
  order              Int
  name               String
  questions          String[]

  @@schema("khao-thi")
}

/// Danh mục thang điểm
model ScoreScaleCatalog extends Base {
  name                String // e.g. "Thang 1-7"
  minValue            Int
  maxValue            Int
  passFrom            Int? // điểm từ bao nhiêu thì đạt

  criteria            CriterionCatalog[]
  evaluationCriterion EvaluationCriterion[]

  @@schema("khao-thi")
}

/// Tiêu chuẩn đánh giá của đợt (Bản sao/áp dụng từ StandardCatalog)
model EvaluationStandard extends Base {
  period     EvaluationPeriod      @relation(fields: [periodId], references: [id], onDelete: Cascade)
  periodId   String
  name       String
  order      Int

  /// Mở đầu
  opening    String                @default("")
  /// Kết luận
  conclusion String                @default("")

  criteria   EvaluationCriterion[]

  @@schema("khao-thi")
}

/// Tiêu chí đánh giá của đợt (Bản sao/áp dụng từ CriterionCatalog)
model EvaluationCriterion extends Base {
  standard              EvaluationStandard     @relation(fields: [standardId], references: [id], onDelete: Cascade)
  standardId            String
  name                  String
  order                 Int
  scoreScale            ScoreScaleCatalog      @relation(fields: [scoreScaleId], references: [id])
  scoreScaleId          String

  /// (Nhóm) Hội đồng đánh giá
  evaluationCouncil     EvaluationCouncil?     @relation(fields: [evaluationCouncilId], references: [id])
  evaluationCouncilId   String?

  /// Yêu cầu trong phiếu phân tích
  requirementCriterions RequirementCriterion[]

  // Phiếu đánh giá
  /// 1. Mô tả hiện trạng
  currentSituation      String                 @default("")
  /// 2. Điểm mạnh
  strengths             String                 @default("")
  /// 3. Điểm tồn tại
  weakness              String                 @default("")
  /// 4. Kế hoạch hành động
  actionPlan            String                 @default("")
  /// 5. Tự đánh giá
  score                 Int?

  @@unique([standardId, name])
  @@schema("khao-thi")
}

/// Nhóm minh chứng - require code
model EvidenceCategory extends Base {
  name      String

  evidences Evidence[]

  @@schema("khao-thi")
}

/// Danh mục minh chứng
model Evidence extends Base {
  category             EvidenceCategory       @relation(fields: [categoryId], references: [id])
  categoryId           String
  name                 String
  information          String // Số, ngày ban hành, hoặc thời điểm khảo sát, điều tra, phỏng vấn, quan sát,…
  issuer               String // Nơi ban hành hoặc nhóm, cá nhân thực hiện

  evidenceFile         EvidenceFile[]
  analysisFormEvidence AnalysisFormEvidence[]

  @@schema("khao-thi")
}

/// Yêu cầu trong phiếu phân tích tiêu chí
model RequirementCriterion extends Base {
  evaluationCriterion   EvaluationCriterion    @relation(fields: [evaluationCriterionId], references: [id], onDelete: Cascade)
  evaluationCriterionId String
  order                 Int
  name                  String
  questions             String[]

  evidences             AnalysisFormEvidence[]
  evidencePlaces        String                 @default("")
  collectionMethod      String                 @default("")

  @@schema("khao-thi")
}

/// Minh chứng phiếu phân tích
model AnalysisFormEvidence extends Base {
  requirementCriterion   RequirementCriterion @relation(fields: [requirementCriterionId], references: [id])
  requirementCriterionId String
  evidence               Evidence             @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  evidenceId             String
  order                  Int

  @@unique([requirementCriterionId, evidenceId])
  @@schema("khao-thi")
}

/// Vai trò của thành viên trong hội đồng đánh giá
enum EvaluationMemberRole {
  CHAIRMAN // Chủ tịch hội đồng
  VICE_PRESIDENT // Phó chủ tịch
  HEAD_SECRETARY // Truỏng ban thư ký
  SECRETARY // Thư ký
  MEMBER // Uỷ viên

  @@schema("khao-thi")
}

/// Hội đồng đánh giá
model EvaluationCouncil extends Base {
  period              EvaluationPeriod          @relation(fields: [periodId], references: [id], onDelete: Cascade)
  periodId            String
  name                String

  members             EvaluationCouncilMember[]
  evaluationCriterion EvaluationCriterion[]

  @@schema("khao-thi")
}

model EvaluationCouncilMember extends Base {
  evaluationCouncil   EvaluationCouncil      @relation(fields: [evaluationCouncilId], references: [id], onDelete: Cascade)
  evaluationCouncilId String
  lecturer            Lecturer               @relation(fields: [lecturerId], references: [id])
  lecturerId          String
  role                EvaluationMemberRole[]

  @@schema("khao-thi")
}

/// Hội đồng thư ký
model EvaluationSecretarYCouncil extends Base {
  period   EvaluationPeriod            @relation(fields: [periodId], references: [id], onDelete: Cascade)
  periodId String                      @unique
  name     String

  members  EvaluationSecretaryMember[]

  @@schema("khao-thi")
}

/// Vai trò của thành viên trong hội đồng thư ký
enum EvaluationSecretaryMemberRole {
  HEAD_SECRETARY // Trưởng ban thư ký
  MEMBER // Uỷ viên

  @@schema("khao-thi")
}

model EvaluationSecretaryMember extends Base {
  lecturer                     Lecturer                      @relation(fields: [lecturerId], references: [id])
  lecturerId                   String
  evaluationSecretarYCouncil   EvaluationSecretarYCouncil    @relation(fields: [evaluationSecretarYCouncilId], references: [id])
  evaluationSecretarYCouncilId String
  role                         EvaluationSecretaryMemberRole

  @@schema("khao-thi")
}

model EvidenceFile extends Base {
  name          String
  path          String
  mimeType      String
  size          BigInt

  evidence      Evidence     @relation(fields: [evidenceId], references: [id])
  evidenceId    String

  userProfile   UserProfile? @relation(fields: [userProfileId], references: [id])
  userProfileId String?

  @@schema("khao-thi")
}