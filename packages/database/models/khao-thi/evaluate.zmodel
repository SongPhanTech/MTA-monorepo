import '../base'
import '../ql-dao-tao/plan-training'
import '../ql-dao-tao/student'
import '../ql-dao-tao/categories'
import '../ql-ho-so/profile'
import '../ql-dao-tao/lecturer'
import '../ql-danh-muc/document'

/// Trạng thái đợt đánh giá
enum EvaluationPeriodStatus {
  COUNCIL_ESTABLISHED      // Thành lập hội đồng
  ASSIGNMENT               // Phân công đánh giá
  ANALYSIS_WRITING         // Viết phiếu phân tích
  SECRETARY_REVIEW         // Xét duyệt Ban thư ký (Phê duyệt)
  DIRECTOR_REVIEW          // Xét duyệt Trưởng ban thư ký (Phê duyệt)
  EVALUATION_WRITING       // Viết phiếu đánh giá
  CROSS_REVIEW_ASSIGNMENT  // Phân công phản biện chéo
  CROSS_REVIEW             // Phản biện chéo
  CONSOLIDATION            // Tổng hợp phiếu đánh giá
  COUNCIL_APPROVAL         // Xét duyệt cuối cùng (Hội đồng)
  COMPLETED                // Hoàn thành (P13 đóng)

  @@schema("khao-thi")
}
enum StandardCatalogType {
  ASSET // Cơ sở vật chất
  PROGRAM // CTĐT
  @@schema("khao-thi")
}

/// Đợt đánh giá CTDT
model EvaluationPeriod extends Base {
  name            String
  startDate       DateTime               @default(now())
  endDate         DateTime?
  status          EvaluationPeriodStatus @default(COUNCIL_ESTABLISHED)
  schoolYear      SchoolYear?            @relation(fields: [schoolYearId], references: [id])
  schoolYearId    String?
  standards       StandardPeriod[]
  council         EvaluationCouncil?
  documentFiles   DocumentFile[]
  overviewProblem String? // Đặt vấn đề
  overviewGeneral String? // Tổng quan chung
  overviewResults String? // Kết quả rà soát việc đáp ứng
  conclude        String? // Kết luận

  @@schema("khao-thi")
}

//Bộ tiêu chuẩn và tiêu chí đánh giá theo năm
model EvaluationStandardSet extends Base {
  name       String              @unique

  objectType StandardCatalogType
  standards  StandardCatalog[]

  @@schema("khao-thi")
}

/// Danh mục tiêu chuẩn
model StandardCatalog extends Base {
  order         Int
  name          String
  criteria      CriterionCatalog[]
  standardSet   EvaluationStandardSet? @relation(fields: [standardSetId], references: [id])
  standardSetId String?

  objectType    StandardCatalogType

  @@schema("khao-thi")
}

/// Danh mục tiêu chí
model CriterionCatalog extends Base {
  standard                    StandardCatalog               @relation(fields: [standardId], references: [id])
  standardId                  String
  order                       Int
  name                        String

  requirementCriterionCatalog RequirementCriterionCatalog[]

  @@unique([standardId, name])
  @@schema("khao-thi")
}

/// Nhóm minh chứng - require code
model EvidenceCategory extends Base {
  name      String

  evidences Evidence[]

  @@schema("khao-thi")
}

/// Danh mục minh chứng
model Evidence extends Base {
  category             EvidenceCategory       @relation(fields: [categoryId], references: [id])
  categoryId           String
  name                 String
  information          String // Số, ngày ban hành, hoặc thời điểm khảo sát, điều tra, phỏng vấn, quan sát,…
  issuer               String // Nơi ban hành hoặc nhóm, cá nhân thực hiện

  evidenceFile         EvidenceFile[]
  analysisFormEvidence AnalysisFormEvidence[]

  @@schema("khao-thi")
}

enum EvaluationCriterionStatus {
  PENDING      //Chưa nộp
  SUBMITTED    //Đã nộp
  REVISION     //Yêu cầu chỉnh sửa
  APPROVED     //Đã duyệt
  COMPLETED    //Hoàn thành

  @@schema("khao-thi")
}

enum EvaluationStatus {
  LOCK         //Khoá
  PENDING      //Chưa nộp
  SUBMITTED    //Đã nộp
  REVISION     //Yêu cầu chỉnh sửa
  APPROVED     //Đã duyệt
  COMPLETED    //Hoàn thành

  @@schema("khao-thi")
}


//Comment 
model EvaluationCriterionComment extends Base {
  reviewer               UserProfile           @relation(fields: [reviewerId], references: [id])
  reviewerId             String                @db.Uuid

  requirementCriterion   RequirementCriterion? @relation(fields: [requirementCriterionId], references: [id], onDelete: Cascade)
  requirementCriterionId String?

  content                String?               @db.Text

  analysisCriterion      AnalysisCriterion?    @relation(fields: [analysisCriterionId], references: [id])
  analysisCriterionId    String?
  evaluationCriterion    EvaluationCriterion?  @relation(fields: [evaluationCriterionId], references: [id])
  evaluationCriterionId  String?

  @@schema("khao-thi")
}


/// Danh mục yêu cầu
model RequirementCriterionCatalog extends Base {
  criterionCatalog   CriterionCatalog @relation(fields: [criterionCatalogId], references: [id])
  criterionCatalogId String
  order              Int
  name               String
  questions          String[]

  @@unique([criterionCatalogId, name])
  @@schema("khao-thi")
}

/// Tiêu chuẩn của đợt (Bản sao/áp dụng từ StandardCatalog)
model StandardPeriod extends Base {
  period     EvaluationPeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  periodId   String
  name       String
  order      Int

  /// Mở đầu
  opening    String            @default("")
  /// Kết luận
  conclusion String            @default("")

  criteria   CriterionPeriod[]


  @@unique([periodId, name])
  @@schema("khao-thi")
}

/// Tiêu chí của đợt (Bản sao/áp dụng từ StandardCatalog)
model CriterionPeriod extends Base {
  name                 String
  order                Int

  evaluationStandard   StandardPeriod       @relation(fields: [evaluationStandardId], references: [id])
  evaluationStandardId String
  analysisCriterions   AnalysisCriterion?
  evaluationCriterion  EvaluationCriterion?
  @@schema("khao-thi")
}

/// Phiếu phân tích của đợt (Bản sao/áp dụng từ CriterionCatalog)
model AnalysisCriterion extends Base {
  criterionPeriod             CriterionPeriod              @relation(fields: [criterionPeriodId], references: [id])
  criterionPeriodId           String                       @unique

  // người được phân công làm phiếu phân tích
  lecturer                    Lecturer?                    @relation(fields: [lecturerId], references: [id])
  lecturerId                  String?
  deadline                    DateTime?

  status                      EvaluationCriterionStatus    @default(PENDING)

  /// Yêu cầu trong phiếu phân tích
  requirementCriterions       RequirementCriterion[]

  evaluationCriterionComments EvaluationCriterionComment[]


  @@schema("khao-thi")
}

/// Phiếu đánh giá của đợt (Bản sao/áp dụng từ CriterionCatalog)
model EvaluationCriterion extends Base {
  criterionPeriod             CriterionPeriod              @relation(fields: [criterionPeriodId], references: [id])
  criterionPeriodId           String                       @unique

  // người được phân công làm phiếu phân tích
  lecturer                    Lecturer?                    @relation("EvaluationCriterionLecturer", fields: [lecturerId], references: [id])
  lecturerId                  String?
  deadline                    DateTime?

  status                      EvaluationStatus             @default(LOCK)

  reviewer                    EvaluationCouncilMember?     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewerId                  String?
  deadlineReview              DateTime?
  deadlineReviewExternal      DateTime?

  lecturerReview              Lecturer[]                   @relation("EvaluationCriterionLecturerReview")

  evaluationCriterionComments EvaluationCriterionComment[]

  // Phiếu đánh giá
  /// 1. Mô tả hiện trạng
  currentSituation            String                       @default("")
  /// 2. Điểm mạnh
  strengths                   String                       @default("")
  /// 3. Điểm tồn tại
  weakness                    String                       @default("")
  /// 4. Kế hoạch hành động
  actionPlan                  String                       @default("")
  /// 5. Tự đánh giá
  score                       String                       @default("")

  @@schema("khao-thi")
}

/// Yêu cầu trong phiếu phân tích tiêu chí
model RequirementCriterion extends Base {
  analysisCriterion          AnalysisCriterion            @relation(fields: [analysisCriterionId], references: [id])
  analysisCriterionId        String
  order                      Int
  name                       String
  questions                  String[]

  evidences                  AnalysisFormEvidence[]
  evidencePlaces             String                       @default("")
  collectionMethod           String                       @default("")

  evaluationCriterionComment EvaluationCriterionComment[]

  @@schema("khao-thi")
}

/// Minh chứng phiếu phân tích
model AnalysisFormEvidence extends Base {
  requirementCriterion   RequirementCriterion @relation(fields: [requirementCriterionId], references: [id])
  requirementCriterionId String
  evidence               Evidence             @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  evidenceId             String
  order                  Int

  @@unique([requirementCriterionId, evidenceId])
  @@schema("khao-thi")
}

/// Vai trò của thành viên trong hội đồng đánh giá
enum EvaluationMemberRole {
  CHAIRMAN // Chủ tịch hội đồng
  VICE_PRESIDENT // Phó chủ tịch
  HEAD_SECRETARY // Truỏng ban thư ký
  SECRETARY // Thư ký
  MEMBER // Uỷ viên
  ADVISORY_BOARD // Ban tư vấn
  HEAD_SPECIALIZED // Trưởng nhóm chuyên trách
  SPECIALIZED // nhóm chuyên trách
  NONCOUNCIL_MEMBERS // Thành viên không thuộc hội đồng

  @@schema("khao-thi")
}


/// Hội đồng đánh giá
model EvaluationCouncil extends Base {
  period   EvaluationPeriod          @relation(fields: [periodId], references: [id], onDelete: Cascade)
  periodId String                    @unique
  name     String

  members  EvaluationCouncilMember[]

  @@schema("khao-thi")
}

/// Thành viên hội đồng đánh giá
model EvaluationCouncilMember extends Base {
  evaluationCouncil    EvaluationCouncil     @relation(fields: [evaluationCouncilId], references: [id], onDelete: Cascade)
  evaluationCouncilId  String
  lecturer             Lecturer              @relation(fields: [lecturerId], references: [id])
  lecturerId           String

  // dùng cho nhóm chuyên trách
  groupName            String?
  role                 EvaluationMemberRole?

  evaluationCriterions EvaluationCriterion[]

  @@schema("khao-thi")
}


model EvidenceFile extends Base {
  name          String
  path          String
  mimeType      String
  size          BigInt

  evidence      Evidence     @relation(fields: [evidenceId], references: [id])
  evidenceId    String

  userProfile   UserProfile? @relation(fields: [userProfileId], references: [id])
  userProfileId String?      @db.Uuid

  @@schema("khao-thi")
}