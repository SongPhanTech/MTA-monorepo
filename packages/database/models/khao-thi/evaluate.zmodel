import '../base'
import '../ql-dao-tao/plan-training'
import '../ql-dao-tao/student'
import '../ql-dao-tao/categories'


// Đợt đánh giá CTDT
model EvaluationSession extends Base {
  startTime DateTime              @default(now())
  endTime   DateTime?
  name      String

  @@schema("khao-thi")
}

// Vai trò của thành viên trong hội đồng đánh giá
enum EvaluationMemberRole {
  CHAIRMAN // Chủ tịch hội đồng
  SECRETARY // Thư ký
  MEMBER // Thành viên

  @@schema("khao-thi")
}

model EvaluationDecision extends Base {
  name String

  @@schema("khao-thi")
}

