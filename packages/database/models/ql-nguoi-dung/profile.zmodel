import '../base'
import '../ql-nguoi-dung/user'
import '../ql-danh-muc/user'
import '../ql-danh-muc/common'
import '../ql-dao-tao/plan-training'

model UserProfile extends Base {
  user                   User?               @relation(fields: [userId], references: [id])
  userId                 String?             @unique
  userType               UserType            @relation(fields: [userTypeId], references: [id]) // loại đối tượng
  userTypeId             String
  avatar                 String?             // đường dẫn ảnh đại diện

  // Thông tin cá nhân
  firstName              String
  lastName               String
  dateOfBirth            DateTime?  // ngày sinh
  placeOfBirth           String? // nơi sinh
  homeTown               String? // quê quán
  idCardNumber           String? // số căn cước công dân
  idCardDate             DateTime? // ngày cấp
  officerNumber          String? // số hiệu sĩ quan

  priorityObject         PriorityObject?     @relation(fields: [priorityObjectId], references: [id]) // đối tượng ưu tiên
  priorityObjectId       String?
  registrationArea       RegistrationArea?   @relation(fields: [registrationAreaId], references: [id]) // khu vực đăng ký
  registrationAreaId     String?
  nationality            Nationality?        @relation(fields: [nationalityId], references: [id]) // quốc tịch
  nationalityId          String?
  religion               Religion?           @relation(fields: [religionId], references: [id]) // tôn giáo
  religionId             String?
  ethnicity              Ethnicity?          @relation(fields: [ethnicityId], references: [id]) // dân tộc
  ethnicityId            String?
  gender                 Gender?
  permanentAddress       String? // địa chỉ thường trú
  temporaryAddress       String? // địa chỉ tạm trú
  contactAddress         String? // địa chỉ liên hệ
  phoneNumber            String? // số điện thoại
  email                  String? // email

  parentPhoneNumber      String? // số điện thoại phụ huynh
  parentName             String? // tên phụ huynh


  // thông tin đoàn thể
  unionDate              DateTime? // ngày vào Đoàn
  unionPlace             String? // nơi vào Đoàn
  // ngày vào Đảng (ĐẢNG CỘNG SẢN VIỆT NAM – COMMUNIST PARTY OF VIET NAM (CPV) )
  CPVJoinDate            DateTime? // ngày vào Đảng
  officialCPVDate        DateTime? // ngày chính thức
  CPVJoinPlace           String? // nơi vào Đảng
  tenureDate             DateTime? // ngày vào biên chế
  enlistmentDate         DateTime? // ngày nhập ngũ
  dischargeDate          DateTime? // ngày xuất ngũ
  
  // thông tin thay đổi (có bảng lịch sử riêng)
  rankName               String? // cấp bậc hàm
  educationLevel         String? // trình độ học vấn
  academicDegreeTypeName String? // học hàm
  academicRankTypeName   String? // học vị
  positionName           String? // chức vụ chính quyền
  positionCPVName        String? // chức vụ Đảng
  organizationName       String? // đơn vị
  organizationCPVName    String? // nơi sinh hoạt Đảng

  fixedClassStudent      FixedClassStudent[]
  organizationUser       OrganizationUser[]

  @@schema("ql-nguoi-dung")
}


enum FixedClassStudentStatus {
  ENROLLED  // Đang học: Sinh viên đang theo học tại trường.
  GRADUATED  // Tốt nghiệp: Sinh viên đã hoàn thành chương trình đào tạo và được công nhận tốt nghiệp.
  DEFERRED_STUDY  // Bảo lưu: Sinh viên tạm ngưng học có lý do chính đáng.
  SUSPENDED_STUDY  // Tạm ngưng học: Sinh viên tạm ngưng học không có lý do chính đáng.
  WITHDRAWN // Thôi học: Sinh viên đã ngừng học tại trường.
  TRANSFERRED  // Chuyển trường: Sinh viên đã chuyển sang trường khác.
  PENDING_GRADUATION_REVIEW  // Chờ xét tốt nghiệp: Sinh viên đã hoàn thành chương trình đào tạo nhưng chưa được công nhận tốt nghiệp.
  ACADEMIC_SUSPENSION  // Đình chỉ học: Sinh viên bị đình chỉ học do lý do kỷ luật hoặc lý do khác.
  @@schema("ql-nguoi-dung")
}

// học viên - lớp biên chế
model FixedClassStudent {
  id            String                  @id @default(cuid())
  fixedClass    FixedClass              @relation(fields: [fixedClassId], references: [id])
  fixedClassId  String
  userProfile   UserProfile             @relation(fields: [userProfileId], references: [id])
  userProfileId String
  status        FixedClassStudentStatus @default(ENROLLED)
  description   String?                 @db.Text
  deletedAt     DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime?               @updatedAt
  @@schema("ql-nguoi-dung")
}

// người dùng - đơn vị

enum OrganizationUserStatus {
  ACTIVE   // Hoạt động: Người dùng đang hoạt động trong đơn vị.
  INACTIVE // Không hoạt động: Người dùng không còn hoạt động trong đơn vị.
  ON_HOLD // Tạm dừng do công tác khác (đi học, đi công tác, nghỉ phép...): Người dùng tạm thời không tham gia vào các hoạt động của đơn vị.
  TERMINATED // Kết thúc hợp đồng: Người dùng đã kết thúc hợp đồng.
  @@schema("ql-nguoi-dung")
}

model OrganizationUser extends Base {
  userProfileId  String
  userProfile    UserProfile            @relation(fields: [userProfileId], references: [id])
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id])
  position       Position?              @relation(fields: [positionId], references: [id])
  positionId     String?
  status         OrganizationUserStatus @default(ACTIVE)

  @@schema("ql-nguoi-dung")
}
