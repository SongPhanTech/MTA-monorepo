import '../base'
import '../tro-ly-ao/chat-bot'
import 'feedback'
import 'profile'
import '../khao-thi/survey'

model User extends Base {
  email            String         @unique @email
  userName         String         @unique
  name             String
  systemRole       UserRole       @default(USER)
  ssoId            String?        @unique
  phone            String?        @unique
  role             String?
  groups           Group[]

  feedback         Feedback[]
  userProfile      UserProfile[]
  conversation     Conversation[]
  documentUploaded Document[]     @relation("DocumentUploaded")
  documentApproved Document[]     @relation("DocumentApproved")
  fAQUploaded      FAQ[]          @relation("FAQUploaded")
  fAQApproved      FAQ[]          @relation("FAQApproved")
  surveyAnswered   SurveyAnswer[] @relation("SurveyAnswer")


  @@schema("ql-nguoi-dung")
}

enum UserRole {
  ADMIN
  USER
  @@schema("ql-nguoi-dung")
}

model Group extends Base {
  name  String
  users User[]
  roles Role[]
  @@schema("ql-nguoi-dung")
}

model Role extends Base {
  name        String
  groups      Group[]
  permissions Permission[]
  @@schema("ql-nguoi-dung")
}

model Permission extends Base {
  name           String
  permissionType PermissionType
  disabled       Boolean        @default(false)

  role           Role[]

  @@unique([name, permissionType])
  @@schema("ql-nguoi-dung")
}

enum PermissionType {
  CREATE
  READ
  UPDATE
  DELETE
  APPROVE
  DETAIL
  @@schema("ql-nguoi-dung")
}
