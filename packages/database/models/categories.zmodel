import 'base'


model Province extends Base {
  name     String     @unique

  district District[]
}

model District extends Base {
  name       String
  province   Province  @relation(fields: [provinceId], references: [id])
  provinceId String

  commune    Commune[]
  @@unique([name, provinceId])
}
model Commune extends Base {
  name       String
  district   District @relation(fields: [districtId], references: [id])
  districtId String

  @@unique([name, districtId])
}

model Level extends Base {
  name String @unique
}
// cấp bậc hàm
model Rank extends Base {
  name String @unique
}

// học hàm
model AcademicDegreeType extends Base {
  name String @unique
}

// học vị
model AcademicRankType extends Base {
  name String @unique
}

// chức vụ
model Position extends Base {
  name String @unique
}

// loại đơn vị
model OrganizationType extends Base {
  name          String         @unique
  organizations Organization[] 
}

// đơn vị
model Organization extends Base {
  name String @unique
  type OrganizationType @relation(fields: [typeId], references: [id])
  typeId String
  address String
}