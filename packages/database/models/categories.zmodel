import 'base'
import 'plantraining'
import 'user_info'

model Province extends Base {
  name     String

  Commune Commune[]
}

model Commune extends Base {
  name       String
  Province   Province @relation(fields: [provinceId], references: [id])
  provinceId String
  @@unique([name, provinceId])
}

model Level extends Base {
  name String
}
// cấp bậc hàm
model Rank extends Base {
  name String
}

// học hàm
model AcademicDegreeType extends Base {
  name String
}

// học vị
model AcademicRankType extends Base {
  name String
}

// chức vụ
model Position extends Base {
  name String
}

// chức vụ Đảng
model PositionCPV extends Base {
  name String
}

// loại đơn vị
model OrganizationType extends Base {
  name          String
  organizations Organization[]
}

// đơn vị
model Organization extends Base {
  name    String           @unique
  type    OrganizationType @relation(fields: [typeId], references: [id])
  typeId  String
  parent  Organization? @relation("ParentChild")
  parentId String?
  children Organization[] @relation("ParentChild")
  address String

	curriculum Curriculum[]
	fixedClass FixedClass[]
}