import '../base'
import '../ql-dao-tao/plan-training'
import '../ql-dao-tao/training-action'
import '../ql-dao-tao/thesis'
import '../ql-dao-tao/categories'
import '../ql-dao-tao/ranking'
import 'notification'
import '../ql-dao-tao/note.zmodel'

model DocumentFile extends Base {
  name                       String
  path                       String
  size                       BigInt
  mimeType                   String?

  archivedCertificate        ArchivedCertificate?            @relation(fields: [archivedCertificateId], references: [id])
  archivedCertificateId      String?

  trainingCourse             TrainingCourse?                 @relation(fields: [trainingCourseId], references: [id])
  trainingCourseId           String?

  archivedAward              ArchivedAward?                  @relation(fields: [archivedAwardId], references: [id])
  archivedAwardId            String?

  curriculum                 Curriculum?                     @relation(fields: [curriculumId], references: [id])
  curriculumId               String?

  curriculumVersion          CurriculumVersion?              @relation(fields: [curriculumVersionId], references: [id])
  curriculumVersionId        String?

  subjectVersion             SubjectVersion?                 @relation(fields: [subjectVersionId], references: [id])
  subjectVersionId           String?

  studentAcademicDecision    StudentAcademicDecision?        @relation(fields: [studentAcademicDecisionId], references: [id])
  studentAcademicDecisionId  String?

  notification               Notification?                   @relation(fields: [notificationId], references: [id])
  notificationId             String?

  decision                   Decision?                       @relation(fields: [decisionId], references: [id])
  decisionId                 String?

  defenseRecord              DefenseRecord?                  @relation(fields: [defenseRecordId], references: [id])
  defenseRecordId            String?

  diplomaFront               GraduationDecision?             @relation(name: "DiplomaFront", fields: [diplomaFrontId], references: [id])
  diplomaFrontId             String?                         @unique
  diplomaBack                GraduationDecision?             @relation(name: "DiplomaBack", fields: [diplomaBackId], references: [id])
  diplomaBackId              String?                         @unique

  diplomaVerification        DiplomaVerificationApplication? @relation(name: "DiplomaVerificationAttachments", fields: [diplomaVerificationId], references: [id])
  diplomaVerificationId      String?                         @unique
  diplomaVerificationFront   DiplomaVerificationApplication? @relation(name: "DiplomaVerificationFront", fields: [diplomaVerificationFrontId], references: [id])
  diplomaVerificationFrontId String?                         @unique
  diplomaVerificationBack    DiplomaVerificationApplication? @relation(name: "DiplomaVerificationBack", fields: [diplomaVerificationBackId], references: [id])
  diplomaVerificationBackId  String?                         @unique
  trainingField              TrainingField?                  @relation(fields: [trainingFieldId], references: [id])
  trainingFieldId            String?

  // THÊM MỚI:
  note                       Note?                           @relation(fields: [noteId], references: [id])
  noteId                     String?

  @@schema("ql-danh-muc")
}