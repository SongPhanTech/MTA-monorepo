import '../ql-dao-tao/plan-training'
import '../ql-nguoi-dung/profile'
import '../ql-dao-tao/categories'
import '../ql-dao-tao/lecturer'
import '../ql-dao-tao/staff'
import '../ql-dao-tao/student'

abstract model CoreBase {
  Id             String    @id() @default(cuid())
  sMa            String?   @unique
  sGhiChu        String?
  iSTT           Int?      @default(0)
  bActive        Boolean?  @default(true)
  bDeleted       Boolean?  @default(false)
  bSystem        Boolean?  @default(false)
  iDictionaryKey Int?      @default(0)
  dNgayTao       DateTime?
  dNgaySua       DateTime?
  sNguoiTao      String?
  sNguoiSua      String?
  sThietBiTao    String?
  sThietBiSua    String?

  @@schema("mta")

  // TODO: change this
  @@allow('all', auth() != null)

  @@deny('read', bDeleted == true)
  /// TODO: allow all for now, will be restricted later
  // @@allow('all', auth().role == 'ADMIN')
  @@allow('read', auth() != null)
}

model DM_CapBac extends CoreBase {
  sTen     String        @unique
  profiles UserProfile[]
  @@schema("mta")
}

model DM_ChucDanh extends CoreBase {
  sTen             String             @unique
  iLoaiChucDanh    Int?               @default(0)
  DM_ViTriCongViec DM_ViTriCongViec[]
  userProfile      UserProfile[]
  @@schema("mta")
}

model DM_ChucVu extends CoreBase {
  sTen        String        @unique
  userProfile UserProfile[]
  @@schema("mta")
}

model DM_HocHam extends CoreBase {
  sTen     String        @unique
  profiles UserProfile[]
  @@schema("mta")
}

model DM_HocVi extends CoreBase {
  sTen     String        @unique
  profiles UserProfile[]
  @@schema("mta")
}

model DM_ChungChiTinHoc extends CoreBase {
  sTen String @unique
  @@schema("mta")
}

model DM_DanToc extends CoreBase {
  sTen         String        @unique
  sTenKhac     String?
  sDiaChiCuTru String?

  userProfile  UserProfile[]

  @@schema("mta")
}

model DM_DonVi extends CoreBase {
  sTen             String            @unique
  sCode            String?           @unique
  sTenVietTat      String?
  sParentId        String?
  sTruongDonVi     String?
  sChucNangNhiemVu String?
  sDiaChi          String?
  DM_NhanVien      DM_NhanVien[]

  parent           DM_DonVi?         @relation("DM_DonVi_Parent", fields: [sParentId], references: [Id], map: "FK_DM_DonVi_iParentId_DM_DonVi_Id")
  children         DM_DonVi[]        @relation("DM_DonVi_Parent")

  lecturers        Lecturer[]
  lecturerHistory  LecturerHistory[]
  staffs           Staff[]
  staffHistory     StaffHistory[]

  curriculum       Curriculum[]
  fixedClass       FixedClass[]
  subjectVersions  SubjectVersion[]
  subjects         Subject[]
  trainingFields   TrainingField[]
  trainingMajors   TrainingMajor[]
  @@index([sParentId], map: "IX_DM_DonVi_iParentId")
  @@index([sMa], map: "IX_DM_DonVi_sMa")
  @@schema("mta")
}

model DM_DonViHanhChinh extends CoreBase {
  sTen     String         @unique
  sTen_En  String?

  tinh     DM_Tinh[]
  huyen    DM_QuanHuyen[]
  xaPhuong DM_XaPhuong[]
  @@schema("mta")
}

model DM_KhuVuc_DiaLy extends CoreBase {
  sTen    String    @unique
  sTen_En String?

  tinh    DM_Tinh[]
  student Student[]
  @@schema("mta")
}

model DM_NgoaiNgu extends CoreBase {
  sTen String @unique
  @@schema("mta")
}

model DM_TonGiao extends CoreBase {
  sTen        String        @unique
  userProfile UserProfile[]
  @@schema("mta")
}

model DM_TrinhDoNgoaiNgu extends CoreBase {
  sTen   String  @unique
  sKhung String?
  @@schema("mta")
}

model DM_TrinhDoTinHoc extends CoreBase {
  sTen String @unique
  @@schema("mta")
}

model DM_UngDung extends CoreBase {
  sTen             String   @unique
  sMoTa            String?
  sLogoUrl         String?
  sUrl             String?
  bTatCaNguoiDung  Boolean? @default(false)
  bTatCaNhanVien   Boolean? @default(false)
  sClientId        String?
  sClientSecret    String?
  sRedirectDefault String?
  @@schema("mta")
}

model DM_NhanVien extends CoreBase {
  sHoVaDem            String?
  sTenDayDu           String?
  dNgaySinh           DateTime?
  iGioiTinh           Int?
  sDiaChi             String?
  sSDTDiDong          String?
  sEmail              String?
  bLaNguoiDung        Boolean?
  DM_DonVi            DM_DonVi?            @relation(fields: [sDM_DonViId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "FK_DM_NhanVien_DM_DonVi")
  sDM_DonViId         String?
  DM_ViTriCongViec    DM_ViTriCongViec?    @relation(fields: [sDM_ViTriCongViecId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "FK_DM_NhanVien_DM_ViTriCongViec")
  sDM_ViTriCongViecId String?
  sQuanlyTrucTiepId   String?
  sAvatarId           String?

  taiKhoan            TaiKhoan?
  NguoiDungTrongNhom  NguoiDungTrongNhom[]
  Quyen_VaiTro        Quyen_VaiTro[]
  nhatKyHoatDong      NhatKyHoatDong[]

  @@index([sDM_DonViId], map: "IX_DM_NhanVien_sDM_DonViId")
  @@index([sDM_ViTriCongViecId], map: "IX_DM_NhanVien_sDM_ViTriCongViecId")
  @@index([sEmail], map: "IX_DM_NhanVien_sEmail")
  @@index([sSDTDiDong], map: "IX_DM_NhanVien_sSDTDiDong")

  @@auth()
  @@schema("mta")
}

model DM_NhomNguoiDung extends CoreBase {
  sTen               String               @unique
  vaiTroTrongNhom    VaiTroTrongNhom[]
  nguoiDungTrongNhom NguoiDungTrongNhom[]
  @@schema("mta")
}

model DM_NhomUngDung extends CoreBase {
  sTen  String  @unique
  sMoTa String?
  @@schema("mta")
}

model DM_QuocGia extends CoreBase {
  sTen        String        @unique
  sLanguage   String?

  userProfile UserProfile[]
  tinh        DM_Tinh[]
  @@schema("mta")
}

model DM_Tinh extends CoreBase {
  sTen                        String             @unique
  quocGia                     DM_QuocGia?        @relation(fields: [sDM_QuocGiaId], references: [Id])
  sDM_QuocGiaId               String?
  dM_KhuVuc_DiaLy             DM_KhuVuc_DiaLy?   @relation(fields: [iDM_KhuVucDiaLy_Id], references: [Id])
  iDM_KhuVucDiaLy_Id          String?
  dM_DonViHanhChinh           DM_DonViHanhChinh? @relation(fields: [iDM_DonViHanhChinhId], references: [Id])
  iDM_DonViHanhChinhId        String?

  huyen                       DM_QuanHuyen[]
  xaPhuong                    DM_XaPhuong[]
  userProfileHometown         UserProfile[]      @relation("ProvinceHometown")
  userProfilePlaceOfBirth     UserProfile[]      @relation("ProvincePlaceOfBirth")
  userProfilePermanentAddress UserProfile[]      @relation("ProvincePermanentAddress")
  userProfileCurrentAddress   UserProfile[]      @relation("ProvinceCurrentAddress")

  @@index([sDM_QuocGiaId], map: "IX_DM_Tinh_iDM_QuocGiaId")
  @@schema("mta")
}

model DM_QuanHuyen extends CoreBase {
  sTen                        String
  dM_Tinh                     DM_Tinh?           @relation(fields: [sDM_TinhId], references: [Id])
  sDM_TinhId                  String?
  sDM_Tinh_Ma                 String?
  dM_DonViHanhChinh           DM_DonViHanhChinh? @relation(fields: [iDM_DonViHanhChinhId], references: [Id])
  iDM_DonViHanhChinhId        String?

  xaPhuong                    DM_XaPhuong[]
  userProfileHometown         UserProfile[]      @relation("DistrictHometown")
  userProfilePlaceOfBirth     UserProfile[]      @relation("DistrictPlaceOfBirth")
  userProfilePermanentAddress UserProfile[]      @relation("DistrictPermanentAddress")
  userProfileCurrentAddress   UserProfile[]      @relation("DistrictCurrentAddress")

  @@unique([sDM_TinhId, sTen])
  @@index([sDM_TinhId], map: "IX_DM_QuanHuyen_iDM_TinhId")
  @@schema("mta")
}

model DM_XaPhuong extends CoreBase {
  sTen                        String
  sDM_TinhId                  String?
  quanHuyen                   DM_QuanHuyen?      @relation(fields: [sDM_QuanHuyenId], references: [Id])
  sDM_QuanHuyenId             String?
  sDM_QuanHuyen_Ma            String?
  dM_Tinh                     DM_Tinh?           @relation(fields: [dM_TinhId], references: [Id])
  dM_TinhId                   String?
  dM_DonViHanhChinh           DM_DonViHanhChinh? @relation(fields: [iDM_DonViHanhChinhId], references: [Id])
  iDM_DonViHanhChinhId        String?

  userProfileHometown         UserProfile[]      @relation("CommuneHometown")
  userProfilePlaceOfBirth     UserProfile[]      @relation("CommunePlaceOfBirth")
  userProfilePermanentAddress UserProfile[]      @relation("CommunePermanentAddress")
  userProfileCurrentAddress   UserProfile[]      @relation("CommuneCurrentAddress")

  @@unique([sDM_QuanHuyenId, sTen])
  @@index([sDM_QuanHuyenId], map: "IX_DM_XaPhuong_iDM_QuanHuyenId")
  @@schema("mta")
}

model DM_VaiTro extends CoreBase {
  sTen            String            @unique
  Quyen_VaiTro    Quyen_VaiTro[]
  VaiTroTrongNhom VaiTroTrongNhom[]
  @@schema("mta")
}

model DM_ViTriCongViec extends CoreBase {
  sTen            String        @unique
  sDM_ChucDanhId  String?
  sDM_NhomViTriId String
  DM_NhanVien     DM_NhanVien[]
  DM_ChucDanh     DM_ChucDanh?  @relation(fields: [sDM_ChucDanhId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "FK_DM_ViTriCongViec_DM_ChucDanh")
  @@schema("mta")
}

model NguoiDungTrongNhom extends CoreBase {
  DM_NhomNguoiDung    DM_NhomNguoiDung? @relation(fields: [sDM_NhomNguoiDungId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "FK_NguoiDungTrongNhom_DM_NhomNguoiDung")
  sDM_NhomNguoiDungId String?
  DM_NhanVien         DM_NhanVien?      @relation(fields: [sDM_NhanVienId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "FK_NguoiDungTrongNhom_DM_NhanVien")
  sDM_NhanVienId      String?

  @@unique([sDM_NhomNguoiDungId, sDM_NhanVienId])
  @@schema("mta")
}

model NhatKyHoatDong extends CoreBase {
  DM_NhanVien    DM_NhanVien? @relation(fields: [sNhanVienId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Quyen_VaiTro_DM_NhanVien")
  sNhanVienId    String?
  dLogTime       DateTime?
  iState         Int?
  sObjectName    String?
  sReferenceName String?
  sDescription   String?
  sIPAddress     String?
  @@schema("mta")
}

model Policy extends CoreBase {
  sTen           String   @unique
  bXacThuc2YeuTo Boolean? @default(false)
  bGioiHanTCIP   Boolean? @default(false)
  bGioiHanTG     Boolean? @default(false)
  iApDungChoUD   Int?     @default(0)
  @@schema("mta")
}

model Quyen_VaiTro extends CoreBase {
  sTen           String       @unique
  sTenChucNang   String?      @default("N'Tên quyền'")
  sDM_NhanVienId String?
  sDM_VaiTroId   String?
  fValue         Int?
  DM_NhanVien    DM_NhanVien? @relation(fields: [sDM_NhanVienId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Quyen_VaiTro_DM_NhanVien")
  DM_VaiTro      DM_VaiTro?   @relation(fields: [sDM_VaiTroId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Quyen_VaiTro_DM_VaiTro")
  @@schema("mta")
}

model TaiKhoan extends CoreBase {
  sTen           String
  sUserName      String?      @unique
  sAvatar        String?
  sDM_NhanVienId String?      @unique // TODO: maybe remove unique constraint

  nhanVien       DM_NhanVien? @relation(fields: [sDM_NhanVienId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "FK_TaiKhoan_DM_NhanVien")
  @@schema("mta")
}

model VaiTroTrongNhom extends CoreBase {
  dM_NhomNguoiDung    DM_NhomNguoiDung? @relation(fields: [sDM_NhomNguoiDungId], references: [Id])
  sDM_NhomNguoiDungId String?
  DM_VaiTro           DM_VaiTro?        @relation(fields: [sDM_VaiTroId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "FK_VaiTroTrongNhom_DM_VaiTro")
  sDM_VaiTroId        String?
  @@schema("mta")
}
