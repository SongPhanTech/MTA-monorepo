import '../ql-dao-tao/plan-training'
import '../ql-ho-so/profile'
import '../ql-dao-tao/categories'
import '../ql-dao-tao/lecturer'
import '../ql-dao-tao/staff'
import '../ql-dao-tao/student'
import '../ql-dao-tao/research'
import '../ql-dao-tao/thesis'
import '../ql-nguoi-dung/user'
import '../ql-nguoi-dung/feedback'
import '../tro-ly-ao/chat-bot'
import 'notification'
import "../khao-thi/survey"

abstract model CoreBase {
  Id             String    @id() @default(uuid()) @db.Uuid
  sMa            String?
  sTen           String?
  sGhiChu        String?
  iSTT           Int?      @default(0)
  bActive        Boolean?  @default(true)
  bDeleted       Boolean?  @default(false)
  bSystem        Boolean?  @default(false)
  iDictionaryKey Int?      @default(0)
  dNgayTao       DateTime?
  dNgaySua       DateTime?
  sNguoiTao      String?
  sNguoiSua      String?
  sThietBiTao    String?
  sThietBiSua    String?

  @@schema("mta")

  // TODO: change this
  @@allow('all', auth() != null)

  @@deny('read', bDeleted == true)
  /// TODO: allow all for now, will be restricted later
  // @@allow('all', auth().role == 'ADMIN')
  @@allow('read', auth() != null)
}

model DM_CapBac extends CoreBase {
  profiles UserProfile[]
  capBac   CapBac[]
  @@schema("mta")
}

model DM_ChucDanh extends CoreBase {
  iLoaiChucDanh Int?          @default(0)
  userProfile   UserProfile[]
  @@schema("mta")
}

model DM_ChucVu extends CoreBase {
  // 0: Chức vụ chính quyền, 1: Chức vụ Đảng
  iNhomChucVu         Int?                  @default(0)
  userProfileCPV      UserProfile[]         @relation("positionCPV")
  userProfile         UserProfile[]         @relation("chucVuChinhQuyen")
  userProfilePosition UserProfile[]         @relation("position")
  quaTrinhCongTac     QuaTrinhCongTac[]
  quaTrinhCuDiCongTac QuaTrinhCuDiCongTac[]
  chucVuChinhQuyen    ChucVuChinhQuyen[]
  chucVuDang          ChucVuDang[]

  @@schema("mta")
}

model DM_HocHam extends CoreBase {
  profiles UserProfile[]
  hocHam   HocHam[]
	expertProfile ExpertProfile[]
  guestTeachingRate GuestTeachingRate[]

  @@schema("mta")
}

model DM_HocVi extends CoreBase {
  profiles UserProfile[]
  hocVi    HocVi[]
	expertProfile ExpertProfile[]
  guestTeachingRate GuestTeachingRate[]

  @@schema("mta")
}

model DM_ChungChiTinHoc extends CoreBase {
  sNguonCap String?
  sNoiDung  String?
  sGiaTri   String?
  sDoiTuong String?
  @@schema("mta")
}

model DM_DanToc extends CoreBase {
  sTenKhac     String?
  sDiaChiCuTru String?

  userProfile  UserProfile[]
  tiengDanToc  TiengDanToc[]
  @@schema("mta")
}

model DM_DonVi extends CoreBase {
  sCode                String?
  /// mã TKBU
  sTKPUCode            String?
  sTenVietTat          String?
  sParentId            String?            @db.Uuid
  sTruongDonVi         String?            @db.Uuid
  sChucNangNhiemVu     String?
  sDiaChi              String?

  /// 0: Cơ quan chức năng; 1: Khoa/Viện/Trung tâm;2: Hệ, tiểu đoàn
  iNhomDonVi           Int?

  /// 0:Học viện / Nhà trường (Cấp 1);1: Khối (Cấp 2);2:Phòng / Ban / Khoa / Viện (Cấp 3);3:Bộ môn / Phòng TN / Đại đội (Cấp 4); 4:Tổ / Nhóm / Lớp (Cấp 5)
  iCapDonVi            Int?

  /// 0: Phòng;1: Ban; 2: Trung tâm; 3: Văn phòng; 4: Tổ công tác; 5: Khoa; 6: Viện, 7: Bộ môn; 8: Phòng thí nghiệm; 9: Xưởng thực hành; 10: Hệ; 11: Tiểu đoàn; 12: Đại đội: 13: Trung đội; 14: Lớp/Chi đoàn
  iLoaiDonVi           Int?

  lecturers            Lecturer[]
  lecturerHistory      LecturerHistory[]
  staffs               Staff[]
  staffHistory         StaffHistory[]

  curriculum           Curriculum[]
  fixedClass           FixedClass[]
  subjectVersions      SubjectVersion[]
  subjects             Subject[]
  trainingFields       TrainingField[]
  trainingMajors       TrainingMajor[]    @relation("organization")
  secondTrainingMajors TrainingMajor[]    @relation("secondOrganization")
  thirdTrainingMajors  TrainingMajor[]    @relation("thirdOrganization")

  researchProjects     ResearchProject[]         // Đề tài của đơn vị
  thesisProjects       ThesisProject[]             // Đồ án của đơn vị
  surveyObjectTypes    SurveyObjectType[]
  guestTeachingPayments GuestTeachingPayment[]    // Khoa chủ trì chi trả mời giảng


  @@index([sParentId], map: "IX_DM_DonVi_iParentId")
  @@index([sMa], map: "IX_DM_DonVi_sMa")
  @@schema("mta")
}

model DM_DonViHanhChinh extends CoreBase {
  sTen_En String?

  @@schema("mta")
}

model DM_KhuVuc_DiaLy extends CoreBase {
  sTen_En String?

  student Student[]
  @@schema("mta")
}

model DM_NgoaiNgu extends CoreBase {
  ngoaiNgu NgoaiNgu[]
  @@schema("mta")
}

model DM_TonGiao extends CoreBase {
  userProfile UserProfile[]
  @@schema("mta")
}

model DM_TrinhDoNgoaiNgu extends CoreBase {
  sKhung   String?
  ngoaiNgu NgoaiNgu[]

  @@schema("mta")
}

model DM_TrinhDoTinHoc extends CoreBase {
  tinHoc TinHoc[]
  @@schema("mta")
}

model DM_GioiTinh extends CoreBase {
  userProfile UserProfile[]
  @@schema("mta")
}

// DEPRECATED: Use UserProfile instead
model DM_NhanVien extends CoreBase {
  sCCCD               String?
  sHoVaDem            String?
  sTenDayDu           String?
  dNgaySinh           DateTime?
  bLaGiangVien        Boolean?
  iGioiTinh           Int?
  sDM_QuocGiaId       String?    @db.Uuid
  sDM_TinhId          String?    @db.Uuid
  sDM_QuanHuyenId     String?    @db.Uuid
  sDM_XaPhuongId      String?    @db.Uuid
  sDiaChi             String?
  sSDTDiDong          String?
  sEmail              String?
  bLaNguoiDung        Boolean?
  bLaCanBoNhanVien    Boolean?
  bLaHocVien          Boolean?
  sDM_DonViId         String?    @db.Uuid
  sDM_ViTriCongViecId String?    @db.Uuid
  sQuanlyTrucTiepId   String?    @db.Uuid
  sAvatarId           String?

  group               Group?     @relation(fields: [groupId], references: [id])
  groupId             String?

  feedback            Feedback[]

  @@index([sDM_DonViId], map: "IX_DM_NhanVien_sDM_DonViId")
  @@index([sDM_ViTriCongViecId], map: "IX_DM_NhanVien_sDM_ViTriCongViecId")
  @@index([sEmail], map: "IX_DM_NhanVien_sEmail")
  @@index([sSDTDiDong], map: "IX_DM_NhanVien_sSDTDiDong")

  @@schema("mta")
}

model DM_PhanCap_ChatLuong_TrangThietBi extends CoreBase {
  @@schema("mta")
}

model DM_PhanLoai_CSKT extends CoreBase {
  @@schema("mta")
}


model DM_NhomNguoiDung extends CoreBase {
  @@schema("mta")
}

model DM_NhomUngDung extends CoreBase {
  sMoTa String?
  @@schema("mta")
}

model DM_QuocGia extends CoreBase {
  sLanguage   String?
  hocVi       HocVi[]
  userProfile UserProfile[]
  nuocNgoai   NuocNgoai[]
  @@schema("mta")
}

model DM_Tinh extends CoreBase {
  sDM_QuocGiaId               String?            @db.Uuid
  iDM_KhuVucDiaLy_Id          Int?
  iDM_DonViHanhChinhId        Int?

  userProfileHometown         UserProfile[]      @relation("ProvinceHometown")
  userProfilePlaceOfBirth     UserProfile[]      @relation("ProvincePlaceOfBirth")
  userProfilePermanentAddress UserProfile[]      @relation("ProvincePermanentAddress")
  userProfileCurrentAddress   UserProfile[]      @relation("ProvinceCurrentAddress")
  trainingLocation            TrainingLocation[]

  @@index([sDM_QuocGiaId], map: "IX_DM_Tinh_iDM_QuocGiaId")
  @@schema("mta")
}

model DM_Tinh_New extends CoreBase {
  sDM_QuocGiaId               String?            @db.Uuid
  iDM_KhuVucDiaLy_Id          Int?
  iDM_DonViHanhChinhId        Int?

  userProfileHometown         UserProfile[]      @relation("NewProvinceHometown")
  userProfilePlaceOfBirth     UserProfile[]      @relation("NewProvincePlaceOfBirth")
  userProfilePermanentAddress UserProfile[]      @relation("NewProvincePermanentAddress")
  userProfileCurrentAddress   UserProfile[]      @relation("NewProvinceCurrentAddress")
  trainingLocation            TrainingLocation[]

  @@index([sDM_QuocGiaId], map: "IX_DM_Tinh_New_iDM_QuocGiaId")
  @@schema("mta")
}

model DM_QuanHuyen extends CoreBase {
  sDM_TinhId                  String?       @db.Uuid
  sDM_Tinh_Ma                 String?
  iDM_DonViHanhChinhId        Int?

  userProfileHometown         UserProfile[] @relation("DistrictHometown")
  userProfilePlaceOfBirth     UserProfile[] @relation("DistrictPlaceOfBirth")
  userProfilePermanentAddress UserProfile[] @relation("DistrictPermanentAddress")
  userProfileCurrentAddress   UserProfile[] @relation("DistrictCurrentAddress")

  @@index([sDM_TinhId], map: "IX_DM_QuanHuyen_iDM_TinhId")
  @@schema("mta")
}

model DM_XaPhuong extends CoreBase {
  sDM_QuanHuyen_Ma            String?
  sDM_TinhId                  String?       @db.Uuid
  sDM_QuanHuyenId             String?       @db.Uuid
  iDM_DonViHanhChinhId        Int?

  userProfileHometown         UserProfile[] @relation("CommuneHometown")
  userProfilePlaceOfBirth     UserProfile[] @relation("CommunePlaceOfBirth")
  userProfilePermanentAddress UserProfile[] @relation("CommunePermanentAddress")
  userProfileCurrentAddress   UserProfile[] @relation("CommuneCurrentAddress")

  @@index([sDM_QuanHuyenId], map: "IX_DM_XaPhuong_iDM_QuanHuyenId")
  @@schema("mta")
}

model DM_XaPhuong_New extends CoreBase {
  sDM_TinhId_New              String?       @db.Uuid
  iDM_DonViHanhChinhId        Int?

  userProfileHometown         UserProfile[] @relation("NewCommuneHometown")
  userProfilePlaceOfBirth     UserProfile[] @relation("NewCommunePlaceOfBirth")
  userProfilePermanentAddress UserProfile[] @relation("NewCommunePermanentAddress")
  userProfileCurrentAddress   UserProfile[] @relation("NewCommuneCurrentAddress")
  @@index([sDM_TinhId_New])
  @@schema("mta")
}

model DM_ViTriCongViec extends CoreBase {
  sDM_ChucDanhId  String? @db.Uuid
  sDM_NhomViTriId String? @db.Uuid
  @@schema("mta")
}
