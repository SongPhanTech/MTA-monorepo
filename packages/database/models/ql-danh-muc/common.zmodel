/// Loại giảng viên
model LecturerType extends Base {
  name            String            @unique
  /// true = giảng viên ngoài học viện (mời giảng); quyết định nhóm thanh toán mời giảng
  isExternal      Boolean           @default(false)

  lecturers       Lecturer[]
  lecturerHistory LecturerHistory[]
  @@schema("ql-danh-muc")
}

/// Loại nhân viên
model StaffType extends Base {
  name         String         @unique

  staffs       Staff[]
  staffHistory StaffHistory[]
  @@schema("ql-danh-muc")
}

/// Chức vụ nhân viên
model StaffPosition extends Base {
  name         String

  staffs       Staff[]
  staffHistory StaffHistory[]

  @@schema("ql-danh-muc")
}

