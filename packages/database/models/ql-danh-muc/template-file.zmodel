import '../base.zmodel'

enum TemplateFileType {
    UPLOAD
    DOWNLOAD
    LOGS
    @@schema("ql-danh-muc")
}

model TemplateFile extends Base {
    name        String
    path        String            @unique
    fileType    TemplateFileType?
    extensions  String? //loại file
    numberField Int?              @default(0)// Số lượng trường trong file
    @@schema("ql-danh-muc")
}