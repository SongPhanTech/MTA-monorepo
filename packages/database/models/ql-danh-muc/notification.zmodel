import '../base'
import '../ql-dao-tao/plan-training'
import '../ql-dao-tao/student'
import '../ql-dao-tao/lecturer'
import '../ql-nguoi-dung/user'
import '../ql-ho-so/profile'
import 'document'
import 'core-categories'

// Enum loại thông báo
enum NotificationType {
  GENERAL           // Thông báo chung
  ACADEMIC          // Học vụ
  EXAM              // Thi cử
  EVENT             // Sự kiện
  SCHOLARSHIP       // Học bổng
  TUITION           // Học phí
  URGENT            // Khẩn cấp
  MAINTENANCE       // Bảo trì hệ thống
  TEACHING_ASSIGNMENTS // Phân công giảng dạy
  PROCESS_SCORE_DEADLINE // Hạn nhập điểm quá trình
  EXAM_DEADLINE     // Hạn nhập điểm thi
  SURVEY_DEADLINE   // Hạn điền khảo sát
  INDIVIDUAL_SCHEDULE // Lịch cá nhân
  CLASS_REMINDER    // Nhắc trước buổi học (StudentPortal tạo)
  @@schema("ql-danh-muc")
}

// Enum mức độ ưu tiên
enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@schema("ql-danh-muc")
}

// Bảng thông báo
model Notification extends Base {
  title          String               // Tiêu đề thông báo
  content        String
  type           NotificationType     @default(GENERAL)
  priority       NotificationPriority @default(NORMAL)

  // Thời gian hiển thị
  publishedAt    DateTime             @default(now())
  expiresAt      DateTime?            // Hết hạn hiển thị

  // Đối tượng nhận thông báo
  targetAll      Boolean              @default(false) // Gửi cho tất cả
  targetCourses  TrainingCourse[]     // Gửi cho các khoá cụ thể
  targetClasses  FixedClass[]         // Gửi cho các lớp cụ thể
  targetStudents Student[]            // Gửi cho sinh viên cụ thể
  lecturer       Lecturer?            @relation(fields: [lecturerId], references: [id])
  lecturerId     String?               // Gửi cho giảng viên cụ thể

  // Tệp đính kèm
  attachments    DocumentFile[]

  // Chỉ dùng cho CLASS_REMINDER: thiết bị nhận, hạn gửi push (giờ bắt đầu học) và snapshot buổi học.
  // CHECK trong migration: nhắc học bắt buộc có đủ ba trường, loại khác bắt buộc null.
  targetDeviceId String?
  pushExpiresAt  DateTime?            @db.Timestamptz(6)
  reminderData   Json?

  @@index([lecturerId])
  @@index([type, publishedAt])
  @@index([targetDeviceId])
  @@schema("ql-danh-muc")
}

/// Tag công việc cá nhân — mỗi giảng viên tự tạo và quản lý bộ tag riêng.
model PersonalWorkTag extends Base {
  name       String // Tên tag, ví dụ: "Họp", "Chấm bài", "Nghiên cứu"
  color      String? // Màu hiển thị trên lịch (hex), ví dụ #3b82f6
  sortOrder  Int     @default(0) // Thứ tự hiển thị trong danh sách tag

  lecturer   Lecturer @relation(fields: [lecturerId], references: [id])
  lecturerId String

  schedules  IndividualSchedule[]

  @@unique([lecturerId, name])
  @@index([lecturerId])
  @@schema("ql-danh-muc")
}

/// Loại lặp lại lịch cá nhân (modal: Lặp lại).
enum ScheduleRepeatType {
  NONE    // Không lặp lại
  DAILY   // Hàng ngày
  WEEKLY  // Hàng tuần
  MONTHLY // Hàng tháng
  YEARLY  // Hàng năm

  @@schema("ql-danh-muc")
}

/// Lịch / công việc cá nhân của giảng viên (không trùng ClassSchedule hệ thống).
model IndividualSchedule extends Base {
  title     String   // Tiêu đề lịch
  startTime DateTime // Thời điểm bắt đầu (gộp từ ngày + từ giờ)
  endTime   DateTime // Thời điểm kết thúc (gộp đến ngày + đến giờ)
  allDay    Boolean  @default(false) // Cả ngày
  location  String?  // Địa điểm / nền tảng
  content   String?  @db.Text // Nội dung công việc, cuộc họp, ghi chú
  isCompleted Boolean  @default(false) // Đã hoàn thành

  reminderMinutes Int?               // Nhắc lịch: số phút trước giờ bắt đầu (null = không nhắc)
  repeatType      ScheduleRepeatType @default(NONE) // Lặp lại

  lecturer   Lecturer @relation(fields: [lecturerId], references: [id])
  lecturerId String

  tags                PersonalWorkTag[] // Loại lịch
  relatedUserProfiles UserProfile[]     // Người liên quan (tùy chọn)

  @@index([lecturerId])
  @@index([startTime])
  @@index([endTime])
  @@schema("ql-danh-muc")
}