import '../base'
import '../ql-dao-tao/plan-training'
import '../ql-dao-tao/student'
import '../ql-nguoi-dung/user'
import 'document'
import 'core-categories'
import '../ql-dao-tao/student'

// Enum loại thông báo
enum NotificationType {
  GENERAL           // Thông báo chung
  ACADEMIC          // Học vụ
  EXAM              // Thi cử
  EVENT             // Sự kiện
  SCHOLARSHIP       // Học bổng
  TUITION           // Học phí
  URGENT            // Khẩn cấp
  MAINTENANCE       // Bảo trì hệ thống

  @@schema("ql-danh-muc")
}

// Enum mức độ ưu tiên
enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@schema("ql-danh-muc")
}

// Bảng thông báo
model Notification extends Base {
  title          String               // Tiêu đề thông báo
  content        String
  type           NotificationType     @default(GENERAL)
  priority       NotificationPriority @default(NORMAL)

  // Thời gian hiển thị
  publishedAt    DateTime             @default(now())
  expiresAt      DateTime?            // Hết hạn hiển thị

  // Đối tượng nhận thông báo
  targetAll      Boolean              @default(false) // Gửi cho tất cả
  targetCourses  TrainingCourse[]     // Gửi cho các khoá cụ thể
  targetClasses  FixedClass[]         // Gửi cho các lớp cụ thể
  targetStudents Student[]            // Gửi cho sinh viên cụ thể

  // Thông tin tác giả
  createdBy      DM_NhanVien          @relation(fields: [createdById], references: [Id])
  createdById    String

  // Tệp đính kèm
  attachments    DocumentFile[]


  @@schema("ql-danh-muc")
}
