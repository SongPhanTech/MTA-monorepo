import '../base'
import '../ql-danh-muc/core-categories'
import '../ql-ho-so/profile'

model ChatBotConfig extends Base {
  name  String @unique
  value String @db.Text
  @@schema("tro-ly-ao")
}

model UserSession extends Base {
  name         String?
  email        String?
  phoneNumber  String?
  @@schema("tro-ly-ao")

  conversation Conversation[]
}
model Document extends Base {
  title            String?
  body             String?                 @db.Text
  status           DocumentStatus          @default(PENDING)
  classification   DocumentClassification? @relation(fields: [classificationId], references: [id]) // Phân loại: mới ban hành, hết hạn, còn hiệu lực...
  classificationId String?
  uri              String?
  fileType         String?
  fileSize         Int?
  reason           String?
  uploadedBy       UserProfile             @relation("DocumentUploaded", fields: [uploadedById], references: [id])
  uploadedById     String                  @db.Uuid @default(auth().id)
  approvedBy       UserProfile?            @relation("DocumentApproved", fields: [approvedById], references: [id])
  approvedById     String?                 @db.Uuid
  topics           DocumentTopic[]
  @@schema("tro-ly-ao")
}

model DocumentTopic extends Base {
  document   Document @relation(fields: [documentId], references: [id])
  documentId String
  topic      Topic    @relation(fields: [topicId], references: [id])
  topicId    String

  @@unique([documentId, topicId])
  @@schema("tro-ly-ao")
}

model FAQ  extends Base {
  question     String?
  answer       String?
  status       DocumentStatus @default(PENDING)
  topic        Topic?         @relation(fields: [topicId], references: [id])
  topicId      String?
  reason       String?
  uploadedBy   UserProfile    @relation("FAQUploaded", fields: [uploadedById], references: [id])
  uploadedById String         @db.Uuid @default(auth().id)
  approvedBy   UserProfile?   @relation("FAQApproved", fields: [approvedById], references: [id])
  approvedById String?        @db.Uuid
  @@schema("tro-ly-ao")
}

model Prompt extends Base {
  prompt  String?
  status  DocumentStatus @default(PENDING)
  topic   Topic?         @relation(fields: [topicId], references: [id])
  topicId String?
  reason  String?
  @@schema("tro-ly-ao")
}

model Conversation extends Base {
  name      String?
  user      UserProfile? @relation(fields: [userId], references: [id])
  userId    String?      @db.Uuid
  session   UserSession? @relation(fields: [sessionId], references: [id])
  sessionId String?
  topic     Topic?       @relation(fields: [topicId], references: [id])
  topicId   String?
  message   Message[]
  feedbacks ConversationFeedback[]
  @@schema("tro-ly-ao")
}

// Phản hồi của người dùng cho 1 hội thoại.
// Dùng FK lỏng (onDelete: SetNull) + các trường snapshot để bản ghi vẫn được lưu lại
// khi người dùng xoá hội thoại (admin vẫn xem được lịch sử phản hồi).
model ConversationFeedback extends BaseNoCode {
  rating  FeedbackRating
  comment String?        @db.Text

  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  conversationId String?

  // Snapshot tại thời điểm gửi phản hồi (giữ lại khi hội thoại đã bị xoá)
  conversationNameSnapshot String?
  topicIdSnapshot          String?
  topicNameSnapshot        String?
  messagesSnapshot         Json?

  // Định danh phiên khách (không SSO). Người dùng SSO được lấy qua createdBy (kế thừa từ BaseNoCode).
  sessionId String?

  @@index([conversationId])
  @@index([rating])
  @@index([createdAt])
  @@schema("tro-ly-ao")
}

enum FeedbackRating {
  VERY_BAD
  BAD
  NORMAL
  GOOD
  VERY_GOOD
  @@schema("tro-ly-ao")
}

model Message extends Base {
  conversationId String?
  content        String?
  sender         MessageSender

  citations      CitationMessage[]
  conversation   Conversation?     @relation(fields: [conversationId], references: [id])
  @@schema("tro-ly-ao")
}

model CitationMessage extends Base {
  content      String?
  index        Int?
  documentId   String?
  documentType String?
  messageId    String?
  message      Message? @relation(fields: [messageId], references: [id])

  @@schema("tro-ly-ao")
}

model Topic extends Base {
  name          String
  type          String
  isPinned      Boolean         @default(false)
  documents     DocumentTopic[]
  faqs          FAQ[]
  prompts       Prompt[]
  conversations Conversation[]
  @@schema("tro-ly-ao")
}


enum MessageSender {
  USER
  BOT
  @@schema("tro-ly-ao")
}

enum DocumentStatus {
  PENDING
  APPROVE
  DENY
  @@schema("tro-ly-ao")
}

model DocumentClassification extends Base {
  name      String     @unique // Ví dụ: Mới ban hành, Còn hiệu lực, Hết hạn, Đã thay thế, Lưu trữ
  documents Document[]
  @@schema("tro-ly-ao")
}
