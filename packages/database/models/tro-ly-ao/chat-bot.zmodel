import '../base'
import '../ql-danh-muc/core-categories'
import '../ql-ho-so/profile'

model ChatBotConfig extends Base {
  name  String @unique
  value String @db.Text
  @@schema("tro-ly-ao")
}

model UserSession extends Base {
  name         String?
  email        String?
  phoneNumber  String?
  @@schema("tro-ly-ao")

  conversation Conversation[]
}
model Document extends Base {
  title              String?
  body               String?                  @db.Text
  status             DocumentStatus           @default(PENDING)
  classification     DocumentClassification?  @relation(fields: [classificationId], references: [id]) // Phân loại: mới ban hành, hết hạn, còn hiệu lực...
  classificationId   String?
  uri                String?
  fileType           String?
  fileSize           Int?
  reason             String?
  uploadedBy         UserProfile              @relation("DocumentUploaded", fields: [uploadedById], references: [id])
  uploadedById       String                   @default(auth().id)
  approvedBy         UserProfile?             @relation("DocumentApproved", fields: [approvedById], references: [id])
  approvedById       String?
  topics             DocumentTopic[]         
  @@schema("tro-ly-ao")
}

model DocumentTopic extends Base {
  document   Document @relation(fields: [documentId], references: [id])
  documentId String
  topic      Topic    @relation(fields: [topicId], references: [id])
  topicId    String

  @@unique([documentId, topicId])
  @@schema("tro-ly-ao")
}

model FAQ  extends Base {
  question     String?
  answer       String?
  status       DocumentStatus @default(PENDING)
  topic        Topic?         @relation(fields: [topicId], references: [id])
  topicId      String?
  reason       String?
  uploadedBy   UserProfile    @relation("FAQUploaded", fields: [uploadedById], references: [id])
  uploadedById String         @default(auth().id)
  approvedBy   UserProfile?   @relation("FAQApproved", fields: [approvedById], references: [id])
  approvedById String?
  @@schema("tro-ly-ao")
}

model Prompt extends Base {
  prompt  String?
  status  DocumentStatus @default(PENDING)
  topic   Topic?         @relation(fields: [topicId], references: [id])
  topicId String?
  reason  String?
  @@schema("tro-ly-ao")
}

model Conversation extends Base {
  name      String?
  user      UserProfile? @relation(fields: [userId], references: [id])
  userId    String?
  session   UserSession? @relation(fields: [sessionId], references: [id])
  sessionId String?
  topic     Topic?       @relation(fields: [topicId], references: [id])
  topicId   String?
  message   Message[]
  @@schema("tro-ly-ao")
}

model Message extends Base {
  conversationId String?
  content        String?
  sender         MessageSender

  citations      CitationMessage[]
  conversation   Conversation?     @relation(fields: [conversationId], references: [id])
  @@schema("tro-ly-ao")
}

model CitationMessage extends Base {
  content      String?
  index        Int?
  documentId   String?
  documentType String?
  messageId    String?
  message      Message?  @relation(fields: [messageId], references: [id])

  @@schema("tro-ly-ao")
}

model Topic extends Base {
  name          String
  type          String
  documents     DocumentTopic[] 
  faqs          FAQ[]
  prompts       Prompt[]
  conversations Conversation[]
  @@schema("tro-ly-ao")
}


enum MessageSender {
  USER
  BOT
  @@schema("tro-ly-ao")
}

enum DocumentStatus {
  PENDING
  APPROVE
  DENY
  @@schema("tro-ly-ao")
}

model DocumentClassification extends Base {
  name      String     @unique // Ví dụ: Mới ban hành, Còn hiệu lực, Hết hạn, Đã thay thế, Lưu trữ
  documents Document[]
  @@schema("tro-ly-ao")
}
