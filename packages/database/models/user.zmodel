import 'base'
import 'feedback'
import 'blocked-ip'
import 'student'

model User extends Base {
  email      String     @unique @email
  userName   String     @unique
  name       String
  systemRole UserRole   @default(USER)
  ssoId      String?    @unique
  phone      String?    @unique
  role       String?
  groups     Group[]

  feedback   Feedback[]
  student    Student?
  lecturer   Lecturer?
}

enum UserRole {
  ADMIN
  USER
}