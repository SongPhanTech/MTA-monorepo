import 'base'
import 'categories_edu'
import 'categories'
import 'user_info'

// năm học
model SchoolYear extends Base {
  name      String
  startDate DateTime
  endDate   DateTime?
  Semesters Semester[]  @relation("SchoolYearToSemester")
  milestone Milestone[]
}

// kỳ học
model Semester extends Base {
  name         String
  SchoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id], name: "SchoolYearToSemester")
  schoolYearId String
  startDate    DateTime
  endDate      DateTime?
}

// Mốc huấn luyện
model Milestone extends Base {
  name         String
  period       Int
  startDate    DateTime
  endDate      DateTime
  SchoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id])
  schoolYearId String
}

// Khóa học
model TrainingCourse extends Base {
  name                 String
  startDate            DateTime
  endDate              DateTime?
  TrainingObjectType   TrainingObjectType @relation(fields: [trainingObjectTypeId], references: [id]) // Đối tượng đào tạo
  trainingObjectTypeId String
  TrainingType         TrainingType       @relation(fields: [trainingTypeId], references: [id]) // Loại hình đào tạo
  trainingTypeId       String
  TrainingLevel        TrainingLevel      @relation(fields: [trainingLevelId], references: [id]) // Bậc đào tạo
  trainingLevelId      String
  TrainingForm         TrainingForm       @relation(fields: [trainingFormId], references: [id]) // Hình thức đào tạo
  trainingFormId       String

	fixedClass FixedClass[]
}

enum ActiveStatus {
  ACTIVE
  INACTIVATED
}

// chương trình giảng dạy
model Curriculum extends Base {
  name                     String
  status                   ActiveStatus       @default(ACTIVE) //Có thể có endDate nhưng vẫn active do có lớp đang học
  startDate                DateTime
  endDate                  DateTime?
  ManagementOrganization   Organization       @relation(fields: [managementOrganizationId], references: [id]) // Đơn vị phụ trách
  managementOrganizationId String
  TrainingObjectType       TrainingObjectType @relation(fields: [trainingObjectTypeId], references: [id]) // Đối tượng đào tạo
  trainingObjectTypeId     String
  TrainingLevel            TrainingLevel      @relation(fields: [trainingLevelId], references: [id]) // Bậc đào tạo
  trainingLevelId          String
  TraingTime               TrainingTime       @relation(fields: [trainingTimeId], references: [id]) // Thời gian đào tạo
  trainingTimeId           String
  infomation               String   //Thông tin
  documentPath             String?  // Đường dẫn tài liệu
  renderPath               String?  // Đường dẫn tài liệu kết xuất
}

// lớp biên chế
model FixedClass extends Base {
  name                     String

  TrainingCourse         TrainingCourse     @relation(fields: [trainingCourseId], references: [id]) // Khóa học
  trainingCourseId       String
  
  ManagementOrganization   Organization       @relation(fields: [managementOrganizationId], references: [id]) // Đơn vị phụ trách
  managementOrganizationId String

}