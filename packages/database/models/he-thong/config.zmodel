import '../base.zmodel'

enum ConfigKey {
    MANAGEMENT_DEPARTMENT // Bộ ngành quản lý
    ACADEMY_NAME          // Tên trường/học viện
    ACADEMY_CODE          // Mã trường/Tên viết tắt
    DIRECTOR              // Tên Giám đốc

    TRAINING_DEPARTMENT // Phòng Đào Tạo
    HEAD_OF_TRAINING_DEPARTMENT // Trưởng phòng Đào tạo

    EXAMINATION_DEPARTMENT // Phòng Khảo Thí
    HEAD_OF_EXAMINATION_DEPARTMENT // Trưởng phòng Khảo thí

    PROVINCE              // Tỉnh/Thành Phố
    DISTRICT              // Quận/Huyện
    WARD                  // Phường/Xã

    USER_SESSION_TIMEOUT
    ACADEMIC_ACTION_RULES
    LECTURER_DEADLINE_CRON_SCHEDULE // Lịch cron quét hạn thông báo giảng viên (JSON)

    @@schema("he-thong")
}

model Config extends Base {
    key   ConfigKey @unique
    value String
    @@schema("he-thong")
}

model Suggestion extends Base {
    key   String
    value String
    @@schema("he-thong")
}