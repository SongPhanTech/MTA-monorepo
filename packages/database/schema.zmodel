import './models/index.zmodel'

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["mta", "he-thong", "ql-danh-muc", "khao-thi", "ql-dao-tao", "ql-nguoi-dung", "tro-ly-ao","ql-ho-so"]
}

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema", "typedSql","fullTextSearchPostgres"]
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x", "darwin", "darwin-arm64", "windows"]
  output = "../generated/prisma-client"
}

plugin enhance {
  provider = "@core/enhancer"
  output = "./generated/zenstack"
}

// generator dbml {
//   provider = "prisma-dbml-generator"
// }

// generator drizzle {
//   provider = "drizzle-prisma-generator"
//   output   = "../src/drizzle"
// }

plugin zod {
  provider = '@core/zod'
  output = 'generated/zod'
  modelOnly = true // default is false
  compile = false // default is true
  // generateModels = ['User', 'Post']
}

plugin hooks {
  provider = '@zenstackhq/tanstack-query'
  target = 'react'
  output = 'generated/hooks'
}

plugin openapi {
  provider = '@zenstackhq/openapi'
  flavor = 'rpc'
  output = './generated/openapi.json'
  title = 'ZenStack Model API'
  version = '1.0.0'
  prefix = '/api/model'
  specVersion = '3.0.0'
  omitInputDetails = true
  securitySchemes = {
    bearer: { type: 'http', scheme: 'bearer', bearerFormat: 'JWT' },
  }
}

