import './models/index.zmodel'

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["he-thong", "ql-danh-muc", "khao-thi", "ql-dao-tao", "ql-nguoi-dung", "tro-ly-ao"]
}

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema", "typedSql"]
  binaryTargets = ["native"]
}

generator dbml {
  provider = "prisma-dbml-generator"
}

// generator drizzle {
//   provider = "drizzle-prisma-generator"
//   output   = "../src/drizzle"
// }

plugin zod {
  provider = '@core/zod'
  output = 'generated/zod'
  modelOnly = true // default is false
  compile = false // default is true
  // generateModels = ['User', 'Post']
}

plugin hooks {
  provider = '@zenstackhq/tanstack-query'
  target = 'react'
  output = 'generated/hooks'
}

