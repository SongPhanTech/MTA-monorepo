model ChangeLog {
  id            String      @id() @default(cuid())
  tableName     String
  recordId      String
  operation     String
  changedAt     DateTime    @default(now())
  oldData       Json?
  newData       Json?
  transactionId String?
  source        String?
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id])
  userProfileId String      @db.Uuid()

  @@index([tableName, recordId])
  @@index([userProfileId])
  @@index([changedAt])
  @@schema("he-thong")
}

