  @@unique([trainingCourseId, name])
  @@schema("ql-dao-tao")
}

model ScholarshipCriteria {
  id            String           @id() @default(cuid())
  code          String?          @unique()
  active        Boolean          @default(true)
  description   String?          @db.Text()
  deletedAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt()
  createdBy     String?          @db.Uuid()
  scholarshipId String
  scholarship   Scholarship      @relation(fields: [scholarshipId], references: [id])
  field         CriteriaField
  invert        Boolean          @default(false)
  operator      CriteriaOperator
  value         Float
  tuple         String[]         @default([])
  bonusValue    Float            @default(0)

  @@schema("ql-dao-tao")
}

model ScholarshipAward {
  id            String      @id() @default(cuid())
  code          String?     @unique()
  active        Boolean     @default(true)
  description   String?     @db.Text()
  deletedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt()
  createdBy     String?     @db.Uuid()
  student       Student     @relation(fields: [studentId], references: [id])
  studentId     String
  semester      Semester    @relation(fields: [semesterId], references: [id])
  semesterId    String
  scholarship   Scholarship @relation(fields: [scholarshipId], references: [id])
  scholarshipId String
  amount        Decimal
  gpaAtAward    Float
  priorityRank  Int

  @@unique([studentId, scholarshipId, semesterId])
  @@schema("ql-dao-tao")
}

/// Đợt xét tốt nghiệp 
model GraduationSession {
  id                       String                         @id() @default(cuid())
  code                     String?                        @unique()
  active                   Boolean                        @default(true)
  description              String?                        @db.Text()
  deletedAt                DateTime?
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @default(now()) @updatedAt()
  createdBy                String?                        @db.Uuid()
  name                     String
  sessionDate              DateTime
  applicationStart         DateTime
  applicationEnd           DateTime
  trainingObjectType       TrainingObjectType             @relation(fields: [trainingObjectTypeId], references: [id])
  trainingObjectTypeId     String
  status                   GraduationSessionStatus        @default(PLANNING)
  /// Danh sách các đơn xét tốt nghiệp trong đợt này
  applications             StudentGraduationApplication[]
  /// chuẩn đầu ra áp dụng
  outputStandard           OutputStandard[]
  trainingCourse           TrainingCourse?                @relation(fields: [trainingCourseId], references: [id])
  trainingCourseId         String?
  eligibleCount            Int?
  excellentCount           Int?
  topicDecisionNumber      String?
  topicDecisionDate        DateTime?
  topicDecisionSigner      String?
  defenseDecisionNumber    String?
  defenseDecisionDate      DateTime?
  defenseDecisionSigner    String?
  graduationDecisionNumber String?
  graduationDecisionDate   DateTime?
  graduationDecisionSigner String?
  councilMeetingDate       DateTime?
  councilMeetingBasis      String?
  proposalTopic            String?
  proposalCouncil          String?
  proposalGraduation       String?
  skipCertificateCheck     Boolean?

  @@schema("ql-dao-tao")
}

/// Quản lý đơn đăng ký xét tốt nghiệp của sinh viên
model StudentGraduationApplication {
  id                      String                   @id() @default(cuid())
  code                    String?                  @unique()
  active                  Boolean                  @default(true)
  description             String?                  @db.Text()
  deletedAt               DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @default(now()) @updatedAt()
  createdBy               String?                  @db.Uuid()
  student                 Student                  @relation(fields: [studentId], references: [id])
  studentId               String
  session                 GraduationSession        @relation(fields: [sessionId], references: [id])
  sessionId               String
  applicationDate         DateTime                 @default(now())
  status                  ApplicationStatus        @default(SUBMITTED)
  graduation              Boolean?
  gpa                     Decimal?                 @db.Decimal(5, 2)
  reason                  String?
  downgraded              ApplicationDowngraded?
  rank                    AcademicRankingConvert?  @relation(fields: [rankId], references: [id])
  rankId                  String?
  trainingMajor           TrainingMajor?           @relation(fields: [trainingMajorId], references: [id])
  trainingMajorId         String?
  diplomaType             DiplomaType?             @relation(fields: [diplomaTypeId], references: [id])
  diplomaTypeId           String?
  thesisScore             Float?
  thesisReExam            Boolean?
  politicalScore          Float?
  politicalReExam         Boolean?
  foreignLanguageScore    Float?
  foreignLanguageReExam   Boolean?
  defenseEduCert          Boolean?
  physicalEduCert         Boolean?
  foreignLangCert         Boolean?
  itCert                  Boolean?
  accumulatedCredits      Int?
  gpa10                   Float?
  reExamCredits           Int?
  totalSubjects           Int?
  failedSubjects          Int?
  failedCredits           Int?
  mandatoryFailedSubjects Int?
  mandatoryFailedCredits  Int?
  rankDowngraded          Boolean?
  applicationCheckResult  ApplicationCheckResult[]
  gpaScore                StudentSubjectScore[]    @relation("gpaScore")
  supplementaryScore      StudentSubjectScore[]    @relation("supplementaryScore")
  decision                GraduationDecision?

  @@unique([studentId, sessionId])
  @@schema("ql-dao-tao")
}

model ApplicationDowngraded {
  id                             String                             @id() @default(cuid())
  code                           String?                            @unique()
  active                         Boolean                            @default(true)
  description                    String?                            @db.Text()
  deletedAt                      DateTime?
  createdAt                      DateTime                           @default(now())
  updatedAt                      DateTime                           @default(now()) @updatedAt()
  createdBy                      String?                            @db.Uuid()
  studentGraduationApplication   StudentGraduationApplication       @relation(fields: [studentGraduationApplicationId], references: [id])
  studentGraduationApplicationId String                             @unique()
  from                           AcademicRankingConvert             @relation(fields: [fromId], references: [id])
  fromId                         String
  conditions                     GraduationRankDowngradeCondition[]

  @@schema("ql-dao-tao")
}

/// Kết quả kiểm tra điều kiện tự động của hệ thống
model ApplicationCheckResult {
  id                             String                       @id() @default(cuid())
  code                           String?                      @unique()
  active                         Boolean                      @default(true)
  description                    String?                      @db.Text()
  deletedAt                      DateTime?
  createdAt                      DateTime                     @default(now())
  updatedAt                      DateTime                     @default(now()) @updatedAt()
  createdBy                      String?                      @db.Uuid()
  studentGraduationApplication   StudentGraduationApplication @relation(fields: [studentGraduationApplicationId], references: [id])
  studentGraduationApplicationId String                       @unique()
  rankingCondition               RankingCondition             @relation(fields: [rankingConditionId], references: [id])
  rankingConditionId             String
  passed                         Boolean
  actualValue                    Float?

  @@unique([studentGraduationApplicationId, rankingConditionId])
  @@schema("ql-dao-tao")
}

/// Lưu trữ quyết định tốt nghiệp cuối cùng cho một sinh viên
model GraduationDecision {
  id                    String                       @id() @default(cuid())
  code                  String?                      @unique()
  active                Boolean                      @default(true)
  description           String?                      @db.Text()
  deletedAt             DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @default(now()) @updatedAt()
  createdBy             String?                      @db.Uuid()
  application           StudentGraduationApplication @relation(fields: [applicationId], references: [id])
  applicationId         String                       @unique()
  student               Student                      @relation(fields: [studentId], references: [id])
  studentId             String                       @unique()
  decisionDate          DateTime                     @default(now()) @db.Date()
  notes                 String?
  finalGpa              Decimal                      @db.Decimal(5, 2)
  trainingMajor         TrainingMajor?               @relation(fields: [trainingMajorId], references: [id])
  trainingMajorId       String?
  finalRanking          AcademicRankingConvert       @relation(fields: [finalRankingId], references: [id])
  finalRankingId        String
  diplomaType           DiplomaType?                 @relation(fields: [diplomaTypeId], references: [id])
  diplomaTypeId         String?
  originalDiplomaNumber String?                      @unique()
  diplomaNumber         String?                      @unique()
  diplomaIssueDate      DateTime?                    @db.Date()
  diplomaFront          DocumentFile?                @relation("DiplomaFront")
  diplomaBack           DocumentFile?                @relation("DiplomaBack")
  totalCopy             Int?                         @default(0)

  @@schema("ql-dao-tao")
}

/// Xếp loại học tập/Xếp loại tốt nghiệp
model AcademicRankingConvert {
  id                           String                         @id() @default(cuid())
  code                         String?                        @unique()
  active                       Boolean                        @default(true)
  description                  String?                        @db.Text()
  deletedAt                    DateTime?
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @default(now()) @updatedAt()
  createdBy                    String?                        @db.Uuid()
  classification               String
  classificationEnglish        String?
  context                      RankingContext
  rankOrder                    Int
  baseScore                    AcademicRankingBaseType
  base10Min                    Float?
  base10Max                    Float?
  base4Min                     Float?
  base4Max                     Float?
  graduated                    Boolean
  trainingCourse               TrainingCourse                 @relation(fields: [trainingCourseId], references: [id])
  trainingCourseId             String
  rankingCondition             RankingCondition[]
  downgradeRules               GraduationRankDowngradeRule[]
  graduationDecision           GraduationDecision[]
  studentGraduationApplication StudentGraduationApplication[]
  applicationDowngraded        ApplicationDowngraded[]
  studentSemesterResult        StudentSemesterResult[]
  studentYearResult            StudentYearResult[]

  @@unique([trainingCourseId, context, rankOrder])
  @@schema("ql-dao-tao")
}

/// Quy tắc cấu hình việc hạ bậc xếp hạng tốt nghiệp
model GraduationRankDowngradeRule {
  id            String                             @id() @default(cuid())
  code          String?                            @unique()
  active        Boolean                            @default(true)
  description   String?                            @db.Text()
  deletedAt     DateTime?
  createdAt     DateTime                           @default(now())
  updatedAt     DateTime                           @default(now()) @updatedAt()
  createdBy     String?                            @db.Uuid()
  initialRank   AcademicRankingConvert             @relation(fields: [initialRankId], references: [id])
  initialRankId String
  conditions    GraduationRankDowngradeCondition[]

  @@schema("ql-dao-tao")
}

/// Một điều kiện cụ thể trong bộ quy tắc hạ bậc
model GraduationRankDowngradeCondition {
  id                    String                      @id() @default(cuid())
  code                  String?                     @unique()
  active                Boolean                     @default(true)
  description           String?                     @db.Text()
  deletedAt             DateTime?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @default(now()) @updatedAt()
  createdBy             String?                     @db.Uuid()
  downgradeRule         GraduationRankDowngradeRule @relation(fields: [downgradeRuleId], references: [id])
  downgradeRuleId       String
  field                 CriteriaField
  operator              CriteriaOperator
  invert                Boolean                     @default(false)
  value                 Float
  tuple                 String[]                    @default([])
  applicationDowngraded ApplicationDowngraded[]

  @@schema("ql-dao-tao")
}

/// Điều kiện để đạt được một mức xếp loại
model RankingCondition {
  id                     String                   @id() @default(cuid())
  code                   String?                  @unique()
  active                 Boolean                  @default(true)
  description            String?                  @db.Text()
  deletedAt              DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @default(now()) @updatedAt()
  createdBy              String?                  @db.Uuid()
  ranking                AcademicRankingConvert   @relation(fields: [rankingId], references: [id])
  rankingId              String
  field                  CriteriaField
  operator               CriteriaOperator
  invert                 Boolean                  @default(false)
  value                  Float
  tuple                  String[]                 @default([])
  applicationCheckResult ApplicationCheckResult[]

  @@schema("ql-dao-tao")
}

/// Đơn xác minh văn bằng
model DiplomaVerificationApplication {
  id                      String                    @id() @default(cuid())
  code                    String?                   @unique()
  active                  Boolean                   @default(true)
  description             String?                   @db.Text()
  deletedAt               DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @default(now()) @updatedAt()
  createdBy               String?                   @db.Uuid()
  fullname                String
  idCardNumber            String
  dateOfBirth             DateTime?                 @db.Date()
  phoneNumber             String
  email                   String
  reason                  String
  originalDiplomaNumber   String
  diplomaNumber           String
  trainingMajor           String?
  trainingLevel           String?
  trainingForm            String?
  trainingCourseStartYear Int?
  trainingCourseEndYear   Int?
  diplomaIssueDate        DateTime?                 @db.Date()
  classification          String?
  /// Tệp đính kèm khác (nhiều)
  attachments             DocumentFile[]            @relation("DiplomaVerificationAttachments")
  /// Ảnh mặt trước văn bằng
  diplomaFront            DocumentFile?             @relation("DiplomaVerificationFront")
  /// Ảnh mặt sau văn bằng
  diplomaBack             DocumentFile?             @relation("DiplomaVerificationBack")
  /// Trạng thái xử lý
  status                  DiplomaVerificationStatus @default(PENDING)
  /// Liên kết học viên (nếu cần)
  studentId               String?
  student                 Student?                  @relation(fields: [studentId], references: [id])

  @@schema("ql-dao-tao")
}

model ScoreLinkSheet {
  id                       String                    @id() @default(cuid())
  code                     String?                   @unique()
  active                   Boolean                   @default(true)
  description              String?                   @db.Text()
  deletedAt                DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @default(now()) @updatedAt()
  createdBy                String?                   @db.Uuid()
  trainingObjectType       TrainingObjectType        @relation(fields: [trainingObjectTypeId], references: [id])
  trainingObjectTypeId     String
  note                     String?
  decision                 String?
  fixedClass               FixedClass                @relation(fields: [fixedClassId], references: [id])
  fixedClassId             String
  semester                 Semester                  @relation(fields: [semesterId], references: [id])
  semesterId               String
  status                   ScoreLinkStatus           @default(PENDING)
  scoreLinkSubjectVersions ScoreLinkSubjectVersion[]
  documents                DocumentFile[]

  @@schema("ql-dao-tao")
}

/// Danh sách môn/điểm liên kết
model ScoreLinkSubjectVersion {
  id                String             @id() @default(cuid())
  code              String?            @unique()
  active            Boolean            @default(true)
  description       String?            @db.Text()
  deletedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt()
  createdBy         String?            @db.Uuid()
  scoreLinkSheet    ScoreLinkSheet     @relation(fields: [scoreLinkSheetId], references: [id])
  scoreLinkSheetId  String
  subjectVersion    SubjectVersion     @relation(fields: [subjectVersionId], references: [id])
  subjectVersionId  String
  scoreLinkStudents ScoreLinkStudent[]
  subjectClass      SubjectClass?

  @@unique([scoreLinkSheetId, subjectVersionId])
  @@schema("ql-dao-tao")
}

/// Danh sách điểm liên kết theo môn
model ScoreLinkStudent {
  id                        String                  @id() @default(cuid())
  code                      String?                 @unique()
  active                    Boolean                 @default(true)
  description               String?                 @db.Text()
  deletedAt                 DateTime?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @default(now()) @updatedAt()
  createdBy                 String?                 @db.Uuid()
  scoreLinkSubjectVersion   ScoreLinkSubjectVersion @relation(fields: [scoreLinkSubjectVersionId], references: [id], onDelete: Cascade)
  scoreLinkSubjectVersionId String
  student                   Student                 @relation(fields: [studentId], references: [id])
  studentId                 String
  /// Điểm học phần => attendanceScore=midtermScore=examScore=finalScore=manualFinalScore
  score                     Float

  @@unique([scoreLinkSubjectVersionId, studentId])
  @@schema("ql-dao-tao")
}

/// Ghi chú cá nhân của sinh viên
model Note {
  id          String         @id() @default(cuid())
  code        String?        @unique()
  active      Boolean        @default(true)
  description String?        @db.Text()
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt()
  createdBy   String?        @db.Uuid()
  content     String         @db.Text()
  isPinned    Boolean        @default(false)
  student     Student        @relation(fields: [studentId], references: [id])
  studentId   String
  folder      NoteFolder?    @relation(fields: [folderId], references: [id])
  folderId    String?
  tags        NoteTag[]
  attachments DocumentFile[]
  reminders   NoteReminder[]

  @@schema("ql-dao-tao")
}

/// Thư mục ghi chú
model NoteFolder {
  id          String       @id() @default(cuid())
  code        String?      @unique()
  active      Boolean      @default(true)
  description String?      @db.Text()
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt()
  createdBy   String?      @db.Uuid()
  name        String
  icon        String?
  sortOrder   Int          @default(0)
  student     Student      @relation(fields: [studentId], references: [id])
  studentId   String
  parent      NoteFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  parentId    String?
  children    NoteFolder[] @relation("FolderHierarchy")
  notes       Note[]

  @@schema("ql-dao-tao")
}

/// Tag ghi chú (dùng chung cho tất cả sinh viên)
model NoteTag {
  id          String    @id() @default(cuid())
  code        String?   @unique()
  active      Boolean   @default(true)
  description String?   @db.Text()
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt()
  createdBy   String?   @db.Uuid()
  name        String    @unique()
  color       String?
  notes       Note[]

  @@schema("ql-dao-tao")
}

/// Nhắc nhở ghi chú
model NoteReminder {
  id           String             @id() @default(cuid())
  code         String?            @unique()
  active       Boolean            @default(true)
  description  String?            @db.Text()
  deletedAt    DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @default(now()) @updatedAt()
  createdBy    String?            @db.Uuid()
  title        String
  reminderTime DateTime
  isCompleted  Boolean            @default(false)
  completedAt  DateTime?
  repeatType   ReminderRepeatType @default(NONE)
  isNotified   Boolean            @default(false)
  note         Note               @relation(fields: [noteId], references: [id], onDelete: Cascade)
  noteId       String

  @@schema("ql-dao-tao")
}

/// Đợt đánh giá CTDT
model EvaluationPeriod {
  id                 String                 @id() @default(cuid())
  code               String?                @unique()
  active             Boolean                @default(true)
  description        String?                @db.Text()
  deletedAt          DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @default(now()) @updatedAt()
  createdBy          String?                @db.Uuid()
  name               String
  startDate          DateTime               @default(now())
  endDate            DateTime?
  status             EvaluationPeriodStatus @default(COUNCIL_ESTABLISHED)
  schoolYear         SchoolYear?            @relation(fields: [schoolYearId], references: [id])
  schoolYearId       String?
  standards          StandardPeriod[]
  council            EvaluationCouncil?
  documentFiles      DocumentFile[]
  overviewProblem    String?
  overviewGeneral    String?
  overviewResults    String?
  conclude           String?
  evidenceCategories EvidenceCategory[]

  @@schema("khao-thi")
}

model EvaluationStandardSet {
  id          String              @id() @default(cuid())
  code        String?             @unique()
  active      Boolean             @default(true)
  description String?             @db.Text()
  deletedAt   DateTime?
  createdAt   DateTime            @default(now())
