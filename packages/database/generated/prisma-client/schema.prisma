/// Điều kiện cụ thể để kích hoạt xử lý
model AcademicActionCondition {
  id                String                @id() @default(cuid())
  code              String?               @unique()
  active            Boolean               @default(true)
  description       String?               @db.Text()
  deletedAt         DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @default(now()) @updatedAt()
  createdBy         String?               @db.Uuid()
  ruleSet           AcademicActionRuleSet @relation(fields: [ruleSetId], references: [id])
  ruleSetId         String
  field             CriteriaField
  operator          CriteriaOperator
  invert            Boolean               @default(false)
  value             Float
  tuple             String[]              @default([])
  yearCondition     Int?
  isPriorityStudent Boolean?

  @@schema("ql-dao-tao")
}

/// Quyết định xử lý học tập cho sinh viên
model StudentAcademicDecision {
  id               String                @id() @default(cuid())
  code             String?               @unique()
  active           Boolean               @default(true)
  description      String?               @db.Text()
  deletedAt        DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @default(now()) @updatedAt()
  createdBy        String?               @db.Uuid()
  student          Student               @relation(fields: [studentId], references: [id])
  studentId        String
  semester         Semester?             @relation(fields: [semesterId], references: [id])
  semesterId       String?
  schoolYear       SchoolYear?           @relation(fields: [schoolYearId], references: [id])
  schoolYearId     String?
  appliedConfig    AcademicActionConfig? @relation(fields: [appliedConfigId], references: [id])
  appliedConfigId  String?
  actionTaken      AcademicActionType
  decisionDate     DateTime              @default(now())
  validUntil       DateTime?
  reason           String?
  documentEvidence DocumentFile[]
  status           DecisionStatus        @default(PENDING)
  updatedResult    Boolean               @default(false)

  @@unique([studentId, semesterId, schoolYearId, appliedConfigId])
  @@schema("ql-dao-tao")
}

model TrainingScoreSession {
  id                   String                 @id() @default(cuid())
  code                 String?                @unique()
  active               Boolean                @default(true)
  description          String?                @db.Text()
  deletedAt            DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @default(now()) @updatedAt()
  createdBy            String?                @db.Uuid()
  name                 String
  time                 DateTime               @default(now())
  semester             Semester               @relation(fields: [semesterId], references: [id])
  semesterId           String
  trainingObjectType   TrainingObjectType     @relation(fields: [trainingObjectTypeId], references: [id])
  trainingObjectTypeId String
  studentTrainingScore StudentTrainingScore[]

  @@schema("ql-dao-tao")
}

model StudentTrainingScore {
  id                     String               @id() @default(cuid())
  code                   String?              @unique()
  active                 Boolean              @default(true)
  description            String?              @db.Text()
  deletedAt              DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @default(now()) @updatedAt()
  createdBy              String?              @db.Uuid()
  trainingScoreSession   TrainingScoreSession @relation(fields: [trainingScoreSessionId], references: [id])
  trainingScoreSessionId String
  student                Student              @relation(fields: [studentId], references: [id])
  studentId              String
  score                  Float?
  studentTrainingType    StudentTrainingType? @default(GOOD)
  status                 TrainingScoreStatus  @default(PENDING)

  @@unique([trainingScoreSessionId, studentId])
  @@schema("ql-dao-tao")
}

model SemesterTrainingScore {
  id          String              @id() @default(cuid())
  code        String?             @unique()
  active      Boolean             @default(true)
  description String?             @db.Text()
  deletedAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @default(now()) @updatedAt()
  createdBy   String?             @db.Uuid()
  semester    Semester            @relation(fields: [semesterId], references: [id])
  semesterId  String
  student     Student             @relation(fields: [studentId], references: [id])
  studentId   String
  score       Int?
  status      TrainingScoreStatus @default(PENDING)

  @@schema("ql-dao-tao")
}

model SchoolYearTrainingScore {
  id           String              @id() @default(cuid())
  code         String?             @unique()
  active       Boolean             @default(true)
  description  String?             @db.Text()
  deletedAt    DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @default(now()) @updatedAt()
  createdBy    String?             @db.Uuid()
  schoolYear   SchoolYear          @relation(fields: [schoolYearId], references: [id])
  schoolYearId String
  student      Student             @relation(fields: [studentId], references: [id])
  studentId    String
  score        Int?
  status       TrainingScoreStatus @default(PENDING)

  @@schema("ql-dao-tao")
}

model Scholarship {
  id               String                @id() @default(cuid())
  code             String?               @unique()
  active           Boolean               @default(true)
  description      String?               @db.Text()
  deletedAt        DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @default(now()) @updatedAt()
  createdBy        String?               @db.Uuid()
  name             String
  rankOrder        Int
  baseAmount       Decimal               @default(0)
