datasource mssql_db {
  provider = "sqlserver"
  url      = env("MSSQL_DATABASE_URL")
}

generator mssql_client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x", "darwin", "darwin-arm64", "windows"]
  output        = "../generated/mssql-client"
}
