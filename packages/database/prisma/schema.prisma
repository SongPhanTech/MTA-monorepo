datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

generator dbml {
  provider = "prisma-dbml-generator"
}

enum PermissionType {
  CREATE
  READ
  UPDATE
  DELETE
  APPROVE
  DETAIL
}

enum UserRole {
  ADMIN
  USER
}

enum FeedbackStatus {
  Pending
  InProgress
  Resolved
  Closed
}

enum Satisfaction {
  VeryDissatisfied
  Dissatisfied
  Neutral
  Satisfied
  VerySatisfied
}

model Group {
  id          String    @id() @default(cuid())
  description String?   @db.Text()
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt()
  name        String
  users       User[]
  roles       Role[]
}

model Role {
  id          String       @id() @default(cuid())
  description String?      @db.Text()
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt()
  name        String
  groups      Group[]
  permissions Permission[]
}

model Permission {
  id             String         @id() @default(cuid())
  description    String?        @db.Text()
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt()
  name           String
  permissionType PermissionType
  disabled       Boolean        @default(false)
  role           Role[]

  @@unique([name, permissionType])
}

model User {
  id          String     @id() @default(cuid())
  description String?    @db.Text()
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt()
  email       String     @unique()
  userName    String     @unique()
  name        String
  systemRole  UserRole   @default(USER)
  ssoId       String?    @unique()
  phone       String?    @unique()
  role        String?
  groups      Group[]
  feedback    Feedback[]
}

model Feedback {
  id           String         @id() @default(cuid())
  description  String?        @db.Text()
  deletedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt()
  content      String
  status       FeedbackStatus
  satisfaction Satisfaction
  user         User           @relation(fields: [userId], references: [id])
  userId       String
}

model BlockedIp {
  id          String    @id() @default(cuid())
  description String?   @db.Text()
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt()
  ipAddress   String    @unique()
  reason      String?   @db.Text()
  expiresAt   DateTime?
}
