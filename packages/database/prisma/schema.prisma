  nationality            Nationality?          @relation(fields: [nationalityId], references: [id])
  nationalityId          String?
  religion               Religion?             @relation(fields: [religionId], references: [id])
  religionId             String?
  ethnicity              Ethnicity?            @relation(fields: [ethnicityId], references: [id])
  ethnicityId            String?
  gender                 Gender?
  permanentAddress       String?
  temporaryAddress       String?
  contactAddress         String?
  phoneNumber            String?
  email                  String?
  parentPhoneNumber      String?
  parentName             String?
  unionDate              DateTime?
  unionPlace             String?
  CPVJoinDate            DateTime?
  officialCPVDate        DateTime?
  CPVJoinPlace           String?
  tenureDate             DateTime?
  enlistmentDate         DateTime?
  dischargeDate          DateTime?
  rankName               String?
  educationLevel         String?
  academicDegreeTypeName String?
  academicRankTypeName   String?
  positionName           String?
  positionCPVName        String?
  organizationName       String?
  organizationCPVName    String?
  fixedClassStudent      FixedClassStudent[]
  organizationUser       OrganizationUser[]
  subjectClassStudent    SubjectClassStudent[]

  @@schema("ql-nguoi-dung")
}

model FixedClassStudent {
  id            String                  @id() @default(cuid())
  code          String?
  description   String?                 @db.Text()
  deletedAt     DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt()
  fixedClass    FixedClass              @relation(fields: [fixedClassId], references: [id])
  fixedClassId  String
  userProfile   UserProfile             @relation(fields: [userProfileId], references: [id])
  userProfileId String
  status        FixedClassStudentStatus @default(ENROLLED)

  @@schema("ql-dao-tao")
}

model SubjectClassStudent {
  id              String       @id() @default(cuid())
  code            String?
  description     String?      @db.Text()
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt()
  subjectClass    SubjectClass @relation(fields: [subjectClassId], references: [id])
  subjectClassId  String
  userProfile     UserProfile  @relation(fields: [userProfileId], references: [id])
  userProfileId   String
  attendanceScore Float?
  midtermScore    Float?
  finalScore      Float?

  @@schema("ql-dao-tao")
}

model OrganizationUser {
  id             String                 @id() @default(cuid())
  code           String?
  description    String?                @db.Text()
  deletedAt      DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt()
  userProfileId  String
  userProfile    UserProfile            @relation(fields: [userProfileId], references: [id])
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id])
  position       Position?              @relation(fields: [positionId], references: [id])
  positionId     String?
  status         OrganizationUserStatus @default(ACTIVE)

  @@schema("ql-nguoi-dung")
}

model User {
  id               String         @id() @default(cuid())
  code             String?
  description      String?        @db.Text()
  deletedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt()
  email            String         @unique()
  userName         String         @unique()
  name             String
  systemRole       UserRole       @default(USER)
  ssoId            String?        @unique()
  phone            String?        @unique()
  role             String?
  groups           Group[]
  feedback         Feedback[]
  userProfile      UserProfile[]
  conversation     Conversation[]
  documentUploaded Document[]     @relation("DocumentUploaded")
  documentApproved Document[]     @relation("DocumentApproved")
  fAQUploaded      FAQ[]          @relation("FAQUploaded")
  fAQApproved      FAQ[]          @relation("FAQApproved")
  surveyAnswered   SurveyAnswer[] @relation("SurveyAnswer")

  @@schema("ql-nguoi-dung")
}

model Group {
  id          String    @id() @default(cuid())
  code        String?
  description String?   @db.Text()
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt()
  name        String
  users       User[]
  roles       Role[]

  @@schema("ql-nguoi-dung")
}

model Role {
  id          String       @id() @default(cuid())
  code        String?
  description String?      @db.Text()
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt()
  name        String
  groups      Group[]
  permissions Permission[]

  @@schema("ql-nguoi-dung")
}

model Permission {
  id             String         @id() @default(cuid())
  code           String?
  description    String?        @db.Text()
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt()
  name           String
  permissionType PermissionType
  disabled       Boolean        @default(false)
  role           Role[]

  @@unique([name, permissionType])
  @@schema("ql-nguoi-dung")
}

model ChatBotConfig {
  id          String    @id() @default(cuid())
  code        String?
  description String?   @db.Text()
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt()
  name        String    @unique()
  value       String    @db.Text()

  @@schema("tro-ly-ao")
}

model Document {
  id           String         @id() @default(cuid())
  code         String?
  description  String?        @db.Text()
  deletedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt()
  title        String?
  body         String?        @db.Text()
  status       DocumentStatus @default(PENDING)
  uri          String?
  fileType     String?
  fileSize     Int?
  type         DocumentType
  reason       String?
  uploadedBy   User           @relation("DocumentUploaded", fields: [uploadedById], references: [id])
  uploadedById String
  approvedBy   User?          @relation("DocumentApproved", fields: [approvedById], references: [id])
  approvedById String?

  @@schema("tro-ly-ao")
}

model FAQ {
  id           String         @id() @default(cuid())
  code         String?
  description  String?        @db.Text()
  deletedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt()
  question     String?
  answer       String?
  status       DocumentStatus @default(PENDING)
  type         DocumentType
  reason       String?
  uploadedBy   User           @relation("FAQUploaded", fields: [uploadedById], references: [id])
  uploadedById String
  approvedBy   User?          @relation("FAQApproved", fields: [approvedById], references: [id])
  approvedById String?

  @@schema("tro-ly-ao")
}

model Prompt {
