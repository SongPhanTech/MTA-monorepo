generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma-client"
  previewFeatures = ["fullTextSearchPostgres", "multiSchema", "typedSql"]
  binaryTargets   = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x", "darwin", "darwin-arm64", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["he-thong", "khao-thi", "mta", "ql-danh-muc", "ql-dao-tao", "ql-ho-so", "ql-nguoi-dung", "tro-ly-ao"]
}

model Config {
  id          String    @id @default(cuid())
  code        String?   @unique
  active      Boolean   @default(true)
  description String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  key         ConfigKey @unique
  value       String
  createdBy   String?   @db.Uuid

  @@schema("he-thong")
}

model Suggestion {
  id          String    @id @default(cuid())
  code        String?   @unique
  active      Boolean   @default(true)
  description String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  createdBy   String?   @db.Uuid
  key         String
  value       String

  @@schema("he-thong")
}

model ChangeLog {
  id            String      @id @default(cuid())
  tableName     String
  recordId      String
  operation     String
  changedAt     DateTime    @default(now())
  oldData       Json?
  newData       Json?
  transactionId String?
  source        String?
  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id])

  @@index([tableName, recordId])
  @@index([userProfileId])
  @@index([changedAt])
  @@schema("he-thong")
}

