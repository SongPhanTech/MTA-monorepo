datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "linux-musl-openssl-3.0.x"]
}

generator dbml {
  provider = "prisma-dbml-generator"
}

model User {
  id          String    @id() @default(cuid())
  description String?   @db.Text()
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt()
  email       String    @unique()
  userName    String
  name        String
  ssoId       String?
  phone       String?
  role        String?
  groups      Group[]
}

model Group {
  id          String    @id() @default(cuid())
  description String?   @db.Text()
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt()
  name        String
  users       User[]
  roles       Role[]
}

model Role {
  id          String    @id() @default(cuid())
  description String?   @db.Text()
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt()
  name        String
  groups      Group[]
}
