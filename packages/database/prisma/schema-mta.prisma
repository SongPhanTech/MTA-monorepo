  code           String?      @unique()
  active         Boolean      @default(true)
  description    String?      @db.Text()
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt()
  createdBy      String?      @db.Uuid()
  from           DateTime?
  to             DateTime?
  lectureID      String?
  lectureCode    String?
  serviceDate    DateTime?
  userProfile    UserProfile  @relation(fields: [userProfileId], references: [id])
  userProfileId  String       @unique()
  organization   DM_DonVi?    @relation(fields: [organizationId], references: [Id])
  organizationId String?      @db.Uuid()
  lecturerType   LecturerType @relation(fields: [lecturerTypeId], references: [id])
  lecturerTypeId String

  @@schema("ql-dao-tao")
}

model ResearchProject {
  id                String                        @id() @default(cuid())
  code              String?                       @unique()
  active            Boolean                       @default(true)
  description       String?                       @db.Text()
  deletedAt         DateTime?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @default(now()) @updatedAt()
  createdBy         String?                       @db.Uuid()
  title             String
  summary           String                        @db.Text()
  objectives        String?                       @db.Text()
  methodology       String?                       @db.Text()
  expectedResults   String?                       @db.Text()
  requirements      String?                       @db.Text()
  supervisor        Lecturer                      @relation(fields: [supervisorId], references: [id])
  supervisorId      String
  organization      DM_DonVi                      @relation(fields: [organizationId], references: [Id])
  organizationId    String                        @db.Uuid()
  maxStudents       Int
  currentStudents   Int                           @default(0)
  registrationStart DateTime
  registrationEnd   DateTime
  projectStart      DateTime?
  projectEnd        DateTime?
  status            ResearchProjectStatus         @default(OPEN)
  registrations     StudentResearchRegistration[]

  @@schema("ql-dao-tao")
}

model StudentResearchRegistration {
  id                String             @id() @default(cuid())
  code              String?            @unique()
  active            Boolean            @default(true)
  description       String?            @db.Text()
  deletedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt()
  createdBy         String?            @db.Uuid()
  student           Student            @relation(fields: [studentId], references: [id])
  studentId         String
  researchProject   ResearchProject    @relation(fields: [researchProjectId], references: [id])
  researchProjectId String
  registeredAt      DateTime           @default(now())
  motivation        String?            @db.Text()
  experience        String?            @db.Text()
  status            RegistrationStatus @default(PENDING)
  reviewedAt        DateTime?
  reviewedBy        Lecturer?          @relation(fields: [reviewedById], references: [id])
  reviewedById      String?
  reviewNote        String?            @db.Text()

  @@unique([studentId, researchProjectId])
  @@schema("ql-dao-tao")
}

model ThesisSession {
  id                    String             @id() @default(cuid())
  code                  String?            @unique()
  active                Boolean            @default(true)
  description           String?            @db.Text()
  deletedAt             DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @default(now()) @updatedAt()
  createdBy             String?            @db.Uuid()
  name                  String
  startDate             DateTime
  endDate               DateTime
  trainingObjectType    TrainingObjectType @relation(fields: [trainingObjectTypeId], references: [id])
  trainingObjectTypeId  String
  trainingCourse        TrainingCourse     @relation(fields: [trainingCourseId], references: [id])
  trainingCourseId      String
  /// Số QĐĐT
  decisionNumber        String?
  /// người ký quyết định
  decisionMaker         String?
  /// Ngày QĐĐT
  decisionDate          DateTime?
  /// Số QĐBVLV
  defenseDecisionNumber String?
  /// người ký QĐBVLV
  defenseDecisionMaker  String?
  /// Ngày QĐBVLV
  defenseDecisionDate   DateTime?
  /// Thủ trưởng
  chief                 String?
  thesisProject         ThesisProject[]

  @@schema("ql-dao-tao")
}

model ThesisProject {
  id                 String                      @id() @default(cuid())
  code               String?                     @unique()
  active             Boolean                     @default(true)
  description        String?                     @db.Text()
  deletedAt          DateTime?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @default(now()) @updatedAt()
  createdBy          String?                     @db.Uuid()
  title              String?
  titleEN            String?
  summary            String?                     @db.Text()
  objectives         String?                     @db.Text()
  scope              String?                     @db.Text()
  methodology        String?                     @db.Text()
  expectedResults    String?                     @db.Text()
  requirements       String?                     @db.Text()
  technologies       String?                     @db.Text()
  thesisType         ThesisType                  @default(PROJECT)
  status             ThesisProjectStatus         @default(PROPOSED)
  language           String?                     @db.Text()
  type               String?                     @db.Text()
  subjectClass       SubjectClass?               @relation(fields: [subjectClassId], references: [id])
  subjectClassId     String?
  thesisSession      ThesisSession?              @relation(fields: [thesisSessionId], references: [id])
  thesisSessionId    String?
  /// Chuyên gia hướng dẫn
  supervisor         ExpertProfile?              @relation("SupervisorToThesis", fields: [supervisorId], references: [id])
  supervisorId       String?
  /// Chuyên gia hướng dẫn phụ
  coSupervisor       ExpertProfile?              @relation("CoSupervisorToThesis", fields: [coSupervisorId], references: [id])
  coSupervisorId     String?
  /// Đơn vị quản lý
  organization       DM_DonVi?                   @relation(fields: [organizationId], references: [Id])
  organizationId     String?                     @db.Uuid()
  maxStudents        Int?
  /// Hội đồng đánh giá
  council            Council?                    @relation(fields: [councilId], references: [id])
  councilId          String?
  /// phòng bảo vệ
  room               Room?                       @relation(fields: [roomId], references: [id])
  roomId             String?
  /// Ngày bảo vệ
  defenseDate        DateTime?
  defenseSession     DefenseSession?             @relation(fields: [defenseSessionId], references: [id])
  defenseSessionId   String?
  registrationStart  DateTime?
  registrationEnd    DateTime?
  projectStart       DateTime?
  projectEnd         DateTime?
  defenseRecord      DefenseRecord?
  librarySubmission  LibrarySubmission?
  decisions          Decision[]
  registrations      StudentThesisRegistration[]
  supervisorPayments SupervisorPaymentRecord[]

  @@schema("ql-dao-tao")
}

/// Ca bảo vệ
model DefenseSession {
  id            String          @id() @default(cuid())
  code          String?         @unique()
  active        Boolean         @default(true)
  description   String?         @db.Text()
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now()) @updatedAt()
  createdBy     String?         @db.Uuid()
  startTime     DateTime        @db.Time(0)
  thesisProject ThesisProject[]

  @@schema("ql-dao-tao")
}

model StudentThesisRegistration {
  id                    String                          @id() @default(cuid())
  code                  String?                         @unique()
  active                Boolean                         @default(true)
  description           String?                         @db.Text()
  deletedAt             DateTime?
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @default(now()) @updatedAt()
  createdBy             String?                         @db.Uuid()
  student               Student                         @relation(fields: [studentId], references: [id])
  studentId             String
  studentSubjectScore   StudentSubjectScore?            @relation("ScoreToRegistration", fields: [studentSubjectScoreId], references: [id])
  studentSubjectScoreId String?
  thesisProject         ThesisProject                   @relation(fields: [thesisProjectId], references: [id])
  thesisProjectId       String
  registeredAt          DateTime                        @default(now())
  motivation            String?                         @db.Text()
  experience            String?                         @db.Text()
  proposedIdeas         String?                         @db.Text()
  status                StudentThesisRegistrationStatus @default(PENDING)
  reviewedAt            DateTime?
  reviewedBy            Lecturer?                       @relation(fields: [reviewedById], references: [id])
  reviewedById          String?
  reviewNote            String?                         @db.Text()
  council               Council?

  @@unique([studentId, thesisProjectId])
  @@schema("ql-dao-tao")
}

/// Model cho Chuyên gia (Giảng viên trong và ngoài trường)
model ExpertProfile {
  id                      String                    @id() @default(cuid())
  code                    String?                   @unique()
  active                  Boolean                   @default(true)
  description             String?                   @db.Text()
  deletedAt               DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @default(now()) @updatedAt()
  createdBy               String?                   @db.Uuid()
  lecturer                Lecturer?                 @relation(fields: [lecturerId], references: [id])
  lecturerId              String?                   @unique()
  name                    String?
  academicRank            String?
  academicDegree          String?
  organization            String?
  position                String?
  specialization          String?
  major                   TrainingMajor[]
  workplace               String?
  phone                   String?
  email                   String?
  bankAccountNumber       String?
  bankName                String?
  eligiblePresident       Boolean
  eligibleSecretary       Boolean
  supervisedTheses        ThesisProject[]           @relation("SupervisorToThesis")
  coSupervisedTheses      ThesisProject[]           @relation("CoSupervisorToThesis")
  subjectClass            SubjectClass[]
  councilMemberships      CouncilMember[]
  payments                PaymentRecord[]
  supervisorPaymentRecord SupervisorPaymentRecord[]

  @@schema("ql-dao-tao")
}

/// Quản lý các Quyết định liên quan
model Decision {
  id              String         @id() @default(cuid())
  code            String?        @unique()
  active          Boolean        @default(true)
  description     String?        @db.Text()
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt()
  createdBy       String?        @db.Uuid()
  issueDate       DateTime
  type            DecisionType
  documentFile    DocumentFile[]
  thesisProject   ThesisProject  @relation(fields: [thesisProjectId], references: [id])
  thesisProjectId String

  @@schema("ql-dao-tao")
}

/// Quản lý Giấy mời
model Invitation {
  id              String        @id() @default(cuid())
  code            String?       @unique()
  active          Boolean       @default(true)
  description     String?       @db.Text()
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt()
  createdBy       String?       @db.Uuid()
  sentDate        DateTime      @default(now())
  isConfirmed     Boolean       @default(false)
  councilMember   CouncilMember @relation(fields: [councilMemberId], references: [id])
  councilMemberId String        @unique()

  @@schema("ql-dao-tao")
}

/// Hội đồng đánh giá
model Council {
  id                          String                     @id() @default(cuid())
  code                        String?                    @unique()
  active                      Boolean                    @default(true)
  description                 String?                    @db.Text()
  deletedAt                   DateTime?
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @default(now()) @updatedAt()
  createdBy                   String?                    @db.Uuid()
  proposedDate                DateTime                   @default(now())
  status                      CouncilProposalStatus      @default(PENDING)
  studentThesisRegistration   StudentThesisRegistration? @relation(fields: [studentThesisRegistrationId], references: [id])
  studentThesisRegistrationId String?                    @unique()
  thesis                      ThesisProject[]
  members                     CouncilMember[]

  @@schema("ql-dao-tao")
}

/// Thành viên trong một Hội đồng
model CouncilMember {
  id          String         @id() @default(cuid())
  code        String?        @unique()
  active      Boolean        @default(true)
  description String?        @db.Text()
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt()
  createdBy   String?        @db.Uuid()
  role        CouncilRole
  councilId   String
  council     Council        @relation(fields: [councilId], references: [id])
  expertId    String
  expert      ExpertProfile  @relation(fields: [expertId], references: [id])
  payment     PaymentRecord?
  invitations Invitation?

  @@unique([councilId, expertId])
  @@schema("ql-dao-tao")
}

/// Hồ sơ và Kết quả bảo vệ
model DefenseRecord {
  id                String         @id() @default(cuid())
  code              String?        @unique()
  active            Boolean        @default(true)
  description       String?        @db.Text()
  deletedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @default(now()) @updatedAt()
  createdBy         String?        @db.Uuid()
  finalScore        Decimal?       @db.Decimal(5, 2)
  comments          String?        @db.Text()
  isProfileComplete Boolean        @default(false)
  thesis            ThesisProject  @relation(fields: [thesisId], references: [id])
  thesisId          String         @unique()
  documents         DocumentFile[]

  @@schema("ql-dao-tao")
}

/// Quản lý việc nộp Luận văn cho Thư viện
model LibrarySubmission {
  id             String         @id() @default(cuid())
  code           String?        @unique()
  active         Boolean        @default(true)
  description    String?        @db.Text()
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt()
  createdBy      String?        @db.Uuid()
  submissionDate DateTime       @default(now())
  isHardcopy     Boolean        @default(false)
  isSoftcopy     Boolean        @default(false)
  librarianNote  String?
  thesis         ThesisProject  @relation(fields: [thesisId], references: [id])
  thesisId       String         @unique()
  confirmedById  String?
  documentFile   DocumentFile[]

  @@schema("ql-dao-tao")
}

model DefaultCouncilRolePayAmount {
  id          String      @id() @default(cuid())
  code        String?     @unique()
  active      Boolean     @default(true)
  description String?     @db.Text()
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt()
  createdBy   String?     @db.Uuid()
  role        CouncilRole @unique()
  amount      Decimal

  @@schema("ql-dao-tao")
}

/// Quản lý việc thanh toán hội đồng
model PaymentRecord {
