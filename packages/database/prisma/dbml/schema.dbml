  code String [unique]
  active Boolean [not null, default: true]
  description String
  deletedAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  name String [not null]
}

Table Rank {
  id String [pk]
  code String [unique]
  active Boolean [not null, default: true]
  description String
  deletedAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  name String [not null]
  profiles UserProfile [not null]
}

Table AcademicDegreeType {
  id String [pk]
  code String [unique]
  active Boolean [not null, default: true]
  description String
  deletedAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  name String [not null]
  profiles UserProfile [not null]
}

Table AcademicRankType {
  id String [pk]
  code String [unique]
  active Boolean [not null, default: true]
  description String
  deletedAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  name String [not null]
  profiles UserProfile [not null]
}

Table LecturerType {
  id String [pk]
  code String [unique]
  active Boolean [not null, default: true]
  description String
  deletedAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  name String [unique, not null]
  lecturers Lecturer [not null]
  staffPosition StaffPosition [not null]
  lecturerHistory LecturerHistory [not null]
}

Table StaffType {
  id String [pk]
  code String [unique]
  active Boolean [not null, default: true]
  description String
  deletedAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  name String [unique, not null]
  staffs Staff [not null]
  staffHistory StaffHistory [not null]
}

Table StaffPosition {
  id String [pk]
  code String [unique]
  active Boolean [not null, default: true]
  description String
  deletedAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  name String [not null]
  lecturerType LecturerType [not null]
  lecturerTypeId String [not null]
  staffs Staff [not null]
  staffHistory StaffHistory [not null]

  indexes {
    (name, lecturerTypeId) [unique]
  }
}

Table PositionCPV {
  id String [pk]
  code String [unique]
  active Boolean [not null, default: true]
  description String
  deletedAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  name String [not null]
  profiles UserProfile [not null]
}

Table OrganizationType {
  id String [pk]
  code String [unique]
  active Boolean [not null, default: true]
  description String
  deletedAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  name String [not null]
  organizations Organization [not null]
}

Table Organization {
  id String [pk]
  code String [unique]
  active Boolean [not null, default: true]
  description String
  deletedAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  name String [unique, not null]
  type OrganizationType [not null]
  typeId String [not null]
  parent Organization
  parentId String
  children Organization [not null]
  address String
  lecturers Lecturer [not null]
  lecturerHistory LecturerHistory [not null]
  staffs Staff [not null]
  staffHistory StaffHistory [not null]
  curriculum Curriculum [not null]
  fixedClass FixedClass [not null]
  subjectVersions SubjectVersion [not null]
  subjects Subject [not null]
  trainingFields TrainingField [not null]
  trainingMajors TrainingMajor [not null]
}

Table Lecturer {
  id String [pk]
  code String [unique]
  active Boolean [not null, default: true]
  description String
  deletedAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  lectureID String [unique]
  lectureCode String [unique]
  serviceDate DateTime
  userProfile UserProfile [not null]
  userProfileId String [unique, not null]
  organization Organization [not null]
  organizationId String [not null]
  lecturerType LecturerType [not null]
  lecturerTypeId String [not null]
}

Table LecturerHistory {
  id String [pk]
  code String [unique]
  active Boolean [not null, default: true]
  description String
  deletedAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  from DateTime
  to DateTime
  lectureID String
  lectureCode String
  serviceDate DateTime
  userProfile UserProfile [not null]
  userProfileId String [unique, not null]
  organization Organization
  organizationId String
  lecturerType LecturerType [not null]
  lecturerTypeId String [not null]
}

Table Staff {
  id String [pk]
  code String [unique]
  active Boolean [not null, default: true]
  description String
  deletedAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  from DateTime
  lectureID String [unique]
  lectureCode String [unique]
  serviceDate DateTime
  userProfile UserProfile [not null]
  userProfileId String [unique, not null]
  organization Organization [not null]
  organizationId String [not null]
  staffType StaffType [not null]
  staffTypeId String [not null]
  staffPosition StaffPosition [not null]
  staffPositionId String [not null]
}

Table StaffHistory {
  id String [pk]
  code String [unique]
  active Boolean [not null, default: true]
  description String
  deletedAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  from DateTime
  to DateTime
  userProfile UserProfile [not null]
  userProfileId String [unique, not null]
  organization Organization
  organizationId String
  staffType StaffType [not null]
  staffTypeId String [not null]
  staffPosition StaffPosition [not null]
  staffPositionId String [not null]
}

Table TemplateFile {
  id String [pk]
  code String [unique]
  active Boolean [not null, default: true]
  description String
  deletedAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  name String [not null]
  path String [unique, not null]
  fileType TemplateFileType
  extensions String
  numberField Int [default: 0]
}

Table BlockedIp {
  id String [pk]
  code String [unique]
  active Boolean [not null, default: true]
  description String
  deletedAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  ipAddress String [unique, not null]
  reason String
  expiresAt DateTime
}

Table SubjectVersionToTrainingObjectType {
  trainingobjecttypesId String [ref: > TrainingObjectType.id]
  subjectversionId String [ref: > SubjectVersion.id]
}

Table PrerequisiteSubject {
  prerequisitesubjectId String [ref: > SubjectVersion.id]
  dependentsubjectId String [ref: > SubjectVersion.id]
}

Table CoRequisiteSubject {
  corequisitesubjectId String [ref: > SubjectVersion.id]
  depcorequisitesubjectId String [ref: > SubjectVersion.id]
}

Table PriorityObjectToStudent {
  studentsId String [ref: > Student.id]
  priorityobjectId String [ref: > PriorityObject.id]
}

Table GroupToUser {
  groupsId String [ref: > Group.id]
  usersId String [ref: > User.id]
}

Table GroupToRole {
  rolesId String [ref: > Role.id]
  groupsId String [ref: > Group.id]
}

Table PermissionToRole {
  permissionsId String [ref: > Permission.id]
  roleId String [ref: > Role.id]
}

