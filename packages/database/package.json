{
    "name": "@workspace/db",
    "version": "0.0.0",
    "scripts": {
        "generate:sql": "prisma generate --sql",
        "generate": "zenstack generate",
        "db:push": "prisma db push --skip-generate",
        "db:sync": "zenstack generate && prisma db push --skip-generate"
    },
    "exports": {
        "./client": "./src/client/index.ts",
        ".": "./src/index.ts",
        "./mysql": "./src/mysql.ts",
        "./mssql": "./src/mssql.ts",
        "./sql": "./src/typedSql.ts",
        "./zod": "./generated/zod/index.ts",
        "./zod/models": "./generated/zod/models/index.ts",
        "./zod/enums": "./generated/zod/enums/index.ts",
        "./hooks": "./generated/hooks/index.ts",
        "./hono": "./src/hono/index.ts",
        "./model-policy-user": "./src/model-policy-user.ts",
        "./model-api-app-codes": "./src/model-api-app-codes.ts",
        "./openapi": "./src/openapi.ts"
    },
    "dependencies": {
        "@prisma/client": "catalog:",
        "@zenstackhq/runtime": "catalog:",
        "dayjs": "catalog:",
        "decimal.js": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@paralleldrive/cuid2": "github:paralleldrive/cuid2",
        "@tanstack/react-query": "catalog:",
        "@types/node": "catalog:",
        "@workspace/typescript-config": "workspace:*",
        "@zenstackhq/openapi": "catalog:",
        "@zenstackhq/server": "catalog:",
        "@zenstackhq/tanstack-query": "catalog:",
        "prisma": "catalog:",
        "prisma-dbml-generator": "catalog:",
        "zenstack": "catalog:"
    }
}
