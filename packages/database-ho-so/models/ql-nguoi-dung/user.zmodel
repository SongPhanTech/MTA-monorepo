enum UserRole {
  ADMIN
  USER
  @@schema("ql-nguoi-dung")
}

model Group extends Base {
  name  String
  users DM_NhanVien[]
  roles Role[]
  @@schema("ql-nguoi-dung")
}

model Role extends Base {
  name        String
  groups      Group[]
  permissions Permission[]
  @@schema("ql-nguoi-dung")
}

model Permission extends Base {
  name           String
  permissionType PermissionType
  disabled       Boolean        @default(false)

  role           Role[]

  @@unique([name, permissionType])
  @@schema("ql-nguoi-dung")
}

enum PermissionType {
  CREATE
  READ
  UPDATE
  DELETE
  APPROVE
  DETAIL
  @@schema("ql-nguoi-dung")
}
