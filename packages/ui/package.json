{
  "name": "@workspace/ui",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    "./globals.css": "./src/assets/styles/globals.css",
    "./postcss.config": "./postcss.config.mjs",
    "./tailwind.config": "./tailwind.config.ts",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": [
      "./src/hooks/*.ts",
      "./src/hooks/*.tsx"
    ],
    ".": "./src/index.ts",
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ]
  },
  "scripts": {
    "lint": "oxlint --fix",
    "format": "oxfmt",
    "generate:component": "turbo gen react-component",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@turbo/gen": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-big-calendar": "catalog:",
    "@types/react-dom": "catalog:",
    "@workspace/typescript-config": "workspace:*",
    "autoprefixer": "catalog:",
    "postcss": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@ant-design/cssinjs": "catalog:",
    "@ant-design/icons": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-store": "catalog:",
    "@workspace/auth": "workspace:*",
    "@workspace/constant": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/libs": "workspace:*",
    "@workspace/router": "workspace:*",
    "@zenstackhq/tanstack-query": "catalog:",
    "antd": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "dayjs": "catalog:",
    "echarts-for-react": "catalog:",
    "lucide-react": "catalog:",
    "moment": "catalog:",
    "react": "catalog:",
    "react-big-calendar": "catalog:",
    "react-dom": "catalog:",
    "react-hook-disclosure-modal": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss-animate": "catalog:"
  }
}