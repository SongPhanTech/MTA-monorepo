/// HV/SV: khi tạo student, thông tin khoá học sẽ được copy sang
model Student {
  id                       String                  @id() @default(cuid())
  code                     String?                 @unique()
  active                   Boolean                 @default(true)
  description              String?                 @db.Text()
  deletedAt                DateTime?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt()
  entryScore               Float?
  from                     DateTime?
  to                       DateTime?
  trainingLocation         TrainingLocation?       @relation(fields: [trainingLocationId], references: [id])
  trainingLocationId       String?
  /// đối tượng ưu tiên
  priorityObject           PriorityObject[]
  unionLeader              String?
  status                   StudentStatus           @default(ENROLLED)
  classMonitor             FixedClass?             @relation("ClassMonitor")
  unionLeaderOf            FixedClass?             @relation("UnionLeader")
  fixedClass               FixedClass?             @relation(fields: [fixedClassId], references: [id])
  fixedClassId             String?
  subjectClassStudent      StudentSubjectScore[]
  userProfileId            String
  userProfile              UserProfile             @relation(fields: [userProfileId], references: [id])
  trainingLevel            TrainingLevel?          @relation(fields: [trainingLevelId], references: [id])
  trainingLevelId          String?
  trainingObjectType       TrainingObjectType?     @relation(fields: [trainingObjectTypeId], references: [id])
  trainingObjectTypeId     String?
  trainingType             TrainingType?           @relation(fields: [trainingTypeId], references: [id])
  trainingTypeId           String?
  trainingForm             TrainingForm?           @relation(fields: [trainingFormId], references: [id])
  trainingFormId           String?
  registrationArea         DM_KhuVuc_DiaLy?        @relation(fields: [registrationAreaId], references: [Id])
  registrationAreaId       String?                 @db.Uuid()
  curriculumVersion        CurriculumVersion?      @relation(fields: [curriculumVersionId], references: [id])
  curriculumVersionId      String?
  academicWarningLevel     Int                     @default(0)
  disciplinaryWarningLevel Int                     @default(0)
  suspended                Boolean                 @default(false)
  expelled                 Boolean                 @default(false)
  foreignLangPass          Boolean                 @default(false)
  ITCertificationPass      Boolean                 @default(false)
  strengthTrainingPass     Boolean                 @default(false)
  militaryTrainingPass     Boolean                 @default(false)
  studentSemesterResult    StudentSemesterResult[]
  studentYearResult        StudentYearResult[]
  surveySessions           SurveySession[]
  examSession              ExamSession[]

  @@schema("ql-dao-tao")
}

model StudentSemesterResult {
  id                       String                  @id() @default(cuid())
  code                     String?                 @unique()
  active                   Boolean                 @default(true)
  description              String?                 @db.Text()
  deletedAt                DateTime?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt()
  student                  Student                 @relation(fields: [studentId], references: [id])
  studentId                String
  semester                 Semester                @relation(fields: [semesterId], references: [id])
  semesterId               String
  studyYear                Int
  semesterIndexInCourse    Int
  isLastSemester           Boolean
  baseScore                AcademicRankingBaseType
  gpaBase4                 Decimal                 @db.Decimal(5, 2)
  cumulativeGpaBase4       Decimal                 @db.Decimal(5, 2)
  gpaBase10                Decimal                 @db.Decimal(5, 2)
  cumulativeGpaBase10      Decimal                 @db.Decimal(5, 2)
  conductScore             Float?
  lowestFinalScore         Float
  lowestGraduationScore    Float?
  totalCredits             Int
  registeredCredits        Int
  retakingCredits          Int
  passedCredits            Int
  failedCredits            Int
  accumulatedCredits       Int
  totalCreditsByCurriculum Int
  totalFailedCredits       Int
  foreignLangPass          Boolean
  isClassMonitor           Boolean
  isUnionLeader            Boolean
  entryScore               Float?
  isImproving              Boolean
  postponeWithReason       Boolean                 @default(false)
  academicWarningLevel     Int                     @default(0)
  disciplinaryWarningLevel Int                     @default(0)
  suspended                Boolean                 @default(false)
  expelled                 Boolean                 @default(false)

  @@unique([studentId, semesterId])
  @@schema("ql-dao-tao")
}

model StudentYearResult {
  id                       String                  @id() @default(cuid())
  code                     String?                 @unique()
  active                   Boolean                 @default(true)
  description              String?                 @db.Text()
  deletedAt                DateTime?
