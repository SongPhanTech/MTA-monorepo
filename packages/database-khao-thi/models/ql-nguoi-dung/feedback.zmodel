import '../base'
import '../ql-danh-muc/core-categories'


model Feedback extends Base {
  content      String
  status       FeedbackStatus
  satisfaction Satisfaction
  user         DM_NhanVien    @relation(fields: [userId], references: [Id])
  userId       String         @db.Uuid

  @@allow('create', auth() != null)
  // @@allow('update', auth().role == 'ADMIN' || auth() == user && status == Pending)
  // @@allow('delete', auth().role == 'ADMIN' || auth() == user)
  @@schema("ql-nguoi-dung")
}

enum FeedbackStatus {
  Pending
  InProgress
  Resolved
  Closed
  @@schema("ql-nguoi-dung")
}

enum Satisfaction {
  VeryDissatisfied
  Dissatisfied
  Neutral
  Satisfied
  VerySatisfied
  @@schema("ql-nguoi-dung")
}