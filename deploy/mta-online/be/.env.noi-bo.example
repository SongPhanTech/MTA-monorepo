################################################################################
# MTA Backend — .env dùng chung cho mạng NỘI BỘ
# Copy lên server:  cp .env.noi-bo.example ~/mta-app/be/.env
# (hoặc ~/mta-be/.env + .mta.env nếu profile gộp 2 file — có thể dán hết vào 1 file)
#
# Trước khi chạy: thay toàn bộ giá trị <<<THAY>>> và host nội bộ.
# Tạo HMAC:  openssl rand -hex 32
################################################################################

# ── Host nội bộ (đổi 1 chỗ, dùng lại bên dưới nếu shell expand; Docker Compose
#    thường KHÔNG expand chéo — hãy sửa từng dòng cho đúng IP/hostname) ────────
# Ví dụ: 192.168.1.10 | 27.71.231.243 | postgres.internal

# =============================================================================
# Database
# =============================================================================
DATABASE_URL="postgresql://admin:<<<THAY_PASSWORD>>>@<<<HOST_DB>>>:5432/mta_in"
# APIM_LOGS_DATABASE_URL="postgresql://admin:<<<THAY_PASSWORD>>>@<<<HOST_DB>>>:5432/apim_logs"
# WSO2AM_DB="mysql://root:<<<THAY_PASSWORD>>>@<<<HOST_DB>>>:3306/WSO2AM_DB"

DATABASE_POOL_SIZE=50
DATABASE_POOL_TIMEOUT=15
DATABASE_CONNECT_TIMEOUT=10

# Infra Postgres (nếu compose tạo DB local)
POSTGRES_USER=admin
POSTGRES_PASSWORD=<<<THAY_PASSWORD>>>
POSTGRES_DB=mta_in
POSTGRES_PORT=5432
POSTGRES_MAX_CONNECTIONS=300
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_WORK_MEM=8MB

# =============================================================================
# Redis (bắt buộc — export payload + import payload + cache ĐK học)
# =============================================================================
REDIS_URL=redis://<<<HOST_REDIS>>>:6379
REDIS_CONNECTION_TIMEOUT=8000
REDIS_MAX_RETRIES=20
# REDIS_OFFLINE_QUEUE=true

REDIS_CACHE_ENABLED=true
REDIS_TTL_SESSION=60
REDIS_TTL_STUDENT=60
REDIS_TTL_CLASSES_INFO=180
REDIS_TTL_SEATS=600

REDIS_RATE_LIMIT_ENABLED=true
REDIS_RL_REGISTER_MAX=20
REDIS_RL_REGISTER_WINDOW=60
REDIS_RL_UNREGISTER_MAX=20
REDIS_RL_UNREGISTER_WINDOW=60
REDIS_RL_READ_MAX=120
REDIS_RL_READ_WINDOW=60

# Gợi ý cấu hình Redis server (không phải biến app):
#   maxmemory 2gb
#   maxmemory-policy allkeys-lru

# =============================================================================
# Kafka (bắt buộc — queue xuất QLĐT + import Portal + đăng ký học)
# =============================================================================
KAFKA_BROKERS=<<<HOST_KAFKA>>>:29092
KAFKA_CLIENT_ID=be-portal
KAFKA_CONNECTION_TIMEOUT=5000
KAFKA_REQUEST_TIMEOUT=10000

# =============================================================================
# Đồng bộ Nội bộ ↔ Internet (xuất / nhập JSON) — DÙNG CHUNG 2 BE
# =============================================================================
# Bắt buộc giống nhau trên be-ql-dao-tao và be-portal
# AES-256-GCM đóng gói .dat (64 hex = dùng trực tiếp làm key 32 byte)
DATA_SYNC_HMAC_SECRET=1b8cb9ff3078fd1fc7a2c87ae48fac569ff194943e65b5e14116c463030fa32d
DATA_SYNC_ENCRYPTION_KEY=1b8cb9ff3078fd1fc7a2c87ae48fac569ff194943e65b5e14116c463030fa32d

# Portal — import async
DATA_SYNC_ASYNC=true
DATA_SYNC_WORKER_ENABLED=true
DATA_SYNC_WORKER_CONCURRENCY=1
DATA_SYNC_MAX_ATTEMPTS=3
DATA_SYNC_IMPORT_TTL_SEC=7200
DATA_SYNC_IMPORT_TOPIC=data_sync_import_queue
DATA_SYNC_IMPORT_DLQ_TOPIC=data_sync_import_queue_dlq
DATA_SYNC_CONSUMER_GROUP=be-portal-data-sync-worker
# DATA_SYNC_STALE_PENDING_MS=300000
# (không còn dùng disk) DATA_SYNC_IMPORT_DIR=

# QL Đào tạo — export async
EXPORT_ASYNC_KAFKA=true
EXPORT_TRAINING_DATA_TOPIC=export_training_data_queue
EXPORT_TRAINING_DATA_CONSUMER_GROUP=be-ql-dao-tao-export-worker
EXPORT_MAX_CONCURRENT=3
EXPORT_PAYLOAD_MAX_MB=256

# =============================================================================
# Đăng ký học (be-portal)
# =============================================================================
CLASS_REGISTER_ASYNC=true
CLASS_REGISTER_WORKER_ENABLED=true
CLASS_REGISTER_WORKER_CONCURRENCY=5
CLASS_REGISTER_MAX_ATTEMPTS=3
CLASS_REGISTER_EVENTS_WORKER_ENABLED=true
CLASS_REGISTER_LOCK_STRATEGY=pessimistic
CLASS_REGISTER_LOCK_TIMEOUT_MS=4000

# =============================================================================
# MinIO / Object storage
# =============================================================================
MINIO_ENDPOINT=http://<<<HOST_MINIO>>>:9000
MINIO_ACCESS_KEY=<<<THAY_MINIO_USER>>>
MINIO_SECRET_KEY=<<<THAY_MINIO_PASSWORD>>>
MINIO_USE_SSL=false
MINIO_BUCKET=mta
MINIO_ROOT_USER=<<<THAY_MINIO_USER>>>
MINIO_ROOT_PASSWORD=<<<THAY_MINIO_PASSWORD>>>
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001

# =============================================================================
# Auth / SSO / Keycloak (điền theo môi trường nội bộ)
# =============================================================================
PORTAL_APP_CODE=congsinhvien
AUTH_ISSUER=http://<<<HOST_SSO_ID>>>:5262
SYSTEM_BASE_URL=http://<<<HOST_SHARE_API>>>:5082
MTA_API_URL=http://<<<HOST_SHARE_API>>>:5082/api/system/public

OIDC_AUTH_SECRET=<<<THAY_OIDC_AUTH_SECRET>>>
OIDC_AUTH_REFRESH_INTERVAL=900
OIDC_AUTH_EXPIRES=3600
OIDC_REDIRECT_URI=/callback
OIDC_SCOPES=openid address email phone profile roles
# OIDC_BASE_URL=https://auth.internal
# OIDC_ISSUER=https://auth.internal/oauth2/token
# OIDC_CLIENT_ID=<<<THAY>>>
# OIDC_CLIENT_SECRET=<<<THAY>>>

KEYCLOAK_URL=https://<<<HOST_SSO>>>
KEYCLOAK_REALM=swantech
KEYCLOAK_CLIENT_ID=fe-lms
KEYCLOAK_CLIENT_SECRET=<<<THAY_KC_SECRET>>>

KEYCLOAK_CLIENT_ID_LMS=fe-lms
KEYCLOAK_CLIENT_SECRET_LMS=<<<THAY_KC_SECRET_LMS>>>
KEYCLOAK_CLIENT_ID_CONG_GIANG_VIEN=fe-cong-giang-vien
KEYCLOAK_CLIENT_SECRET_CONG_GIANG_VIEN=<<<THAY>>>
KEYCLOAK_CLIENT_ID_EMS=fe-ems
KEYCLOAK_CLIENT_SECRET_EMS=<<<THAY>>>
KEYCLOAK_CLIENT_ID_HRM=fe-hrm
KEYCLOAK_CLIENT_SECRET_HRM=<<<THAY>>>
KEYCLOAK_CLIENT_ID_PORTAL=dang-ky-hoc
KEYCLOAK_CLIENT_SECRET_PORTAL=<<<THAY>>>

LMS_CLIENT_ID=fe-lms
LMS_SECRET_KEY=<<<THAY_KC_SECRET_LMS>>>

# =============================================================================
# OnlyOffice / khác
# =============================================================================
# ONLY_OFFICE_ENDPOINT=http://<<<HOST_ONLYOFFICE>>>:3100
# ONLYOFFICE_JWT_SECRET=<<<THAY>>>
# ONLYOFFICE_JWT_HEADER=AuthorizationJwt

SYSTEM_MAINTENANCE=false
SYSTEM_MAINTENANCE_MESSAGE="Hệ thống bảo trì"

# Cron (be-ql-dao-tao) — tắt nếu nội bộ chưa cần
# CRON_QUET_HAN_GV_ENABLED=false

# =============================================================================
# Checklist sau khi điền
# =============================================================================
# [ ] DATABASE_URL trỏ DB nội bộ (mta_in)
# [ ] REDIS_URL + KAFKA_BROKERS reachable từ mọi container BE
# [ ] DATA_SYNC_HMAC_SECRET đã set (openssl rand -hex 32) — cùng 1 giá trị
# [ ] docker compose up -d --force-recreate mta-be-ql-dao-tao mta-be-portal
# [ ] Không cần DATA_SYNC_IMPORT_DIR (payload Redis)
