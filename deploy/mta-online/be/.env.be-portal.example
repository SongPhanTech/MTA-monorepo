# Copy sang server: ~/mta-app/be/.env.be-portal

PORT=3000
DATABASE_URL=postgres://root:123456654321@postgres:5432/mta

# Prisma pool — mỗi instance portal. Scale 2 instance → 2 × giá trị này connection.
# Giữ tổng (portal×N + model + ql-dao-tao + shared) < POSTGRES_MAX_CONNECTIONS.
DATABASE_POOL_SIZE=40

# Redis cache (đợt ĐK / credit / info SV / get-classes-info short TTL)
REDIS_URL=redis://redis:6379
REDIS_CACHE_ENABLED=true
REDIS_TTL_SESSION=60
REDIS_TTL_STUDENT=60
REDIS_TTL_CLASSES_INFO=5

# Rate-limit (per userId, fixed window). Tắt khi load test 1 token spam:
# REDIS_RATE_LIMIT_ENABLED=false
REDIS_RATE_LIMIT_ENABLED=true
REDIS_RL_REGISTER_MAX=20
REDIS_RL_REGISTER_WINDOW=60
REDIS_RL_UNREGISTER_MAX=20
REDIS_RL_UNREGISTER_WINDOW=60
REDIS_RL_READ_MAX=120
REDIS_RL_READ_WINDOW=60

OIDC_AUTH_SECRET=change-me-long-random-secret
OIDC_AUTH_REFRESH_INTERVAL=600
OIDC_AUTH_EXPIRES=3600
OIDC_REDIRECT_URI=/callback
OIDC_SCOPES=openid address email phone profile roles

OIDC_BASE_URL=https://auth.swantech.vn
OIDC_ISSUER=https://auth.swantech.vn/oauth2/token
OIDC_CLIENT_ID=EXaQWfbjE5Pl3VbB6eAOkecfV_Ua
OIDC_CLIENT_SECRET=change-me
OIDC_ADMIN_USERNAME=admin
OIDC_ADMIN_PASSWORD=Admin@123

# Dev không SSO — bỏ comment khi thử đăng ký học / load test
# MOCK_USER_PROFILE_ID=
# MOCK_USER_FULL_NAME=
# MOCK_USER_NAME=
