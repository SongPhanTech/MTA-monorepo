# Copy sang server: ~/mta-app/be/.env  (infra: Postgres + MinIO)

POSTGRES_USER=root
POSTGRES_PASSWORD=123456654321
POSTGRES_DB=mta
POSTGRES_PORT=5432

# Chịu tải đợt ĐK (~500 SV). Tổng pool mọi BE ≤ max_connections - 20 (dành superuser/admin).
POSTGRES_MAX_CONNECTIONS=300
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_WORK_MEM=8MB

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=123456654321
MINIO_BUCKET=mta
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
BUN_CONFIG_VERBOSE_FETCH=curl
MINIO_ENDPOINT="http://127.0.0.1:9000"
MINIO_ACCESS_KEY="${MINIO_ROOT_USER}"
MINIO_SECRET_KEY="${MINIO_ROOT_PASSWORD}"
MINIO_USE_SSL=false

# Portal pool (có thể override trong .env.be-portal)
DATABASE_POOL_SIZE=40
# PORTAL_CPU_LIMIT=2
# PORTAL_MEM_LIMIT=2g

# Redis cache đăng ký học
REDIS_URL=redis://redis:6379
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb
REDIS_CACHE_ENABLED=true
REDIS_TTL_SESSION=60
REDIS_TTL_STUDENT=60
REDIS_TTL_CLASSES_INFO=5

# Rate-limit đăng ký học (per user). Load test 1 token: REDIS_RATE_LIMIT_ENABLED=false
REDIS_RATE_LIMIT_ENABLED=true
REDIS_RL_REGISTER_MAX=20
REDIS_RL_REGISTER_WINDOW=60
REDIS_RL_UNREGISTER_MAX=20
REDIS_RL_UNREGISTER_WINDOW=60
REDIS_RL_READ_MAX=120
REDIS_RL_READ_WINDOW=60
