# Copy sang server: ~/mta-app/be/.env.be-model
# DATABASE_URL / MinIO trong compose đã override host nội bộ (postgres, minio).
# File này giữ OIDC / Keycloak / secret khác.

PORT=3000

# Dùng hostname Docker, không dùng IP public
# (compose cũng set lại; giữ đồng bộ với .env infra)
DATABASE_URL=postgres://root:123456654321@postgres:5432/mta
DATABASE_POOL_SIZE=30
DATABASE_POOL_TIMEOUT=15
DATABASE_CONNECT_TIMEOUT=10
CHECK_IP_CACHE_TTL_MS=60000
CHECK_IP_CACHE_MAX=5000

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=123456654321
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=123456654321
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=mta
MINIO_USE_SSL=false

ONLY_OFFICE_ENDPOINT=https://doc.mta.swantech.vn
ONLYOFFICE_JWT_SECRET=swantechKeyOnlyOffice38912wnsaiwe
ONLYOFFICE_JWT_HEADER=AuthorizationJwt

# Auth — chỉnh theo môi trường online thật
OIDC_BASE_URL=https://auth.swantech.vn
OIDC_ADMIN_USERNAME=system
OIDC_ADMIN_PASSWORD=System@123

AUTH_ISSUER=https://daotao.swantech.vn/api/sso-id
KEYCLOAK_URL=https://daotao.swantech.vn/api/sso-id
KEYCLOAK_CLIENT_ID=fe-lms-pod
KEYCLOAK_REALM=swantech

# Public-api client — be-model proxy /api/system/{appCode}/*
KEYCLOAK_CLIENT_ID_LMS=fe-lms
KEYCLOAK_CLIENT_SECRET_LMS=
KEYCLOAK_CLIENT_ID_PORTAL=CongHocVien
KEYCLOAK_CLIENT_SECRET_PORTAL=
KEYCLOAK_CLIENT_ID_CONG_SINH_VIEN=CongHocVien
KEYCLOAK_CLIENT_SECRET_CONG_SINH_VIEN=
KEYCLOAK_CLIENT_ID_CONG_HOC_VIEN=CongHocVien
KEYCLOAK_CLIENT_SECRET_CONG_HOC_VIEN=

# FE không gọi system trực tiếp — chỉ BE cần biến này (vd. http://daihocso.mta.edu.vn)
SYSTEM_BASE_URL=http://daihocso.mta.edu.vn

# Chỉ khi chưa có SSO — bỏ comment để mock user (dev/thử)
# MOCK_USER_PROFILE_ID=
# MOCK_USER_FULL_NAME=
# MOCK_USER_NAME=

# Bật màn hình bảo trì trên mọi app (true / 1 / yes)
SYSTEM_MAINTENANCE=false
# SYSTEM_MAINTENANCE_MESSAGE="Hệ thống đang bảo trì đến 22:00."
