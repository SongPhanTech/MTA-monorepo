{
    "$schema": "https://v2-9-4.turborepo.dev/schema.json",
    "concurrency": "10",
    "ui": "tui",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                ".env*"
            ],
            "outputs": [
                ".next/**",
                "!.next/cache/**",
                "dist/**"
            ]
        },
        "lint": {
            "dependsOn": [
                "^lint"
            ]
        },
        "check-types": {
            "dependsOn": [
                "^check-types"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "generate": {
            "cache": false
        },
        "generate:sql": {
            "cache": false
        },
        "generate:router": {
            "cache": false
        },
        "generate:api": {
            "cache": false
        },
        "db:push": {
            "cache": false
        },
        "db:sync": {
            "cache": false
        }
    }
}