{
  "name": "mta-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "build:backend": "turbo run build --filter=backend",
    "dev": "turbo dev",
    "lint": "biome lint --fix",
    "generate": "turbo run generate",
    "generate:sql": "turbo run generate:sql",
    "generate:router": "turbo run generate:router",
    "generate:api": "turbo run generate:api && pnpm format",
    "db:push": "turbo run db:push",
    "db:sync": "turbo run db:sync",
    "format": "biome format --write --verbose",
    "check": "biome check --write --unsafe --files-ignore-unknown=true --no-errors-on-unmatched --colors=off",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "pnpm check"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@hono/zod-openapi": "catalog:",
    "esbuild": "catalog:"
  },
  "packageManager": "pnpm@10.20.0+sha512.cf9998222162dd85864d0a8102e7892e7ba4ceadebbf5a31f9c2fce48dfce317a9c53b9f6464d1ef9042cba2e02ae02a9f7c143a2b438cd93c91840f0192b9dd"
}