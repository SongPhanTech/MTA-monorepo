{
  "name": "mta-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "build:backend": "turbo run build --filter=backend",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "db:generate": "turbo run db:generate",
    "router:generate": "node ./scripts/gen-router-path.js",
    "format": "biome format --write --verbose"
  },
  "devDependencies": {
    "glob": "^11.0.0",
    "turbo": "^2.3.3",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
