{
  "name": "mta-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "build:backend": "turbo run build --filter=backend",
    "dev": "turbo dev",
    "lint": "biome lint --fix",
    "generate": "turbo run generate",
    "generate:sql": "turbo run generate:sql",
    "generate:router": "turbo run generate:router",
    "format": "biome format --write --verbose",
    "check": "biome check --write --unsafe --files-ignore-unknown=true --no-errors-on-unmatched --colors=off",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "pnpm check"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@hono/zod-openapi": "catalog:",
    "esbuild": "catalog:"
  },
  "packageManager": "pnpm@10.12.4+sha512.5ea8b0deed94ed68691c9bad4c955492705c5eeb8a87ef86bc62c74a26b037b08ff9570f108b2e4dbd1dd1a9186fea925e527f141c648e85af45631074680184"
}
